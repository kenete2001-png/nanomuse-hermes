+package io.github.kenete.nanohermes.hermes
+
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.NonCancellable
+import kotlinx.coroutines.channels.Channel
+import kotlinx.coroutines.coroutineScope
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.withContext
+import kotlinx.coroutines.withTimeoutOrNull
+
+/** Une tâche à confier à Hermes (le message de la personne est DÉJÀ dans Room, écrit par le ChatViewModel). */
+data class HermesDemande(
+    /** Id de la discussion Muse ; la session Hermes est `nanomuse-<id>`. */
+    val sessionMuse: String,
+    val texte: String,
+    /** Choix de Muse pour CETTE tâche (DuetModeleFort / routeur, module clés). Null = défaut de la config Hermes. */
+    val modele: String? = null,
+    val fournisseur: String? = null,
+    /** Consignes ajoutées au système (format des citations [n], etc.). Null = aucune. */
+    val instructions: String? = null,
+    /** Historique Muse (rôle, texte) envoyé seulement si la session Hermes n'existe pas encore (discussion commencée en natif). */
+    val historique: () -> List<Pair<String, String>> = { emptyList() },
+    /** Clé d'idempotence (un renvoi après coupure ne relance pas le run). */
+    val cleIdempotence: String? = null,
+)
+
+/** Issue d'une tentative. */
+sealed class HermesResultat {
+    /** Hermes a traité la tâche (réussie, échouée ou annulée) : les lignes sont dans Room. */
+    data class Traite(
+        val statut: String,
+        /** Ids Room des lignes écrites pour ce run, dans l'ordre (la dernière ligne "assistant" = la réponse). */
+        val lignes: List<String>,
+        val usage: HermesUsage?,
+        val modele: String?,
+        val fournisseur: String?,
+        val erreur: String?,
+        val runId: String = "",
+        val sessionHermes: String = "",
+        /** Texte final de Hermes (sortie de `run.completed`, sinon texte diffusé). */
+        val texte: String = "",
+    ) : HermesResultat()
+    /** Hermes n'a RIEN fait : le moteur natif doit prendre la tâche. */
+    data class Repli(val raison: HermesRaisonRepli, val detail: String) : HermesResultat()
+}
+
+/** Ce que l'écran peut suivre pendant la tâche (tout est optionnel). */
+interface HermesEcouteur {
+    /** Des lignes ont changé dans Room (l'écran recharge la discussion). Appelé au plus toutes les [MoteurHermes.intervalleMajMs]. */
+    suspend fun lignesModifiees() {}
+    /** Une étape, telle quelle (cartes d'étapes, journal). */
+    fun etape(ev: HermesEvenement) {}
+    /** Hermes démarre (première tâche : quelques secondes, montrer « Moteur en route… »). */
+    fun demarrage() {}
+    /** Chaque événement SSE en JSON brut, sur le fil de lecture (doit être rapide et sûr entre fils). */
+    fun brut(o: org.json.JSONObject) {}
+}
+
+/**
+ * Réponse à un accord demandé par Hermes (événement `approval.request`), avec les choix de Hermes lui-même :
+ * "once", "session", "always" ou "deny" (la fenêtre de l'app les montre tels quels). null = pas de réponse : Hermes applique
+ * son propre comportement (attente jusqu'à son délai `approvals.timeout`, puis refus).
+ */
+fun interface HermesAccord { suspend fun decider(demande: HermesEvenement.AccordDemande, sessionMuse: String): String? }
+
+/**
+ * nanoMuse Hermes : le moteur Hermes. Enchaîne superviseur → `POST /v1/runs` → flux SSE (avec reprise `last_seq`)
+ * → écriture Room par [HermesTranscripteur] → historique complet → fin.
+ *
+ * Règle de repli : on ne rend la main au natif ([HermesResultat.Repli]) QUE si Hermes n'a encore rien fait
+ * (pas de run accepté, ou run accepté mais aucun outil commencé ni texte écrit). Après un outil, une erreur est
+ * affichée dans la discussion et le natif ne refait pas la tâche (il pourrait refaire une action : envoi, fichier…).
+ */
+class MoteurHermes(
+    private val superviseur: HermesSuperviseur,
+    private val client: HermesClient,
+    private val accord: HermesAccord = HermesAccord { _, _ -> null },
+    val intervalleMajMs: Long = 300,
+    val reprisesFluxMax: Int = 3,
+    val delaiAccordMs: Long = 600_000, // au-delà, plus de réponse : c'est le délai de Hermes qui décide
+    private val pause: suspend (Long) -> Unit = { delay(it) },
+    private val horloge: HermesHorloge = HermesHorloge { System.currentTimeMillis() },
+) {
+    companion object {
+        fun sessionHermes(sessionMuse: String) = "nanomuse-$sessionMuse"
+        /** Les choix d'accord de Hermes (POST /v1/runs/{id}/approval). */
+        val CHOIX_ACCORD = setOf("once", "session", "always", "deny")
+    }
+
+    suspend fun executer(d: HermesDemande, depot: HermesDepotMessages, ecouteur: HermesEcouteur = object : HermesEcouteur {}): HermesResultat {
+        if (superviseur.etat.value != HermesSuperviseur.Etat.PRET) ecouteur.demarrage()
+        if (!superviseur.assurerPret()) {
+            val pause = superviseur.enPauseApresEchec()
+            return HermesResultat.Repli(
+                if (pause) HermesRaisonRepli.DEMARRAGE_ECHOUE else HermesRaisonRepli.INDISPONIBLE,
+                superviseur.derniereRaison ?: "Hermes indisponible")
+        }
+        superviseur.debutTache()
+        try {
+            return executerPret(d, depot, ecouteur)
+        } finally {
+            superviseur.finTache()
+        }
+    }
+
+    private suspend fun executerPret(d: HermesDemande, depot: HermesDepotMessages, ecouteur: HermesEcouteur): HermesResultat {
+        val sid = sessionHermes(d.sessionMuse)
+        val historique = try {
+            if (client.sessionExiste(sid)) emptyList() else d.historique()
+        } catch (e: CancellationException) { throw e } catch (e: Exception) {
+            return HermesResultat.Repli(HermesRepli.raisonErreur(e), e.message ?: "erreur")
+        }
+        val run = try {
+            client.demarrerRun(d.texte, sid, d.modele, d.fournisseur, d.instructions, historique, d.cleIdempotence)
+        } catch (e: CancellationException) { throw e } catch (e: Exception) {
+            return HermesResultat.Repli(HermesRepli.raisonErreur(e), e.message ?: "erreur")
+        }
+        val tr = HermesTranscripteur(depot, run.runId.removePrefix("run_").take(8), d.modele)
+        var fin: HermesEvenement.Fin? = null
+        var dernierSeq = -1
+        var reprises = 0
+        var derniereEcriture = 0L
+        var aEcrit = false
+
+        suspend fun ecrireSiBesoin(force: Boolean) {
+            val t = horloge.ms()
+            if (force || t - derniereEcriture >= intervalleMajMs) {
+                tr.ecrire()
+                derniereEcriture = t
+                aEcrit = aEcrit || tr.lignesEcrites.isNotEmpty()
+                ecouteur.lignesModifiees()
+            }
+        }
+
+        try {
+            while (fin == null) {
+                val evts = Channel<HermesEvenement>(Channel.UNLIMITED)
+                var erreurFlux: Throwable? = null
+                coroutineScope {
+                    val lecteur = launch {
+                        try {
+                            dernierSeq = client.lireEvenements(run.runId, dernierSeq, { ecouteur.brut(it) }) { evts.trySend(it) }
+                        } catch (e: CancellationException) { throw e } catch (e: Throwable) {
+                            erreurFlux = e
+                        } finally { evts.close() }
+                    }
+                    var aEcrire = false
+                    for (ev in evts) {
+                        superviseur.activite()
+                        if (ev.seq >= 0) dernierSeq = maxOf(dernierSeq, ev.seq)
+                        ecouteur.etape(ev)
+                        when (ev) {
+                            is HermesEvenement.Fin -> { fin = ev }
+                            is HermesEvenement.AccordDemande -> {
+                                if (aEcrire || tr.actionCommencee) { ecrireSiBesoin(true); aEcrire = false }
+                                val choix = runCatching { withTimeoutOrNull(delaiAccordMs) { accord.decider(ev, d.sessionMuse) } }
+                                    .getOrNull()?.takeIf { it in CHOIX_ACCORD }
+                                if (choix != null) runCatching { client.repondreAccord(run.runId, choix, ev.requestId, ev.generation) }
+                            }
+                            is HermesEvenement.Question -> { tr.ajouterTexte(ev.texte); aEcrire = true }
+                            else -> if (tr.appliquer(ev)) {
+                                aEcrire = true
+                                // les étapes d'outils s'écrivent tout de suite ; le texte est groupé
+                                val immediat = ev !is HermesEvenement.Delta
+                                if (immediat || horloge.ms() - derniereEcriture >= intervalleMajMs) { ecrireSiBesoin(true); aEcrire = false }
+                            }
+                        }
+                    }
+                    lecteur.join()
+                    if (aEcrire) ecrireSiBesoin(true)
+                }
+                if (fin != null) break
+                // flux fermé sans événement de fin : coupure. On regarde le statut, puis on reprend avec last_seq.
+                val st = runCatching { client.statut(run.runId) }.getOrNull()
+                val s = st?.optString("status")
+                if (s != null && s in HermesProtocole.STATUTS_FINAUX) { fin = HermesProtocole.fin(dernierSeq, s, st); break }
+                if (++reprises > reprisesFluxMax) {
+                    val e = erreurFlux
+                    if (!tr.actionCommencee && !aEcrit && st == null) {
+                        runCatching { client.arreter(run.runId) }
+                        return HermesResultat.Repli(e?.let { HermesRepli.raisonErreur(it) } ?: HermesRaisonRepli.INDISPONIBLE,
+                            e?.message ?: "flux Hermes coupé")
+                    }
+                    fin = HermesEvenement.Fin(dernierSeq, "failed", null, HermesTextes.fluxCoupe.format(e?.message ?: "-"), null, null, null, null)
+                    break
+                }
+                pause(minOf(1000L * reprises, 3000L))
+            }
+        } catch (e: CancellationException) {
+            // la personne a arrêté : on arrête Hermes aussi, et on garde ce qui est écrit
+            withContext(NonCancellable) {
+                runCatching { client.arreter(run.runId) }
+                runCatching { tr.ecrire(); ecouteur.lignesModifiees() }
+            }
+            throw e
+        }
+
+        val f = fin!!
+        tr.terminer(f)
+        // résultats d'outils entiers (les aperçus du flux sont tronqués)
+        if (tr.outils().isNotEmpty()) runCatching { tr.completer(client.messagesSession(sid)) }
+        tr.ecrire(HermesTranscripteur.tokenJson(f.usage))
+        if (!f.reussi && f.statut != "cancelled") {
+            val msg = f.erreur ?: f.raisonFin?.let { HermesTextes.arrete.format(it) } ?: HermesTextes.echec
+            // rien fait du tout : le natif peut reprendre sans risque
+            if (!tr.actionCommencee && tr.lignesEcrites.isEmpty()) return HermesResultat.Repli(HermesRaisonRepli.ERREUR, msg)
+            tr.erreur(msg)
+        }
+        ecouteur.lignesModifiees()
+        return HermesResultat.Traite(f.statut, tr.lignesEcrites.toList(), f.usage, f.modele, f.fournisseur, f.erreur, run.runId, sid, tr.texteFinal)
+    }
+}
