+package io.github.kenete.nanohermes.hermes
+
+/**
+ * nanoMuse Hermes : les phrases que le moteur (Kotlin pur) peut montrer dans la discussion. Valeurs françaises par défaut
+ * (tests JVM) ; l'app les remplace au démarrage par celles de strings.xml (langue choisie dans nanoMuse).
+ */
+object HermesTextes {
+    @Volatile var demarrage: String = "Démarrage de Hermes…"
+    @Volatile var outilNonExecute: String = "Outil non exécuté (refusé ou interrompu)."
+    /** %1$s = raison donnée par Hermes. */
+    @Volatile var arrete: String = "Hermes s'est arrêté : %1\$s"
+    @Volatile var echec: String = "Hermes : échec de la tâche"
+    /** %1$s = détail. */
+    @Volatile var fluxCoupe: String = "Flux Hermes coupé (%1\$s)"
+}
diff --git a/android/src/android/app/src/main/java/io/github/kenete/nanohermes/hermes/HermesTranscripteur.kt b/android/src/android/app/src/main/java/io/github/kenete/nanohermes/hermes/HermesTranscripteur.kt
