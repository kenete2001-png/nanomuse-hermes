+package io.github.kenete.nanohermes.hermes
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/** nanoMuse Hermes : clé API de l'utilisateur → environnement de Hermes seulement ; config.yaml sans clé et jamais imposé. */
+class HermesFournisseurTest {
+    private val cle = "sk-or-v1-0123456789abcdef0123456789abcdef"
+
+    @Test fun cle_dans_l_environnement_sous_le_nom_de_hermes() {
+        assertEquals(mapOf("OPENROUTER_API_KEY" to cle), HermesFournisseur.environnement(HermesFournisseur.Reglage("openrouter", "openai/gpt-4o-mini"), "  $cle "))
+        assertEquals(mapOf("ANTHROPIC_API_KEY" to cle), HermesFournisseur.environnement(HermesFournisseur.Reglage("anthropic", "claude-sonnet-4"), cle))
+        assertEquals(mapOf(HermesFournisseur.VAR_CUSTOM to cle),
+            HermesFournisseur.environnement(HermesFournisseur.Reglage("custom", "m", "https://api.exemple.org/v1"), cle))
+        assertTrue("noms retirés par Hermes des commandes qu'il lance", HermesFournisseur.LISTE.all { it.variable.endsWith("_API_KEY") })
+        assertTrue(HermesFournisseur.VAR_CUSTOM.startsWith("AUXILIARY_"))
+        assertEquals(emptyMap<String, String>(), HermesFournisseur.environnement(null, cle))
+        assertEquals(emptyMap<String, String>(), HermesFournisseur.environnement(HermesFournisseur.Reglage("openrouter", "m"), null))
+        assertEquals(emptyMap<String, String>(), HermesFournisseur.environnement(HermesFournisseur.Reglage("openrouter", "m"), "court"))
+        assertEquals(emptyMap<String, String>(), HermesFournisseur.environnement(HermesFournisseur.Reglage("openrouter", "m"), "avec espace dedans"))
+        assertEquals(emptyMap<String, String>(), HermesFournisseur.environnement(HermesFournisseur.Reglage("inconnu", "m"), cle))
+    }
+
+    @Test fun validation_du_reglage() {
+        assertTrue(HermesFournisseur.valide(HermesFournisseur.Reglage("openrouter", "openai/gpt-4o-mini")))
+        assertFalse(HermesFournisseur.valide(HermesFournisseur.Reglage("openrouter", "mauvais modèle")))
+        assertFalse(HermesFournisseur.valide(HermesFournisseur.Reglage("openrouter", "")))
+        assertFalse(HermesFournisseur.valide(HermesFournisseur.Reglage("custom", "m", null)))
+        assertFalse(HermesFournisseur.valide(HermesFournisseur.Reglage("custom", "m", "http://exemple.org/v1")))
+        assertTrue(HermesFournisseur.valide(HermesFournisseur.Reglage("custom", "m", "http://127.0.0.1:11434/v1")))
+    }
+
+    @Test fun config_yaml_sans_cle_et_respect_d_une_config_manuelle() {
+        val y = HermesFournisseur.configYaml(HermesFournisseur.Reglage("custom", "llama-3.3-70b", "https://api.exemple.org/v1/"))
+        assertTrue(y.startsWith(HermesFournisseur.MARQUE))
+        assertTrue(y, y.contains("provider: \"custom\"")); assertTrue(y.contains("default: \"llama-3.3-70b\""))
+        assertTrue(y.contains("base_url: \"https://api.exemple.org/v1\"")); assertTrue(y.contains("key_env: \"${HermesFournisseur.VAR_CUSTOM}\""))
+        assertFalse("aucun réglage d'accord ou de greffon imposé", y.contains("approvals") || y.contains("plugins") || y.contains("muse_gate"))
+        assertFalse(y.contains("api_key"))
+        assertTrue(HermesFournisseur.peutEcrireConfig(null)); assertTrue(HermesFournisseur.peutEcrireConfig(y))
+        assertFalse("config écrite à la main : gardée", HermesFournisseur.peutEcrireConfig("model:\n  provider: openrouter\n"))
+    }
+
+    @Test fun modele_passe_a_chaque_tache() {
+        assertEquals("openai/gpt-4o-mini" to "openrouter", HermesFournisseur.pourRun(HermesFournisseur.Reglage("openrouter", " openai/gpt-4o-mini ")))
+        val c = HermesFournisseur.pourRun(HermesFournisseur.Reglage("custom", "m", "https://a.b/v1"))
+        assertEquals("m", c.first); assertNull(c.second)
+        assertEquals(null to null, HermesFournisseur.pourRun(null))
+    }
+}
