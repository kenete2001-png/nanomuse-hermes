+
+/** nanoMuse Hermes : pack Ubuntu (empreinte figée, copie vérifiée, extraction .nouveau, renommage, retour arrière). */
+class HermesPackInstallationTest {
+    private lateinit var d: File
+    private val ext = { i: java.io.InputStream, c: File -> TarTest.extraire(i, c) }
+    @Before fun avant() { d = kotlin.io.path.createTempDirectory("nh").toFile() }
+    @After fun apres() { d.deleteRecursively() }
+
+    private fun packJson(): String {
+        var f = File("src/main/assets/nanohermes/hermes/pack.json")
+        if (!f.isFile) f = File("app/src/main/assets/nanohermes/hermes/pack.json")
+        return f.readText()
+    }
+
+    @Test fun `pack attendu fige dans l'app = Hermes 0_23_0 Ubuntu`() {
+        val a = HermesPackInstallation.lireAttendu(packJson())
+        assertEquals("7ebcf0712e00733f3e5d4221456b9a4e90272529ac8fe1dea3220d6ff59d0c13", a.sha256)
+        assertEquals(174_061_296L, a.taille); assertEquals("0.23.0-2bd378e-muse3", a.version); assertEquals(516_245_716L, a.tailleInstallee)
+        assertEquals("hermes-pack-0.23.0-2bd378e-muse3-aarch64-ubuntu.tar.gz", a.fichier)
+        assertEquals("adresse par défaut : publication GitHub du pack", "https://github.com/kenete2001-png/nanomuse-hermes/releases/download/hermes-pack-0.23.0/" + a.fichier, a.url)
+        assertTrue(HermesPackInstallation.urlValide(a.url))
+        assertEquals("ubuntu-rootfs", JSONObject(packJson()).getString("rootfs"))
+        assertTrue(HermesPackInstallation.urlValide("https://github.com/x/y/releases/download/v1/p.tar.gz"))
+        assertFalse(HermesPackInstallation.urlValide("http://exemple.org/p.tar.gz")); assertFalse(HermesPackInstallation.urlValide(null))
+    }
+
+    @Test fun `copie verifiee, refus si taille ou empreinte differente`() {
+        val b = targz(COMPLET); val a = attendu(b)
