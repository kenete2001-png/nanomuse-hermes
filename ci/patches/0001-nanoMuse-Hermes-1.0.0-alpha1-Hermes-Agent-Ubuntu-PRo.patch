index 00000000..a3a71990
--- /dev/null
+++ b/android/src/android/app/src/main/java/io/github/kenete/nanohermes/hermes/HermesModele.kt
@@ -0,0 +1,259 @@
+package io.github.kenete.nanohermes.hermes
+
+import org.json.JSONArray
+import org.json.JSONObject
+
+/**
+ * duetmuse fusion E3 « Moteur Hermes » : modèle de données de l'API HTTP locale de Hermes Agent.
+ *
+ * Contrat lu dans le code de NousResearch/hermes-agent, commit a4994d4ead8f9c915b485cec5689909b349a49df
+ * (31/10/2026) : `gateway/platforms/api_server.py` (routes, `_openai_error`, `_sse_frame`,
+ * `_approval_request_event`) et `gateway/platforms/api_server_runs.py` (`_handle_runs`, `_run_event`,
+ * `_FIXED_EVENT_FIELDS`, `terminal_run_status`, `_handle_run_events`, `_handle_run_approval`, `_handle_stop_run`).
+ *
+ * Ce fichier est en Kotlin pur (org.json seulement, fourni par Android) : il se teste sur la JVM sans Android.
+ */
+
+/** Une étape reçue du flux `GET /v1/runs/{id}/events` (SSE). `seq` = numéro d'ordre Hermes (reprise par `last_seq`). */
+sealed class HermesEvenement {
+    abstract val seq: Int
+
+    /** `message.delta` : morceau de la réponse finale, diffusé au fil de l'eau. */
+    data class Delta(override val seq: Int, val texte: String) : HermesEvenement()
+    /** `message.interim` : commentaire du modèle entre deux outils. */
+    data class Interim(override val seq: Int, val texte: String, val dejaDiffuse: Boolean) : HermesEvenement()
+    /** `reasoning.available` : texte de raisonnement (affiché replié, jamais dans la réponse). */
+    data class Raisonnement(override val seq: Int, val texte: String) : HermesEvenement()
+    /** `tool.started` : l'outil commence. `apercu` = aperçu des arguments construit par Hermes. */
+    data class OutilDebut(override val seq: Int, val outil: String, val apercu: String, val appelId: String?) : HermesEvenement()
+    /** `tool.completed` : l'outil a fini. `apercu` = résultat tronqué à 500 caractères et masqué par Hermes. */
+    data class OutilFin(override val seq: Int, val outil: String, val apercu: String, val appelId: String?, val erreur: Boolean, val duree: Double) : HermesEvenement()
+    /** `subagent.start` / `subagent.complete` (délégation). */
+    data class SousAgent(override val seq: Int, val fin: Boolean, val but: String?, val statut: String?, val resume: String?, val id: String?) : HermesEvenement()
+    /** `approval.request` : Hermes attend un accord avant d'exécuter un outil (greffon muse_gate ou commande dangereuse). */
+    data class AccordDemande(override val seq: Int, val requestId: String?, val commande: String?, val description: String?, val choix: List<String>, val brut: JSONObject,
+                             /** `execution_generation` quand l'événement la porte (chemin « session authority » de Hermes) ; sinon lue dans `GET /v1/runs/{id}`. */
+                             val generation: Int? = null) : HermesEvenement()
+    /** `approval.responded` : quelqu'un a répondu. */
+    data class AccordRepondu(override val seq: Int, val choix: String) : HermesEvenement()
+    /** `clarify.request` (ou équivalent) : Hermes pose une question. Muse la montre comme une réponse. */
+    data class Question(override val seq: Int, val texte: String, val brut: JSONObject) : HermesEvenement()
+    /** `run.completed|failed|cancelled|interrupted` : fin du run. */
+    data class Fin(
+        override val seq: Int,
+        val statut: String,
+        val sortie: String?,
+        val erreur: String?,
+        val raisonFin: String?,
+        val usage: HermesUsage?,
+        val modele: String?,
+        val fournisseur: String?,
+    ) : HermesEvenement() {
+        val reussi get() = statut == "completed"
+    }
+    /** `run.queued` : le run attend une place (gateway en relève). */
+    data class EnFile(override val seq: Int, val message: String?) : HermesEvenement()
+    /** `replay.truncated` : des événements anciens ont été perdus (plus de 1000 en mémoire). */
+    data class RepriseTronquee(override val seq: Int, val plusAncien: Int) : HermesEvenement()
+    /** Tout autre événement (gardé pour le journal, ignoré par l'écriture). */
+    data class Autre(override val seq: Int, val nom: String, val brut: JSONObject) : HermesEvenement()
+}
+
+data class HermesUsage(val entree: Long, val sortie: Long, val total: Long)
+
+/** Réponse 202 de `POST /v1/runs`. */
+data class HermesRunAccepte(val runId: String, val statut: String, val rejoue: Boolean, val cleSession: String?)
+
+/** Erreurs du client, classées pour la décision de repli. */
+sealed class HermesErreur(message: String, cause: Throwable? = null) : Exception(message, cause) {
+    /** Connexion refusée / processus absent : le moteur n'est pas là → repli possible. */
+    class Indisponible(message: String, cause: Throwable? = null) : HermesErreur(message, cause)
+    /** Délai dépassé (connexion, réponse, ou flux muet trop longtemps). */
+    class Delai(message: String, cause: Throwable? = null) : HermesErreur(message, cause)
+    /** 401 : la clé ne correspond pas (pack réinstallé ?). */
+    class Cle(message: String) : HermesErreur(message)
+    /** 429 : trop de runs en même temps. */
+    class Occupe(message: String) : HermesErreur(message)
+    /** Autre réponse HTTP d'erreur (enveloppe OpenAI `{"error":{message,type,code}}`). */
+    class Http(val statut: Int, val code: String?, message: String) : HermesErreur(message)
+    /** Réponse illisible. */
+    class Protocole(message: String) : HermesErreur(message)
+}
+
+/** Une ligne de `GET /api/sessions/{id}/messages` (clés sûres de `_message_response`). */
+data class HermesMessage(
+    val role: String,
+    val contenu: String,
+    val appelOutilId: String?,
+    val nomOutil: String?,
+    val appelsOutils: List<HermesAppelOutil>,
+)
+
+data class HermesAppelOutil(val id: String, val nom: String, val arguments: String)
+
+/** Lecture des trames SSE (format `_sse_frame` : `id: n`, `event: x`, `data: <json>`, ligne vide ; `: commentaire`). */
+class HermesSseLecteur {
+    /** JSON brut du dernier événement rendu (pour les modules qui lisent le flux tel quel : Équipe, journal). */
+    var dernierBrut: JSONObject? = null; private set
+    private var id: String? = null
+    private val data = StringBuilder()
+
+    /** Donne une ligne (sans le `\n`) ; renvoie l'événement quand une trame se termine. */
+    fun ligne(l: String): HermesEvenement? {
+        if (l.isEmpty()) return finTrame()
+        if (l.startsWith(":")) return null // `: open`, `: keepalive`, `: stream closed`
+        val i = l.indexOf(':')
+        val champ = if (i < 0) l else l.substring(0, i)
+        var valeur = if (i < 0) "" else l.substring(i + 1)
+        if (valeur.startsWith(" ")) valeur = valeur.substring(1)
+        when (champ) {
+            "id" -> id = valeur
+            "data" -> { if (data.isNotEmpty()) data.append('\n'); data.append(valeur) }
+            else -> {} // `event:` n'est pas utilisé par les runs (le nom est dans le JSON)
+        }
+        return null
+    }
+
+    private fun finTrame(): HermesEvenement? {
+        if (data.isEmpty()) { id = null; return null }
+        val texte = data.toString(); data.setLength(0)
+        val idTrame = id; id = null
+        val o = runCatching { JSONObject(texte) }.getOrNull() ?: return null
+        dernierBrut = o
+        return HermesProtocole.evenement(o, idTrame?.toIntOrNull())
+    }
+}
+
+object HermesProtocole {
+    /** Entier JSON exact (pas de texte, pas de décimale), sinon null : `execution_generation` doit être un int pour Hermes. */
+    fun entier(o: JSONObject?, k: String): Int? = (o?.opt(k) as? Number)?.takeIf { it !is Double && it !is Float || it.toDouble() % 1.0 == 0.0 }
+        ?.toLong()?.takeIf { it >= Int.MIN_VALUE.toLong() && it <= Int.MAX_VALUE.toLong() }?.toInt()
+
+    /**
+     * Corps de `POST /v1/runs/{id}/approval`. Hermes a4994d4 sous « session authority » (`respond_run`) exige EXACTEMENT
+     * `{"request_id": <prompt_id>, "execution_generation": <int>, "choice": …}` (toute autre clé → 400 invalid_params) ; le
+     * prompt et la génération viennent de l'événement ou de `GET /v1/runs/{id}` → `pending_controls[]` (kind = approval).
+     * [statut] = ce GET (null s'il n'a pas été lu). Renvoie null quand rien ne correspond à cette demande (ne jamais
+     * répondre à une AUTRE demande en attente) ; ancien chemin sans authority (pas de `pending_controls` ni de génération) :
+     * `{choice, request_id?}`.
+     */
+    fun corpsAccord(choix: String, requestId: String?, generation: Int?, statut: JSONObject?): JSONObject? {
+        if (requestId != null && generation != null) return exact(requestId, generation, choix)
+        val pcs = statut?.optJSONArray("pending_controls")
+        val genRun = entier(statut, "execution_generation")
+        if (pcs == null && genRun == null) return JSONObject().put("choice", choix).apply { requestId?.let { put("request_id", it) } }
+        val accords = (0 until (pcs?.length() ?: 0)).mapNotNull { pcs!!.optJSONObject(it) }.filter { it.optString("kind") == "approval" }
+        val pc = if (requestId != null) accords.firstOrNull { it.optString("prompt_id") == requestId || it.optString("request_id") == requestId }
+                 else accords.singleOrNull()
+        pc ?: return null
+        val pid = pc.optString("prompt_id").ifBlank { pc.optString("request_id") }.ifBlank { return null }
+        val gen = generation ?: entier(pc, "execution_generation") ?: genRun ?: return null
+        return exact(pid, gen, choix)
+    }
+
+    private fun exact(pid: String, gen: Int, choix: String) = JSONObject().put("request_id", pid).put("execution_generation", gen).put("choice", choix)
+
+    val STATUTS_FINAUX = setOf("completed", "failed", "cancelled", "interrupted")
+
+    fun evenement(o: JSONObject, idTrame: Int? = null): HermesEvenement {
+        val seq = if (o.has("seq")) o.optInt("seq", idTrame ?: -1) else (idTrame ?: -1)
+        val nom = o.optString("event")
+        return when {
+            nom == "message.delta" -> HermesEvenement.Delta(seq, o.optString("delta"))
+            nom == "message.interim" -> HermesEvenement.Interim(seq, o.optString("text"), o.optBoolean("already_streamed"))
+            nom == "reasoning.available" -> HermesEvenement.Raisonnement(seq, o.optString("text"))
+            nom == "tool.started" -> HermesEvenement.OutilDebut(seq, o.optString("tool"), o.optString("preview"), o.chaine("tool_call_id"))
+            nom == "tool.completed" -> HermesEvenement.OutilFin(seq, o.optString("tool"), o.optString("preview"), o.chaine("tool_call_id"), o.optBoolean("error"), o.optDouble("duration", 0.0))
+            nom == "subagent.start" || nom == "subagent.complete" -> HermesEvenement.SousAgent(
+                seq, nom == "subagent.complete", o.chaine("goal"), o.chaine("status"), o.chaine("summary"), o.chaine("subagent_id"))
+            nom == "approval.request" -> HermesEvenement.AccordDemande(
+                seq, o.chaine("request_id") ?: o.chaine("prompt_id"), o.chaine("command"), o.chaine("description"),
+                o.optJSONArray("choices")?.let { a -> (0 until a.length()).map { a.optString(it) } } ?: listOf("once", "deny"), o,
+                HermesProtocole.entier(o, "execution_generation"))
+            nom == "approval.responded" -> HermesEvenement.AccordRepondu(seq, o.optString("choice"))
+            nom.startsWith("clarify.") && nom.endsWith("request") -> HermesEvenement.Question(
+                seq, o.chaine("question") ?: o.chaine("prompt") ?: o.optString("text"), o)
+            nom == "run.queued" -> HermesEvenement.EnFile(seq, o.chaine("message"))
+            nom == "replay.truncated" -> HermesEvenement.RepriseTronquee(seq, o.optInt("oldest_retained_seq", -1))
+            nom.startsWith("run.") && nom.removePrefix("run.") in STATUTS_FINAUX -> fin(seq, nom.removePrefix("run."), o)
+            else -> HermesEvenement.Autre(seq, nom, o)
+        }
+    }
+
+    /** Fin à partir d'un événement `run.*` ou du statut `GET /v1/runs/{id}` (mêmes champs). */
+    fun fin(seq: Int, statut: String, o: JSONObject): HermesEvenement.Fin {
+        val rt = o.optJSONObject("runtime")
+        return HermesEvenement.Fin(
+            seq, statut, o.chaine("output"), o.chaine("error"), o.chaine("turn_exit_reason"),
+            o.optJSONObject("usage")?.let { usage(it) },
+            rt?.chaine("model"), rt?.chaine("provider"),
+        )
+    }
+
+    fun usage(u: JSONObject): HermesUsage {
+        val e = u.optLong("input_tokens", u.optLong("prompt_tokens", 0))
+        val s = u.optLong("output_tokens", u.optLong("completion_tokens", 0))
+        return HermesUsage(e, s, u.optLong("total_tokens", e + s))
+    }
+
+    /** Message d'une enveloppe d'erreur `{"error":{"message","type","code"}}`. */
+    fun erreurHttp(statut: Int, corps: String?): HermesErreur {
+        val err = runCatching { JSONObject(corps ?: "").optJSONObject("error") }.getOrNull()
+        val msg = err?.chaine("message") ?: corps?.take(300)?.ifBlank { null } ?: "HTTP $statut"
+        val code = err?.chaine("code")
+        return when (statut) {
+            401, 403 -> HermesErreur.Cle(msg)
+            429 -> HermesErreur.Occupe(msg)
+            else -> HermesErreur.Http(statut, code, msg)
+        }
+    }
+
+    fun runAccepte(corps: String, cleSession: String?): HermesRunAccepte {
+        val o = runCatching { JSONObject(corps) }.getOrNull() ?: throw HermesErreur.Protocole("Réponse de /v1/runs illisible")
+        val id = o.chaine("run_id") ?: throw HermesErreur.Protocole("run_id absent")
+        return HermesRunAccepte(id, o.optString("status", "started"), o.optBoolean("replayed"), cleSession)
+    }
+
+    fun messages(corps: String): List<HermesMessage> {
+        val data = runCatching { JSONObject(corps).optJSONArray("data") }.getOrNull() ?: return emptyList()
+        return (0 until data.length()).mapNotNull { data.optJSONObject(it) }.map { m ->
+            val appels = m.optJSONArray("tool_calls")?.let { a ->
+                (0 until a.length()).mapNotNull { a.optJSONObject(it) }.map { c ->
+                    val f = c.optJSONObject("function")
+                    HermesAppelOutil(c.optString("id"), f?.optString("name") ?: c.optString("name"), f?.optString("arguments") ?: "")
+                }
+            } ?: emptyList()
+            HermesMessage(m.optString("role"), contenu(m.opt("content")), m.chaine("tool_call_id"), m.chaine("tool_name"), appels)
+        }
+    }
+
+    private fun contenu(c: Any?): String = when (c) {
+        null, JSONObject.NULL -> ""
+        is String -> c
+        is JSONArray -> (0 until c.length()).joinToString("") { i ->
+            val p = c.opt(i); if (p is JSONObject) p.optString("text") else p?.toString() ?: "" }
+        else -> c.toString()
+    }
+
+    /** Corps de `POST /v1/runs`. Champs lus par `_handle_runs` / `_request_agent_overrides`. */
+    fun corpsRun(
+        texte: String,
+        sessionId: String,
+        modele: String?,
+        fournisseur: String?,
+        instructions: String?,
+        historique: List<Pair<String, String>>,
+    ): JSONObject = JSONObject().apply {
+        put("input", texte)
+        put("session_id", sessionId)
+        modele?.takeIf { it.isNotBlank() }?.let { put("model", it) }
+        fournisseur?.takeIf { it.isNotBlank() }?.let { put("provider", it) }
+        instructions?.takeIf { it.isNotBlank() }?.let { put("instructions", it) }
+        if (historique.isNotEmpty()) put("conversation_history", JSONArray().apply {
+            historique.forEach { (r, c) -> put(JSONObject().put("role", r).put("content", c)) }
+        })
+    }
+
+    private fun JSONObject.chaine(k: String): String? =
+        if (!has(k) || isNull(k)) null else optString(k).takeIf { it.isNotEmpty() }
+}
