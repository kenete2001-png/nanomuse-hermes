+package io.github.kenete.nanohermes.hermes
+
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.currentCoroutineContext
+import kotlinx.coroutines.Job
+import kotlinx.coroutines.withContext
+import okhttp3.Call
+import okhttp3.MediaType.Companion.toMediaType
+import okhttp3.OkHttpClient
+import okhttp3.Request
+import okhttp3.RequestBody.Companion.toRequestBody
+import okhttp3.Response
+import org.json.JSONObject
+import java.io.IOException
+import java.io.InterruptedIOException
+import java.net.ConnectException
+import java.net.SocketTimeoutException
+import java.util.concurrent.TimeUnit
+
+/**
+ * duetmuse fusion E3 : client de l'API HTTP locale de Hermes (gateway `api_server`).
+ *
+ * - Adresse : `http://127.0.0.1:<port>` uniquement (le lanceur du pack force API_SERVER_HOST=127.0.0.1).
+ * - Authentification : `Authorization: Bearer <clé>` (clé aléatoire ≥ 16 caractères, sinon Hermes refuse de démarrer).
+ * - Le flux SSE envoie `: keepalive` toutes les 10 s (CHAT_COMPLETIONS_SSE_KEEPALIVE_SECONDS) : un silence de
+ *   [silenceFluxMs] veut dire un flux mort → [HermesErreur.Delai], et on reprend avec `last_seq`.
+ * Kotlin pur (OkHttp + org.json) : testé avec MockWebServer.
+ */
+class HermesClient(
+    private val base: String,
+    private val cle: () -> String,
+    httpBase: OkHttpClient = OkHttpClient(),
+    val delaiConnexionMs: Long = 3_000,
+    val delaiReponseMs: Long = 20_000,
+    val silenceFluxMs: Long = 45_000,
+) {
+    private val json = "application/json".toMediaType()
+    private val http = httpBase.newBuilder()
+        .connectTimeout(delaiConnexionMs, TimeUnit.MILLISECONDS)
+        .readTimeout(delaiReponseMs, TimeUnit.MILLISECONDS)
+        .writeTimeout(delaiReponseMs, TimeUnit.MILLISECONDS)
+        .callTimeout(0, TimeUnit.MILLISECONDS)
+        .retryOnConnectionFailure(false)
+        .build()
+    private val httpFlux = http.newBuilder().readTimeout(silenceFluxMs, TimeUnit.MILLISECONDS).build()
+    private val httpSante = http.newBuilder()
+        .connectTimeout(1_500, TimeUnit.MILLISECONDS).readTimeout(3_000, TimeUnit.MILLISECONDS).build()
+
+    private fun req(chemin: String) = Request.Builder().url(base.trimEnd('/') + chemin)
+        .header("Authorization", "Bearer " + cle())
+
+    /** `GET /health` (sans clé côté Hermes, mais on l'envoie quand même) : vrai si `{"status":"ok"}`. */
+    suspend fun sante(): Boolean = runCatching {
+        appel(httpSante.newCall(req("/health").get().build())) { r ->
+            r.isSuccessful && JSONObject(r.body?.string() ?: "{}").optString("status") == "ok"
+        }
+    }.getOrDefault(false)
+
+    /** `GET /api/sessions/{id}` : la session existe-t-elle déjà côté Hermes ? (404 → non). */
+    suspend fun sessionExiste(sessionId: String): Boolean =
+        appel(http.newCall(req("/api/sessions/" + enc(sessionId)).get().build())) { r ->
+            when {
+                r.isSuccessful -> true
+                r.code == 404 -> false
+                else -> throw HermesProtocole.erreurHttp(r.code, r.body?.string())
+            }
+        }
+
+    /** `POST /v1/runs` → 202 `{run_id, status, replayed}`. La clé d'idempotence évite un double run si on renvoie. */
+    suspend fun demarrerRun(
+        texte: String,
+        sessionId: String,
+        modele: String? = null,
+        fournisseur: String? = null,
+        instructions: String? = null,
+        historique: List<Pair<String, String>> = emptyList(),
+        cleIdempotence: String? = null,
+    ): HermesRunAccepte {
+        val corps = HermesProtocole.corpsRun(texte, sessionId, modele, fournisseur, instructions, historique)
+        val b = req("/v1/runs").post(corps.toString().toRequestBody(json))
+        cleIdempotence?.let { b.header("Idempotency-Key", it) }
+        return appel(http.newCall(b.build())) { r ->
+            val txt = r.body?.string()
+            if (r.code != 202 && !r.isSuccessful) throw HermesProtocole.erreurHttp(r.code, txt)
+            HermesProtocole.runAccepte(txt ?: "", r.header("X-Hermes-Session-Key"))
+        }
+    }
+
+    /** `GET /v1/runs/{id}` : statut (sert après une coupure du flux pour connaître l'issue). */
+    suspend fun statut(runId: String): JSONObject =
+        appel(http.newCall(req("/v1/runs/" + enc(runId)).get().build())) { r ->
+            val txt = r.body?.string()
+            if (!r.isSuccessful) throw HermesProtocole.erreurHttp(r.code, txt)
+            runCatching { JSONObject(txt ?: "") }.getOrElse { throw HermesErreur.Protocole("statut illisible") }
+        }
+
+    /**
+     * `GET /v1/runs/{id}/events?last_seq=n` : lit le flux jusqu'à sa fermeture (`: stream closed`).
+     * Chaque événement passe à [surEvenement] dans l'ordre (appel synchrone sur le fil IO : ne pas y bloquer). Renvoie le dernier `seq` lu.
+     */
+    suspend fun lireEvenements(runId: String, dernierSeq: Int, surBrut: ((org.json.JSONObject) -> Unit)? = null, surEvenement: (HermesEvenement) -> Unit): Int {
+        val b = req("/v1/runs/" + enc(runId) + "/events" + if (dernierSeq >= 0) "?last_seq=$dernierSeq" else "")
+            .header("Accept", "text/event-stream").get()
+        if (dernierSeq >= 0) b.header("Last-Event-ID", dernierSeq.toString())
+        var seq = dernierSeq
+        appel(httpFlux.newCall(b.build())) { r ->
+            if (!r.isSuccessful) throw HermesProtocole.erreurHttp(r.code, r.body?.string())
+            val source = r.body?.source() ?: throw HermesErreur.Protocole("flux vide")
+            val lecteur = HermesSseLecteur()
+            while (true) {
+                val l = source.readUtf8Line() ?: break
+                val ev = lecteur.ligne(l) ?: continue
+                if (ev.seq >= 0) seq = maxOf(seq, ev.seq)
+                surBrut?.let { f -> lecteur.dernierBrut?.let { runCatching { f(it) } } }
+                surEvenement(ev)
+            }
+            lecteur.ligne("")?.let { ev -> if (ev.seq >= 0) seq = maxOf(seq, ev.seq); surEvenement(ev) }
+        }
+        return seq
+    }
+
+    /**
+     * `POST /v1/runs/{id}/approval`. Corps exact exigé par Hermes (voir [HermesProtocole.corpsAccord]) : si l'événement ne
+     * porte pas la génération, elle est lue dans `GET /v1/runs/{id}` → `pending_controls[]`. Faux = rien à quoi répondre
+     * (409, ou demande plus en attente) : Hermes bloque alors l'outil à son délai (fail closed).
+     */
+    suspend fun repondreAccord(runId: String, choix: String, requestId: String?, generation: Int? = null): Boolean {
+        val st = if (requestId != null && generation != null) null else runCatching { statut(runId) }.getOrNull()
+        val o = HermesProtocole.corpsAccord(choix, requestId, generation, st) ?: return false
+        return appel(http.newCall(req("/v1/runs/" + enc(runId) + "/approval").post(o.toString().toRequestBody(json)).build())) { r ->
+            r.isSuccessful.also { if (!it && r.code != 409) throw HermesProtocole.erreurHttp(r.code, r.body?.string()) }
+        }
+    }
+
+    /** `POST /v1/runs/{id}/stop` ; 409 (déjà fini) n'est pas une erreur. */
+    suspend fun arreter(runId: String): Boolean = runCatching {
+        appel(http.newCall(req("/v1/runs/" + enc(runId) + "/stop").post("{}".toRequestBody(json)).build())) { r -> r.isSuccessful }
+    }.getOrDefault(false)
+
+    /** `GET /api/sessions/{id}/messages?order=latest&limit=n` : historique complet (résultats d'outils entiers). */
+    suspend fun messagesSession(sessionId: String, limite: Int = 200): List<HermesMessage> =
+        appel(http.newCall(req("/api/sessions/" + enc(sessionId) + "/messages?order=latest&limit=$limite").get().build())) { r ->
+            val txt = r.body?.string()
+            if (!r.isSuccessful) throw HermesProtocole.erreurHttp(r.code, txt)
+            HermesProtocole.messages(txt ?: "")
+        }
+
+    /**
+     * Historique COMPLET en JSON brut (toutes les pages, du plus ancien au plus récent), au format de
+     * `GET /api/sessions/{id}/messages` : `{"object":"list","session_id":…,"data":[…]}`. Pour la Garde (module E5).
+     */
+    suspend fun messagesBruts(sessionId: String, page: Int = 500): String {
+        val tout = org.json.JSONArray()
+        var offset = 0
+        var sid = sessionId
+        while (true) {
+            val o = appel(http.newCall(req("/api/sessions/" + enc(sessionId) + "/messages?order=oldest&limit=$page&offset=$offset").get().build())) { r ->
+                val txt = r.body?.string()
+                if (!r.isSuccessful) throw HermesProtocole.erreurHttp(r.code, txt)
+                runCatching { JSONObject(txt ?: "") }.getOrElse { throw HermesErreur.Protocole("messages illisibles") }
+            }
+            sid = o.optString("session_id", sid)
+            val d = o.optJSONArray("data") ?: org.json.JSONArray()
+            for (i in 0 until d.length()) tout.put(d.get(i))
+            if (d.length() < page || offset > 100_000) break
+            offset += d.length()
+        }
+        return JSONObject().put("object", "list").put("session_id", sid).put("data", tout).toString()
+    }
+
+    private fun enc(s: String) = java.net.URLEncoder.encode(s, "UTF-8").replace("+", "%20")
+
+    /** Exécute l'appel sur IO ; l'annulation de la coroutine annule l'appel OkHttp ; erreurs réseau → [HermesErreur]. */
+    private suspend fun <T> appel(call: Call, bloc: (Response) -> T): T {
+        val job = currentCoroutineContext()[Job]
+        val h = job?.invokeOnCompletion { if (it != null) call.cancel() }
+        try {
+            return withContext(Dispatchers.IO) {
+                try {
+                    call.execute().use(bloc)
+                } catch (e: HermesErreur) {
+                    throw e
+                } catch (e: ConnectException) {
+                    throw HermesErreur.Indisponible("Hermes ne répond pas sur ${base}", e)
+                } catch (e: SocketTimeoutException) {
+                    throw HermesErreur.Delai("Hermes : délai dépassé", e)
+                } catch (e: InterruptedIOException) {
+                    if (call.isCanceled()) throw kotlinx.coroutines.CancellationException("annulé").apply { initCause(e) }
+                    throw HermesErreur.Delai("Hermes : délai dépassé", e)
+                } catch (e: IOException) {
+                    if (call.isCanceled()) throw kotlinx.coroutines.CancellationException("annulé").apply { initCause(e) }
+                    throw HermesErreur.Indisponible("Hermes : connexion perdue (${e.javaClass.simpleName})", e)
+                }
+            }
+        } finally {
+            h?.dispose()
+        }
+    }
+}
