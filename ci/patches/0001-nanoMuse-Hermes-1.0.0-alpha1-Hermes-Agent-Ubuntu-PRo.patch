@@ -0,0 +1,181 @@
+package io.github.kenete.nanohermes.hermes
+
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Job
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import kotlinx.coroutines.isActive
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.sync.Mutex
+import kotlinx.coroutines.sync.withLock
+
+/** Un processus `hermes-muse gateway` lancé (sous PRoot dans l'app, ou faux processus en test). */
+interface HermesProcessus {
+    val vivant: Boolean
+    /** SIGTERM puis, si besoin, destruction forcée. */
+    fun arreter()
+    /** Dernières lignes du journal du processus (diagnostic, jamais de clé : le lanceur ne l'écrit pas). */
+    fun journal(): String = ""
+}
+
+/** Lance le gateway. Lève [HermesPackAbsent] si le pack n'est pas installé. */
+fun interface HermesLanceur { fun lancer(): HermesProcessus }
+
+class HermesPackAbsent(message: String) : Exception(message)
+
+fun interface HermesHorloge { fun ms(): Long }
+
+/**
+ * duetmuse fusion E3 : cycle de vie du processus Hermes.
+ *
+ * - Démarrage paresseux à la première tâche ([assurerPret]), jamais au lancement de l'app.
+ * - Prêt = `GET /health` répond `ok` ; délai de démarrage [delaiDemarrageMs] (60 s : PRoot sur A26 est lent).
+ * - Arrêt après [inactiviteMs] (10 min) sans tâche en cours ([verifierInactivite], appelée par [demarrerMinuterie]).
+ *   Le greffon muse_gate du pack s'arrête aussi tout seul après 600 s : double sécurité.
+ * - Après un échec de démarrage, on n'essaie plus pendant [pauseApresEchecMs] (le repli natif sert entre-temps),
+ *   pour ne pas faire attendre 60 s à chaque message.
+ * Kotlin pur : le lanceur, la sonde et l'horloge sont injectés (tests JVM).
+ */
+class HermesSuperviseur(
+    private val lanceur: HermesLanceur,
+    private val sonde: suspend () -> Boolean,
+    private val horloge: HermesHorloge = HermesHorloge { System.currentTimeMillis() },
+    val delaiDemarrageMs: Long = 60_000,
+    val inactiviteMs: Long = 10 * 60_000,
+    val pauseApresEchecMs: Long = 5 * 60_000,
+    private val intervalleSondeMs: Long = 500,
+    private val pause: suspend (Long) -> Unit = { delay(it) },
+    /** Appelé quand un gateway lancé devient prêt (ex. démarrer le serveur MCP du téléphone, module E5). */
+    private val auDemarrage: () -> Unit = {},
+    /** Appelé quand le gateway est arrêté (inactivité, panne, demande). */
+    private val alArret: () -> Unit = {},
+) {
+    enum class Etat { ARRETE, DEMARRAGE, PRET, ECHEC }
+
+    data class Sante(val etat: Etat, val raison: String?, val tachesEnCours: Int, val inactifDepuisMs: Long, val demarrages: Int)
+
+    private val verrou = Mutex()
+    private var processus: HermesProcessus? = null
+    private val _etat = MutableStateFlow(Etat.ARRETE)
+    val etat: StateFlow<Etat> = _etat.asStateFlow()
+    @Volatile var derniereRaison: String? = null; private set
+    @Volatile private var echecA: Long = Long.MIN_VALUE
+    @Volatile private var derniereActivite: Long = horloge.ms()
+    @Volatile var demarrages: Int = 0; private set
+    private var taches = 0
+    private val verrouTaches = Any()
+    private var minuterie: Job? = null
+
+    /** Vrai pendant la pause qui suit un échec de démarrage. */
+    fun enPauseApresEchec(): Boolean = _etat.value == Etat.ECHEC && horloge.ms() - echecA < pauseApresEchecMs
+
+    /**
+     * Démarre Hermes si besoin et attend qu'il soit prêt. Renvoie vrai si prêt.
+     * Faux = pack absent, processus mort, délai dépassé ou pause après échec : [derniereRaison] dit pourquoi.
+     */
+    suspend fun assurerPret(): Boolean = verrou.withLock {
+        val p = processus
+        if (_etat.value == Etat.PRET && p != null && p.vivant) {
+            if (sonde()) { activite(); return@withLock true }
+            // vivant mais muet : on le relance
+            arreterInterne("ne répond plus")
+        } else if (p != null && !p.vivant) {
+            arreterInterne("processus terminé")
+        }
+        if (enPauseApresEchec()) return@withLock false
+        _etat.value = Etat.DEMARRAGE
+        val nouveau = try {
+            lanceur.lancer()
+        } catch (e: HermesPackAbsent) {
+            return@withLock echec(e.message ?: "pack Hermes absent")
+        } catch (e: Exception) {
+            return@withLock echec("lancement impossible : ${e.javaClass.simpleName}: ${e.message}")
+        }
+        processus = nouveau
+        demarrages++
+        val debut = horloge.ms()
+        while (true) {
+            if (!nouveau.vivant) {
+                processus = null
+                return@withLock echec("Hermes s'est arrêté au démarrage" + nouveau.journal().takeLast(400).let { if (it.isBlank()) "" else " : $it" })
+            }
+            if (sonde()) {
+                _etat.value = Etat.PRET
+                derniereRaison = null
+                activite()
+                runCatching { auDemarrage() }
+                return@withLock true
+            }
+            if (horloge.ms() - debut >= delaiDemarrageMs) {
+                runCatching { nouveau.arreter() }
+                processus = null
+                return@withLock echec("Hermes pas prêt après ${delaiDemarrageMs / 1000} s")
+            }
+            pause(intervalleSondeMs)
+        }
+        @Suppress("UNREACHABLE_CODE")
+        false
+    }
+
+    private fun echec(raison: String): Boolean {
+        derniereRaison = raison
+        echecA = horloge.ms()
+        _etat.value = Etat.ECHEC
+        return false
+    }
+
+    fun debutTache() { synchronized(verrouTaches) { taches++ }; activite() }
+    fun finTache() { synchronized(verrouTaches) { if (taches > 0) taches-- }; activite() }
+    fun activite() { derniereActivite = horloge.ms() }
+    fun tachesEnCours(): Int = synchronized(verrouTaches) { taches }
+
+    /** Arrête Hermes s'il est inactif depuis [inactiviteMs] et sans tâche. Renvoie vrai s'il a été arrêté. */
+    suspend fun verifierInactivite(): Boolean {
+        if (processus == null) return false
+        if (tachesEnCours() > 0) return false
+        if (horloge.ms() - derniereActivite < inactiviteMs) return false
+        verrou.withLock {
+            if (processus == null || tachesEnCours() > 0 || horloge.ms() - derniereActivite < inactiviteMs) return false
+            arreterInterne("inactif depuis ${inactiviteMs / 60_000} min")
+        }
+        return true
+    }
+
+    /** Boucle de surveillance (toutes les 30 s) : inactivité et processus mort. Idempotente. */
+    fun demarrerMinuterie(scope: CoroutineScope, periodeMs: Long = 30_000) {
+        if (minuterie?.isActive == true) return
+        minuterie = scope.launch {
+            while (isActive) {
+                pause(periodeMs)
+                runCatching { verifierInactivite() }
+                val p = processus
+                if (p != null && !p.vivant && _etat.value == Etat.PRET) verrou.withLock {
+                    if (processus === p) arreterInterne("processus terminé")
+                }
+            }
+        }
+    }
+
+    suspend fun arreter(raison: String = "arrêt demandé") = verrou.withLock { arreterInterne(raison) }
+
+    private fun arreterInterne(raison: String) {
+        val p = processus
+        p?.let { runCatching { it.arreter() } }
+        processus = null
+        if (p != null) runCatching { alArret() }
+        derniereRaison = raison
+        _etat.value = Etat.ARRETE
+    }
+
+    suspend fun sante(): Sante {
+        val p = processus
+        val e = when {
+            _etat.value == Etat.PRET && (p == null || !p.vivant) -> Etat.ARRETE
+            _etat.value == Etat.PRET && !sonde() -> Etat.ECHEC
+            else -> _etat.value
+        }
+        return Sante(e, derniereRaison, tachesEnCours(), horloge.ms() - derniereActivite, demarrages)
+    }
+}
