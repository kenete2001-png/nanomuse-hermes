+        val k2 = HermesPack.cle(h)
+        assertTrue(k2.length >= 16 && k2 != "court")
+        assertEquals(1, File(h, ".env").readLines().count { it.startsWith("API_SERVER_KEY=") })
+        assertEquals(HermesPack.PORT_DEFAUT, HermesPack.port(h)) // port invalide → défaut
+    }
+    // ── repris de Hermes, au style Muse : réflexion, sous-agents, démarrage, résumé, libellés ──
+
+    @Test fun vue_reflexion_sous_agents_demarrage_et_resume() {
+        val h = HermesFauxE3.Horloge()
+        val v = HermesVueDirecte(h)
+        v.demarrage(); v.demarrage()
+        assertEquals(listOf(HermesVueDirecte.ID_DEMARRAGE), v.blocs().map { it.id })
+        assertEquals(HermesVueDirecte.Genre.INFO, v.blocs()[0].genre)
+        v.appliquer(HermesEvenement.Raisonnement(0, "Il faut comparer deux sources."))
+        v.appliquer(HermesEvenement.Raisonnement(1, "Puis vérifier la date."))
+        assertTrue(v.blocs().none { it.id == HermesVueDirecte.ID_DEMARRAGE }) // la ligne de démarrage part au 1er événement
+        assertEquals(1, v.blocs().count { it.genre == HermesVueDirecte.Genre.REFLEXION })
+        assertEquals("Il faut comparer deux sources.\nPuis vérifier la date.", v.blocs()[0].contenu)
+        v.appliquer(HermesEvenement.SousAgent(2, false, "Trouver l'heure du lever du soleil à Cotonou", null, null, "sa1"))
+        v.appliquer(HermesEvenement.SousAgent(3, false, "Trouver l'heure du lever du soleil à Cotonou", null, null, "sa1")) // doublon ignoré
+        v.appliquer(HermesEvenement.OutilDebut(4, "web_search", "lever du soleil Cotonou", null))
+        h.t += 1_500
+        v.appliquer(HermesEvenement.OutilFin(5, "web_search", "6 h 12", null, false, 0.0))
+        val sa = v.blocs().single { it.nomOutil == HermesLibelles.OUTIL_SOUS_AGENT }
+        assertEquals(HermesVueDirecte.Statut.EN_COURS, sa.statut) // la fin d'un outil ne ferme pas la carte du sous-agent
+        assertTrue(sa.titre, sa.titre.startsWith("subagent · Trouver l'heure"))
+        h.t += 2_000
+        v.appliquer(HermesEvenement.SousAgent(6, true, null, "completed", "Lever à 6 h 12.", "sa1"))
+        val sa2 = v.blocs().single { it.nomOutil == HermesLibelles.OUTIL_SOUS_AGENT }
+        assertEquals(HermesVueDirecte.Statut.OK, sa2.statut); assertEquals("Lever à 6 h 12.", sa2.contenu); assertEquals(3_500L, sa2.dureeMs)
+        v.appliquer(HermesEvenement.OutilDebut(7, "terminal", "rm -rf /", null))
+        v.appliquer(HermesEvenement.OutilDebut(8, "write_file", "notes.md", null))
+        v.appliquer(HermesEvenement.OutilFin(9, "write_file", "erreur disque", null, true, 0.3))
+        h.t += 700
+        v.appliquer(HermesEvenement.Fin(10, "completed", "Le soleil se lève à 6 h 12 [1].", null, null, null, null, null))
+        assertTrue("pas de ligne récapitulative ajoutée", v.blocs().none { it.id == HermesVueDirecte.ID_RESUME })
+        assertEquals("Le soleil se lève à 6 h 12 [1].", v.texte())
+        assertEquals("terminal · rm -rf /", v.blocs().first { it.nomOutil == "terminal" }.titre)
+    }
+
+    @Test fun titres_cartes_noms_de_hermes() {
+        assertEquals("web_search · horaires", HermesLibelles.titreCarte("web_search", "  horaires  "))
+        assertEquals("web_extract", HermesLibelles.titreCarte("web_extract", ""))
+        assertEquals("terminal · " + "a".repeat(59) + "…", HermesLibelles.titreCarte("terminal", "a".repeat(200)))
+        assertNull(HermesLibelles.resume(3, 1, 1, 1, 1000))
+    }
+}
diff --git a/android/src/android/app/src/test/java/io/github/kenete/nanohermes/hermes/HermesSuperviseurE3Test.kt b/android/src/android/app/src/test/java/io/github/kenete/nanohermes/hermes/HermesSuperviseurE3Test.kt
new file mode 100644
index 00000000..70a75fd8
--- /dev/null
+++ b/android/src/android/app/src/test/java/io/github/kenete/nanohermes/hermes/HermesSuperviseurE3Test.kt
@@ -0,0 +1,175 @@
+package io.github.kenete.nanohermes.hermes
+
+import kotlinx.coroutines.runBlocking
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNotNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/** E3 : cycle de vie du processus Hermes (démarrage paresseux, santé, délai, arrêt après 10 min, pause après échec). */
+class HermesSuperviseurE3Test {
+    private val h = HermesFauxE3.Horloge()
+    private val lances = mutableListOf<HermesFauxE3.Processus>()
+    private var pretApresSondes = 3
+    private var sondes = 0
+    private var packPresent = true
+    private var fabrique: () -> HermesFauxE3.Processus = { HermesFauxE3.Processus() }
+
+    private fun sup(delai: Long = 60_000) = HermesSuperviseur(
+        lanceur = { if (!packPresent) throw HermesPackAbsent("pack absent"); fabrique().also { lances.add(it) } },
+        sonde = { sondes++; lances.lastOrNull()?.vivant == true && sondes >= pretApresSondes },
+        horloge = h, delaiDemarrageMs = delai, pause = { h.t += it },
+    )
+
+    @Test fun demarrage_paresseux_puis_pret() = runBlocking {
+        val s = sup()
+        assertEquals(0, lances.size)
+        assertEquals(HermesSuperviseur.Etat.ARRETE, s.etat.value)
+        assertTrue(s.assurerPret())
+        assertEquals(1, lances.size)
+        assertEquals(HermesSuperviseur.Etat.PRET, s.etat.value)
+        assertTrue(s.assurerPret()) // déjà prêt : pas de second lancement
+        assertEquals(1, lances.size)
+        assertEquals(1, s.demarrages)
+    }
+
+    @Test fun delai_de_demarrage_depasse_arrete_et_met_en_pause() = runBlocking {
+        pretApresSondes = Int.MAX_VALUE
+        val s = sup(delai = 60_000)
+        val t0 = h.t
+        assertFalse(s.assurerPret())
+        assertTrue(h.t - t0 >= 60_000)
+        assertEquals(1, lances.single().arrets)
+        assertEquals(HermesSuperviseur.Etat.ECHEC, s.etat.value)
+        assertTrue(s.derniereRaison!!.contains("60 s"))
+        assertTrue(s.enPauseApresEchec())
+        assertFalse(s.assurerPret()) // pendant la pause : aucun nouveau lancement
+        assertEquals(1, lances.size)
+        h.t += 5 * 60_000
+        assertFalse(s.enPauseApresEchec())
+        pretApresSondes = 0
+        assertTrue(s.assurerPret())
+        assertEquals(2, lances.size)
+    }
+
+    @Test fun pack_absent() = runBlocking {
+        packPresent = false
+        val s = sup()
+        assertFalse(s.assurerPret())
+        assertEquals("pack absent", s.derniereRaison)
+        assertEquals(0, lances.size)
+    }
+
+    @Test fun processus_mort_au_demarrage_donne_le_journal() = runBlocking {
+        pretApresSondes = Int.MAX_VALUE
+        fabrique = { HermesFauxE3.Processus(vie = false, log = "API Server: aiohttp not installed") }
+        val s = sup()
+        assertFalse(s.assurerPret())
+        assertTrue(s.derniereRaison!!.contains("aiohttp not installed"))
+    }
+
+    @Test fun arret_apres_dix_minutes_sans_tache() = runBlocking {
+        val s = sup()
+        assertTrue(s.assurerPret())
+        h.t += 9 * 60_000
+        assertFalse(s.verifierInactivite())
+        h.t += 60_000
+        assertTrue(s.verifierInactivite())
+        assertEquals(1, lances.single().arrets)
+        assertEquals(HermesSuperviseur.Etat.ARRETE, s.etat.value)
+        assertFalse(s.verifierInactivite()) // déjà arrêté
+    }
+
+    @Test fun pas_d_arret_pendant_une_tache_et_l_activite_repousse() = runBlocking {
+        val s = sup()
+        assertTrue(s.assurerPret())
+        s.debutTache()
+        h.t += 30 * 60_000
+        assertFalse(s.verifierInactivite())
+        s.finTache()
+        h.t += 5 * 60_000
+        assertFalse(s.verifierInactivite())
+        s.activite()
+        h.t += 9 * 60_000
+        assertFalse(s.verifierInactivite())
+        h.t += 60_000
+        assertTrue(s.verifierInactivite())
+    }
+
+    @Test fun relance_si_processus_mort_ou_muet() = runBlocking {
+        pretApresSondes = 0
+        val s = sup()
+        assertTrue(s.assurerPret())
+        lances.last().vie = false
+        assertTrue(s.assurerPret())
+        assertEquals(2, lances.size)
+        // vivant mais muet : relancé
+        var muet = true
+        val s2 = HermesSuperviseur({ HermesFauxE3.Processus().also { lances.add(it) } },
+            { !muet || lances.size >= 4 }, h, pause = { h.t += it })
+        muet = false
+        assertTrue(s2.assurerPret()); assertEquals(3, lances.size)
+        muet = true
+        assertTrue(s2.assurerPret()) // la sonde échoue → arrêt du 3e, lancement du 4e
+        assertEquals(1, lances[2].arrets)
+        assertEquals(4, lances.size)
+    }
+
+    @Test fun sante_et_arret_demande() = runBlocking {
+        pretApresSondes = 0
+        val s = sup()
+        assertTrue(s.assurerPret())
+        s.debutTache()
+        val st = s.sante()
+        assertEquals(HermesSuperviseur.Etat.PRET, st.etat)
+        assertEquals(1, st.tachesEnCours)
+        s.finTache()
+        s.arreter("test")
+        assertEquals(HermesSuperviseur.Etat.ARRETE, s.sante().etat)
+        assertEquals("test", s.derniereRaison)
+        assertNotNull(lances.single().arrets.takeIf { it == 1 })
+    }
+
+    @Test fun minuterie_arrete_le_moteur_inactif() = runBlocking {
+        pretApresSondes = 0
+        val s = sup()
+        assertTrue(s.assurerPret())
+        h.t += 11 * 60_000
+        val portee = kotlinx.coroutines.CoroutineScope(kotlinx.coroutines.SupervisorJob() + kotlinx.coroutines.Dispatchers.Default)
+        // pause réelle courte pour la minuterie : on reconstruit avec une pause qui laisse tourner
+        val s2 = HermesSuperviseur({ HermesFauxE3.Processus().also { lances.add(it) } }, { true }, h, pause = { kotlinx.coroutines.delay(5) })
+        assertTrue(s2.assurerPret())
+        h.t += 11 * 60_000
+        s2.demarrerMinuterie(portee, periodeMs = 10)
+        val fin = System.currentTimeMillis() + 3_000
+        while (s2.etat.value != HermesSuperviseur.Etat.ARRETE && System.currentTimeMillis() < fin) Thread.sleep(10)
+        portee.coroutineContext[kotlinx.coroutines.Job]?.cancel()
+        assertEquals(HermesSuperviseur.Etat.ARRETE, s2.etat.value)
+        assertTrue(s.verifierInactivite())
+    }
+    @Test fun rappels_demarrage_et_arret() = runBlocking {
+        var dem = 0; var arr = 0
+        pretApresSondes = 0
+        val s = HermesSuperviseur({ HermesFauxE3.Processus().also { lances.add(it) } }, { true }, h, pause = { h.t += it },
+            auDemarrage = { dem++ }, alArret = { arr++ })
+        assertTrue(s.assurerPret()); assertTrue(s.assurerPret())
+        assertEquals(1, dem); assertEquals(0, arr)
+        h.t += 10 * 60_000
+        assertTrue(s.verifierInactivite())
+        assertEquals(1, arr)
+        s.arreter("encore") // rien à arrêter : pas de second rappel
+        assertEquals(1, arr)
+        assertTrue(s.assurerPret()); assertEquals(2, dem)
+    }
+
+    @Test fun inactivite_exacte_dix_minutes() = runBlocking {
+        pretApresSondes = 0
+        val s = sup()
+        assertTrue(s.assurerPret())
+        h.t += 10 * 60_000 - 1
+        assertFalse(s.verifierInactivite())
+        h.t += 1
+        assertTrue(s.verifierInactivite())
+    }
+}
diff --git a/android/src/android/app/src/test/java/io/github/kenete/nanohermes/hermes/MiseAJourTest.kt b/android/src/android/app/src/test/java/io/github/kenete/nanohermes/hermes/MiseAJourTest.kt
new file mode 100644
