@@ -0,0 +1,79 @@
+package io.github.kenete.nanohermes.hermes
+
+/**
+ * nanoMuse Hermes : le fournisseur de modèles choisi par la personne pour Hermes, et sa clé API (Kotlin pur, testé sur la JVM).
+ *
+ * - La clé ne quitte l'app que par l'ENVIRONNEMENT du processus Hermes, sous le nom que Hermes connaît pour ce fournisseur
+ *   (registre de Hermes : OPENROUTER_API_KEY…) ; pour une adresse compatible OpenAI, `AUXILIARY_NANOHERMES_API_KEY` (Hermes
+ *   retire les noms `AUXILIARY_*_API_KEY` et ceux de son registre de l'environnement des commandes qu'il lance).
+ * - `config.yaml` ne reçoit que la section `model` (fournisseur, modèle, adresse, NOM de la variable), jamais la clé, et
+ *   seulement s'il n'existe pas ou s'il a été écrit par l'app (première ligne [MARQUE]) : une configuration faite à la main
+ *   dans Hermes est gardée telle quelle ; le modèle est alors passé à chaque tâche (`POST /v1/runs`).
+ */
+object HermesFournisseur {
+    const val MARQUE = "# nanoMuse Hermes"
+    const val CUSTOM = "custom"
+    const val VAR_CUSTOM = "AUXILIARY_NANOHERMES_API_KEY"
+
+    /** [id] = identifiant du fournisseur dans Hermes ; [variable] = nom de la variable de sa clé. */
+    data class Fournisseur(val id: String, val nom: String, val variable: String)
+
+    val LISTE: List<Fournisseur> = listOf(
+        Fournisseur("openrouter", "OpenRouter", "OPENROUTER_API_KEY"),
+        Fournisseur("openai-api", "OpenAI", "OPENAI_API_KEY"),
+        Fournisseur("anthropic", "Anthropic", "ANTHROPIC_API_KEY"),
+        Fournisseur("gemini", "Google Gemini", "GOOGLE_API_KEY"),
+        Fournisseur("deepseek", "DeepSeek", "DEEPSEEK_API_KEY"),
+        Fournisseur("xai", "xAI", "XAI_API_KEY"),
+        Fournisseur("nvidia", "NVIDIA", "NVIDIA_API_KEY"),
+        Fournisseur(CUSTOM, "OpenAI-compatible", VAR_CUSTOM),
+    )
+
+    data class Reglage(val fournisseur: String, val modele: String, val baseUrl: String? = null)
+
+    fun fournisseur(id: String): Fournisseur? = LISTE.firstOrNull { it.id == id }
+
+    private val MODELE = Regex("^[A-Za-z0-9._:/@+-]{1,200}$")
+
+    /** Le réglage est-il utilisable ? (fournisseur connu, modèle sans espace, adresse https:// pour « custom »). */
+    fun valide(r: Reglage): Boolean {
+        if (fournisseur(r.fournisseur) == null || !MODELE.matches(r.modele.trim())) return false
+        if (r.fournisseur == CUSTOM) {
+            val u = r.baseUrl?.trim().orEmpty()
+            if (!(u.startsWith("https://") || u.startsWith("http://127.0.0.1") || u.startsWith("http://localhost")) || u.contains(' ') || u.length < 12) return false
+        }
+        return true
+    }
+
+    /** Clé plausible (pas vide, pas d'espace, pas d'octet nul, longueur raisonnable). */
+    fun cleValide(cle: String?): Boolean {
+        val k = cle?.trim() ?: return false
+        return k.length in 8..512 && k.none { it.isWhitespace() || it == '\u0000' }
+    }
+
+    /** Nom → clé, pour l'environnement du processus Hermes (vide si le réglage ou la clé n'est pas utilisable). */
+    fun environnement(r: Reglage?, cle: String?): Map<String, String> {
+        if (r == null || !valide(r) || !cleValide(cle)) return emptyMap()
+        return mapOf(fournisseur(r.fournisseur)!!.variable to cle!!.trim())
+    }
+
+    /** Texte de `config.yaml` (section model seulement, aucune clé). */
+    fun configYaml(r: Reglage): String {
+        require(valide(r)) { "réglage invalide" }
+        val m = LinkedHashMap<String, Any?>()
+        m["provider"] = r.fournisseur
+        m["default"] = r.modele.trim()
+        if (r.fournisseur == CUSTOM) { m["base_url"] = r.baseUrl!!.trim().trimEnd('/'); m["key_env"] = VAR_CUSTOM }
+        return "$MARQUE : section model écrite par l'app (aucune clé ici). Retirez cette ligne pour gérer ce fichier vous-même.\n" +
+            HermesYaml.ecrire(linkedMapOf("model" to m))
+    }
+
+    /** Peut-on (ré)écrire config.yaml ? Oui s'il n'existe pas, ou s'il vient de l'app. */
+    fun peutEcrireConfig(existant: String?): Boolean = existant == null || existant.startsWith(MARQUE)
+
+    /** (modèle, fournisseur) pour `POST /v1/runs` ; pour « custom », le fournisseur vient de config.yaml. */
+    fun pourRun(r: Reglage?): Pair<String?, String?> {
+        if (r == null || !valide(r)) return null to null
+        return r.modele.trim() to r.fournisseur.takeIf { it != CUSTOM }
+    }
+}
