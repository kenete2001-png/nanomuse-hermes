@@ -0,0 +1,84 @@
+package io.github.kenete.nanohermes.hermes
+
+import android.content.Context
+import android.net.Uri
+import com.openminis.app.R
+import com.openminis.app.sandbox.PRootKernel
+import com.openminis.app.sandbox.RootfsManager
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.withContext
+import okhttp3.OkHttpClient
+import okhttp3.Request
+import java.io.File
+import java.util.concurrent.TimeUnit
+
+/**
+ * nanoMuse Hermes : installation du pack Hermes (fichier choisi sur le téléphone, ou adresse https://), avec la taille et
+ * l'empreinte SHA-256 figées dans l'app ([HermesPackInstallation]). Hermes est arrêté pendant l'opération.
+ */
+object HermesPackAndroid {
+    fun attendu(c: Context): HermesPackInstallation.Attendu =
+        HermesPackInstallation.lireAttendu(c.assets.open(HermesPackInstallation.ACTIF).use { it.readBytes().toString(Charsets.UTF_8) })
+
+    fun versionInstallee(c: Context): String? = runCatching { HermesPackInstallation.versionInstallee(HermesChemins.rootfs(c)) }.getOrNull()
+
+    private val http by lazy {
+        OkHttpClient.Builder().connectTimeout(30, TimeUnit.SECONDS).readTimeout(120, TimeUnit.SECONDS).followRedirects(true).followSslRedirects(false).build()
+    }
+
+    suspend fun depuisUrl(c: Context, url: String, progres: (Long, Long) -> Unit = { _, _ -> }): String = withContext(Dispatchers.IO) {
+        if (!HermesPackInstallation.urlValide(url)) throw HermesPackInstallation.Refus("L'adresse doit commencer par https://.", HermesPackInstallation.Code.URL)
+        val a = attendu(c)
+        val part = File(c.cacheDir, "hermes-pack.part")
+        try {
+            http.newCall(Request.Builder().url(url.trim()).header("User-Agent", "nanoMuse-Hermes").get().build()).execute().use { r ->
+                if (!r.isSuccessful) throw HermesPackInstallation.Refus("Téléchargement refusé par le serveur (HTTP ${r.code}).", HermesPackInstallation.Code.HTTP, r.code.toString())
+                val corps = r.body ?: throw HermesPackInstallation.Refus("Réponse vide.", HermesPackInstallation.Code.HTTP, "0")
+                corps.byteStream().use { i -> part.outputStream().use { o -> HermesPackInstallation.copierVerifie(i, o, a) { n -> progres(n, a.taille) } } }
+            }
+            installer(c, part, a)
+        } finally { part.delete() }
+    }
+
+    suspend fun depuisFichier(c: Context, uri: Uri, progres: (Long, Long) -> Unit = { _, _ -> }): String = withContext(Dispatchers.IO) {
+        val a = attendu(c)
+        val part = File(c.cacheDir, "hermes-pack.part")
+        try {
+            (c.contentResolver.openInputStream(uri) ?: throw HermesPackInstallation.Refus("Fichier illisible.", HermesPackInstallation.Code.FICHIER)).use { i ->
+                part.outputStream().use { o -> HermesPackInstallation.copierVerifie(i, o, a) { n -> progres(n, a.taille) } }
+            }
+            installer(c, part, a)
+        } finally { part.delete() }
+    }
+
+    private suspend fun installer(c: Context, part: File, a: HermesPackInstallation.Attendu): String {
+        runCatching { HermesPont.arreter() }
+        if (!PRootKernel.isBooted) runCatching { PRootKernel.boot(c.applicationContext) }
+        val rf = RootfsManager.getInstance(c.applicationContext)
+        HermesPackInstallation.installer(part, HermesChemins.rootfs(c), a, { i, d -> rf.extractTar(i, d) })
+        runCatching { rf.refreshDns() } // resolv.conf du Linux de Hermes
+        return c.getString(R.string.nh_pack_installe, a.version)
+    }
+
+    suspend fun desinstaller(c: Context) = withContext(Dispatchers.IO) {
+        runCatching { HermesPont.arreter() }
+        HermesPackInstallation.desinstaller(HermesChemins.rootfs(c))
+    }
+
+    /** Phrase traduite d'un refus. */
+    fun phraseRefus(c: Context, e: Throwable): String {
+        val r = e as? HermesPackInstallation.Refus ?: return c.getString(R.string.nh_refus_extraction, e.javaClass.simpleName)
+        return when (r.code) {
+            HermesPackInstallation.Code.TAILLE_TROP_GRANDE -> c.getString(R.string.nh_refus_taille)
+            HermesPackInstallation.Code.INCOMPLET -> c.getString(R.string.nh_refus_incomplet, r.detail)
+            HermesPackInstallation.Code.EMPREINTE -> c.getString(R.string.nh_refus_empreinte)
+            HermesPackInstallation.Code.PLACE -> c.getString(R.string.nh_refus_place, r.detail)
+            HermesPackInstallation.Code.PACK_INCOMPLET -> c.getString(R.string.nh_refus_pack_incomplet)
+            HermesPackInstallation.Code.URL -> c.getString(R.string.nh_refus_url)
+            HermesPackInstallation.Code.HTTP -> c.getString(R.string.nh_refus_http, r.detail)
+            HermesPackInstallation.Code.FICHIER -> c.getString(R.string.nh_refus_fichier)
+            HermesPackInstallation.Code.BASCULE -> c.getString(R.string.nh_refus_bascule)
+            HermesPackInstallation.Code.EXTRACTION -> c.getString(R.string.nh_refus_extraction, r.detail)
+        }
+    }
+}
