--- /dev/null
+++ b/android/src/android/app/src/main/java/io/github/kenete/nanohermes/hermes/HermesTranscripteur.kt
@@ -0,0 +1,216 @@
+package io.github.kenete.nanohermes.hermes
+
+import org.json.JSONObject
+
+/**
+ * Où écrire les étapes : la MÊME table Room `messages` que le moteur natif (ChatRepository).
+ * L'adaptateur Android ([HermesDepotRoom]) délègue à `ChatRepository.appendMessage` / `updateMessageParts` /
+ * `updateMessageErrorInfo` ; en test, un faux dépôt en mémoire.
+ */
+interface HermesDepotMessages {
+    /** Ajoute une ligne ; renvoie son id. `role` = "assistant" ou "user" (résultats d'outils, comme le natif). */
+    suspend fun ajouter(role: String, partsJson: String, tokenJson: String? = null, modele: String? = null): String
+    suspend fun majParts(id: String, partsJson: String)
+    /** Pastille d'erreur de fin de tour (texte simple, comme `updateLastAssistantError`). */
+    suspend fun marquerErreur(id: String, texte: String)
+}
+
+/** Dépôt qui n'écrit nulle part (run sans discussion, ou base pas prête). */
+class HermesDepotVide : HermesDepotMessages {
+    private var n = 0
+    override suspend fun ajouter(role: String, partsJson: String, tokenJson: String?, modele: String?) = "vide-${++n}"
+    override suspend fun majParts(id: String, partsJson: String) {}
+    override suspend fun marquerErreur(id: String, texte: String) {}
+}
+
+/**
+ * duetmuse fusion E3 : transforme les événements d'un run Hermes en lignes de discussion, au format
+ * EXACT du moteur natif (ChatViewModel.buildAssistantPartsJson / persistToolResultMessage), pour que les
+ * écrans, l'export, la recherche, la sauvegarde et la Garde lisent Hermes sans changement :
+ *
+ * - ligne "assistant" : `[{"type":"text","value":…}, {"type":"toolUse","value":{toolUseId,name,input,description,pageURL,imageFilePath,thoughtSignature}}…]`
+ * - ligne "user" qui suit : `[{"type":"toolResult","value":{toolUseId,name,output,success,snapshot:{type:"text",text}}}…]`
+ * - le texte qui arrive après des résultats ouvre une nouvelle ligne "assistant" (comme une nouvelle itération native).
+ *
+ * Les noms d'outils sont ceux de Hermes (`terminal`, `web_search`, `web_extract`, `read_file`…) ; `toolUseId` vaut
+ * `hermes_<runId court>_<n>` car le flux public ne donne pas l'id d'appel ; [completer] remet ensuite les arguments
+ * et les résultats ENTIERS lus dans `GET /api/sessions/{id}/messages` (le flux les tronque à 500 caractères).
+ */
+class HermesTranscripteur(
+    private val depot: HermesDepotMessages,
+    private val prefixeId: String,
+    private val modele: String? = null,
+) {
+    class Outil(var id: String, val nom: String, var entree: String, val description: String) {
+        var resultat: String? = null
+        var succes: Boolean = true
+    }
+
+    private inner class Segment {
+        var idLigneAssistant: String? = null
+        var idLigneResultats: String? = null
+        val texte = StringBuilder()
+        val outils = mutableListOf<Outil>()
+        var assistantSale = false
+        var resultatsSale = false
+        val aDesResultats get() = outils.any { it.resultat != null }
+    }
+
+    private val segments = mutableListOf(Segment())
+    private val courant get() = segments.last()
+    private var compteurOutils = 0
+    /** Ids de toutes les lignes écrites pour ce run, dans l'ordre (contrat pour la Garde / E4). */
+    val lignesEcrites = mutableListOf<String>()
+    /** Vrai dès qu'un outil a commencé : après ça, AUCUN repli natif (risque de refaire une action). */
+    var actionCommencee = false; private set
+    val texteFinal: String get() = courant.texte.toString()
+    fun outils(): List<Outil> = segments.flatMap { it.outils }
+
+    /** Applique un événement à l'état en mémoire. Renvoie vrai s'il faut écrire (les deltas peuvent être groupés). */
+    fun appliquer(ev: HermesEvenement): Boolean = when (ev) {
+        is HermesEvenement.Delta -> { texte(ev.texte); true }
+        is HermesEvenement.Interim -> if (!ev.dejaDiffuse && ev.texte.isNotBlank()) {
+            texte(if (courant.texte.isEmpty() || courant.texte.endsWith("\n")) ev.texte else "\n\n" + ev.texte); true
+        } else false
+        is HermesEvenement.OutilDebut -> {
+            actionCommencee = true
+            if (courant.aDesResultats) nouveauSegment()
+            compteurOutils++
+            val nom = ev.outil.ifBlank { "outil" }
+            val o = Outil(ev.appelId ?: "hermes_${prefixeId}_$compteurOutils", nom, ev.apercu, HermesLibelles.titreCarte(nom, ev.apercu))
+            courant.outils.add(o); courant.assistantSale = true; true
+        }
+        is HermesEvenement.OutilFin -> {
+            val o = courant.outils.firstOrNull { it.resultat == null && (ev.appelId != null && it.id == ev.appelId) }
+                ?: courant.outils.firstOrNull { it.resultat == null && it.nom == ev.outil }
+                ?: courant.outils.firstOrNull { it.resultat == null }
+            if (o != null) { o.resultat = ev.apercu; o.succes = !ev.erreur; courant.resultatsSale = true; true } else false
+        }
+        else -> false
+    }
+
+    private fun texte(t: String) {
+        if (t.isEmpty()) return
+        if (courant.aDesResultats) nouveauSegment()
+        courant.texte.append(t); courant.assistantSale = true
+    }
+
+    private fun nouveauSegment() {
+        // un outil commencé sans résultat (refusé par la porte d'accord : Hermes n'émet pas tool.completed)
+        courant.outils.filter { it.resultat == null }.forEach { it.resultat = OUTIL_NON_EXECUTE; it.succes = false; courant.resultatsSale = true }
+        segments.add(Segment())
+    }
+
+    /**
+     * Fin du run. `completed` : le texte du dernier segment devient la réponse finale de Hermes (`output`) si elle
+     * existe (elle fait foi : les deltas peuvent manquer). Les outils restés sans résultat sont marqués non exécutés.
+     */
+    fun terminer(fin: HermesEvenement.Fin) {
+        courant.outils.filter { it.resultat == null }.forEach { it.resultat = OUTIL_NON_EXECUTE; it.succes = false; courant.resultatsSale = true }
+        val sortie = fin.sortie?.trim().orEmpty()
+        if (fin.reussi && sortie.isNotEmpty()) {
+            if (courant.aDesResultats || courant.outils.isNotEmpty()) segments.add(Segment())
+            if (courant.texte.toString().trim() != sortie) {
+                courant.texte.setLength(0); courant.texte.append(sortie); courant.assistantSale = true
+            }
+        }
+    }
+
+    /**
+     * Remet les arguments et résultats complets de ce run, lus dans l'historique Hermes. On aligne par POSITION
+     * les appels d'outils du dernier tour Hermes (après le dernier message "user") sur nos outils, en vérifiant le nom.
+     * Renvoie le nombre d'outils complétés.
+     */
+    fun completer(messages: List<HermesMessage>, maxCaracteres: Int = MAX_RESULTAT): Int {
+        val debut = messages.indexOfLast { it.role == "user" }
+        val tour = if (debut >= 0) messages.subList(debut + 1, messages.size) else messages
+        val appels = tour.flatMap { it.appelsOutils }
+        val resultats = tour.filter { it.role == "tool" }.associateBy { it.appelOutilId }
+        val nos = outils()
+        var n = 0
+        for ((i, o) in nos.withIndex()) {
+            val a = appels.getOrNull(i) ?: break
+            if (a.nom != o.nom) continue
+            if (a.arguments.isNotBlank()) o.entree = a.arguments
+            resultats[a.id]?.let { r ->
+                o.resultat = r.contenu.let { if (it.length > maxCaracteres) it.take(maxCaracteres) + "\n[… tronqué]" else it }
+                o.succes = o.succes && !pareilErreur(r.contenu)
+                n++
+            }
+            segments.forEach { s -> if (o in s.outils) { s.assistantSale = true; s.resultatsSale = true } }
+        }
+        return n
+    }
+
+    private fun pareilErreur(c: String): Boolean =
+        runCatching { val j = JSONObject(c); j.has("error") && !j.isNull("error") && j.optString("error").isNotBlank() }.getOrDefault(false)
+
+    /** Écrit dans le dépôt toutes les lignes modifiées depuis la dernière écriture. */
+    suspend fun ecrire(tokenJson: String? = null) {
+        for (s in segments) {
+            if (s.assistantSale && (s.texte.isNotEmpty() || s.outils.isNotEmpty())) {
+                val parts = partsAssistant(s)
+                val id = s.idLigneAssistant
+                if (id == null) {
+                    val tok = if (s === courant && s.outils.isEmpty()) tokenJson else null
+                    s.idLigneAssistant = depot.ajouter("assistant", parts, tok, modele).also { lignesEcrites.add(it) }
+                } else depot.majParts(id, parts)
+                s.assistantSale = false
+            }
+            if (s.resultatsSale && s.aDesResultats && s.idLigneAssistant != null) {
+                val parts = partsResultats(s)
+                val id = s.idLigneResultats
+                if (id == null) s.idLigneResultats = depot.ajouter("user", parts).also { lignesEcrites.add(it) }
+                else depot.majParts(id, parts)
+                s.resultatsSale = false
+            }
+        }
+    }
+
+    /** Pose la pastille d'erreur sur la dernière ligne assistant de ce run (en crée une vide au besoin). */
+    suspend fun erreur(texte: String) {
+        val s = segments.lastOrNull { it.idLigneAssistant != null }
+        val id = s?.idLigneAssistant ?: depot.ajouter("assistant", "[]", null, modele).also { lignesEcrites.add(it); courant.idLigneAssistant = it }
+        depot.marquerErreur(id, texte)
+    }
+
+    /** Ligne assistant de fin (texte seul) — pour une question de Hermes ou un message Muse. */
+    fun ajouterTexte(t: String) = texte(t)
+
+    companion object {
+        val OUTIL_NON_EXECUTE: String get() = HermesTextes.outilNonExecute
+        const val MAX_RESULTAT = 200_000
+
+        fun partsAssistant(texte: String, outils: List<Outil>): String = buildString {
+            append('[')
+            var premier = true
+            if (texte.isNotEmpty()) { append("""{"type":"text","value":${q(texte)}}"""); premier = false }
+            for (o in outils) {
+                if (!premier) append(',') else premier = false
+                append("""{"type":"toolUse","value":{"toolUseId":${q(o.id)},"name":${q(o.nom)},"input":${q(o.entree)},"description":${q(o.description)},"pageURL":"","imageFilePath":"","thoughtSignature":null}}""")
+            }
+            append(']')
+        }
+
+        fun partsResultats(outils: List<Outil>): String = buildString {
+            append('[')
+            outils.filter { it.resultat != null }.forEachIndexed { i, o ->
+                if (i > 0) append(',')
+                val r = o.resultat!!
+                append("""{"type":"toolResult","value":{"toolUseId":${q(o.id)},"name":${q(o.nom)},"output":${q(r)},"success":${o.succes},"snapshot":{"type":"text","text":${q(r.lines().takeLast(30).joinToString("\n"))}}}}""")
+            }
+            append(']')
+        }
+
+        /** Jetons au format de la colonne `token_usage` du natif. */
+        fun tokenJson(u: HermesUsage?): String? = u?.let {
+            """{"inputTokens":${it.entree},"outputTokens":${it.sortie},"cacheCreationTokens":0,"cacheReadTokens":0,"latestContextTokens":0}"""
+        }
+
+        /** Échappement JSON (même règle que ChatViewModel.escapeJson : JSONObject.quote). */
+        fun q(s: String): String = JSONObject.quote(s)
+    }
+
+    private fun partsAssistant(s: Segment) = partsAssistant(s.texte.toString(), s.outils)
+    private fun partsResultats(s: Segment) = partsResultats(s.outils)
+}
diff --git a/android/src/android/app/src/main/java/io/github/kenete/nanohermes/hermes/HermesVueDirecte.kt b/android/src/android/app/src/main/java/io/github/kenete/nanohermes/hermes/HermesVueDirecte.kt
new file mode 100644
index 00000000..134df114
--- /dev/null
+++ b/android/src/android/app/src/main/java/io/github/kenete/nanohermes/hermes/HermesVueDirecte.kt
@@ -0,0 +1,126 @@
+package io.github.kenete.nanohermes.hermes
+
+/**
+ * duetmuse fusion E3 : ce que la bulle « en cours » montre pendant un run Hermes, dans l'ordre où ça arrive, avec les
+ * composants de Muse 1.1.10.3 (le pont la convertit en `AssistantBlock` pour `updateAssistantMessage`) :
+ * - texte (`text`) ;
+ * - carte d'outil en direct (`tool_use`, RUNNING → SUCCESS / FAILED / CANCELLED), titre français + aperçu Hermes, durée ;
+ * - réflexion (`thinking`, repliée par Muse selon le niveau de réflexion) — repris de `reasoning.available` de Hermes ;
+ * - progression des sous-agents (`tool_use` « Sous-agent · but », résumé à la fin) — repris de `subagent.start/complete` ;
+ * - ligne d'information (`info`) : « Démarrage du moteur Hermes… » puis le résumé des appels d'outils en fin de tour
+ *   (repris de la ligne récapitulative de la CLI Hermes).
+ * Les lignes Room, elles, sont écrites par [HermesTranscripteur] : la vue directe ne sert qu'à l'affichage live.
+ * Kotlin pur.
+ */
+class HermesVueDirecte(private val horloge: HermesHorloge = HermesHorloge { System.currentTimeMillis() }) {
+    enum class Statut { EN_COURS, OK, ECHEC, REFUSE }
+    enum class Genre { TEXTE, OUTIL, REFLEXION, INFO }
+
+    data class Bloc(
+        val id: String,
+        val genre: Genre,
+        val contenu: String,
+        val nomOutil: String = "",
+        val titre: String = "",
+        val statut: Statut? = null,
+        val debutMs: Long = 0,
+        val dureeMs: Long = 0,
+        /** Id Hermes (sous-agent) pour retrouver la carte à la fin. */
+        val cle: String? = null,
+    ) {
+        val outil get() = genre == Genre.OUTIL
+    }
+
+    private val blocs = mutableListOf<Bloc>()
+    private var n = 0
+    private val debutTour = horloge.ms()
+    var enAttente = true; private set
+
+    fun blocs(): List<Bloc> = blocs.toList()
+    /** Le texte de la bulle (tous les blocs de texte), ce que `ChatMessage.content` reçoit. */
+    fun texte(): String = blocs.filter { it.genre == Genre.TEXTE }.joinToString("\n\n") { it.contenu.trim() }.trim()
+
+    /** Ligne « Démarrage du moteur Hermes… » tant que le gateway n'est pas prêt (première tâche). */
+    fun demarrage() {
+        if (blocs.none { it.id == ID_DEMARRAGE }) blocs.add(Bloc(ID_DEMARRAGE, Genre.INFO, HermesTextes.demarrage))
+    }
+
+    private fun finDemarrage() { blocs.removeAll { it.id == ID_DEMARRAGE } }
+
+    /** Applique un événement ; vrai si l'affichage change. */
+    fun appliquer(ev: HermesEvenement): Boolean {
+        when (ev) {
+            is HermesEvenement.Delta -> { finDemarrage(); ajouterTexte(ev.texte) }
+            is HermesEvenement.Interim -> if (!ev.dejaDiffuse && ev.texte.isNotBlank()) { finDemarrage(); ajouterTexte(ev.texte) } else return false
+            is HermesEvenement.Raisonnement -> {
+                if (ev.texte.isBlank()) return false
+                finDemarrage()
+                val d = blocs.lastOrNull()
+                if (d != null && d.genre == Genre.REFLEXION) blocs[blocs.size - 1] = d.copy(contenu = (d.contenu + "\n" + ev.texte).takeLast(4_000))
+                else blocs.add(Bloc("hb${++n}", Genre.REFLEXION, ev.texte))
+            }
+            is HermesEvenement.OutilDebut -> {
+                finDemarrage(); enAttente = false
+                blocs.add(Bloc("hb${++n}", Genre.OUTIL, "", ev.outil, HermesLibelles.titreCarte(ev.outil, ev.apercu), Statut.EN_COURS, horloge.ms()))
+            }
+            is HermesEvenement.OutilFin -> {
+                val i = blocs.indexOfFirst { it.outil && it.statut == Statut.EN_COURS && it.nomOutil == ev.outil }
+                    .takeIf { it >= 0 } ?: blocs.indexOfFirst { it.outil && it.statut == Statut.EN_COURS && it.nomOutil != HermesLibelles.OUTIL_SOUS_AGENT }
+                if (i < 0) return false
+                val b = blocs[i]
+                blocs[i] = b.copy(contenu = ev.apercu, statut = if (ev.erreur) Statut.ECHEC else Statut.OK,
+                    dureeMs = (ev.duree * 1000).toLong().takeIf { it > 0 } ?: (horloge.ms() - b.debutMs))
+                enAttente = blocs.none { it.outil && it.statut == Statut.EN_COURS }
+            }
+            is HermesEvenement.SousAgent -> {
+                finDemarrage()
+                val cle = ev.id ?: ev.but ?: "?"
+                val i = blocs.indexOfFirst { it.nomOutil == HermesLibelles.OUTIL_SOUS_AGENT && it.cle == cle }
+                if (!ev.fin) {
+                    if (i >= 0) return false
+                    blocs.add(Bloc("hb${++n}", Genre.OUTIL, "", HermesLibelles.OUTIL_SOUS_AGENT,
+                        HermesLibelles.titreCarte(HermesLibelles.OUTIL_SOUS_AGENT, ev.but.orEmpty()), Statut.EN_COURS, horloge.ms(), cle = cle))
+                } else {
+                    val st = when (ev.statut?.lowercase()) { "failed", "error" -> Statut.ECHEC; "cancelled", "interrupted" -> Statut.REFUSE; else -> Statut.OK }
+                    if (i >= 0) {
+                        val b = blocs[i]
+                        blocs[i] = b.copy(contenu = ev.resume.orEmpty(), statut = st, dureeMs = horloge.ms() - b.debutMs)
+                    } else blocs.add(Bloc("hb${++n}", Genre.OUTIL, ev.resume.orEmpty(), HermesLibelles.OUTIL_SOUS_AGENT,
+                        HermesLibelles.titreCarte(HermesLibelles.OUTIL_SOUS_AGENT, ev.but.orEmpty()), st, horloge.ms(), cle = cle))
+                }
+            }
+            is HermesEvenement.Fin -> {
+                finDemarrage()
+                for (i in blocs.indices) if (blocs[i].outil && blocs[i].statut == Statut.EN_COURS)
+                    blocs[i] = blocs[i].copy(statut = Statut.REFUSE, contenu = HermesTranscripteur.OUTIL_NON_EXECUTE)
+                val s = ev.sortie?.trim().orEmpty()
+                if (ev.reussi && s.isNotEmpty()) {
+                    val dernier = blocs.lastOrNull { it.genre != Genre.REFLEXION }
+                    if (dernier != null && dernier.genre == Genre.TEXTE && blocs.last() === dernier) blocs[blocs.size - 1] = dernier.copy(contenu = s)
+                    else blocs.add(Bloc("hb${++n}", Genre.TEXTE, s))
+                }
+                val outils = blocs.filter { it.outil && it.nomOutil != HermesLibelles.OUTIL_SOUS_AGENT }
+                HermesLibelles.resume(
+                    outils.count { it.statut == Statut.OK }, outils.count { it.statut == Statut.ECHEC }, outils.count { it.statut == Statut.REFUSE },
+                    blocs.count { it.nomOutil == HermesLibelles.OUTIL_SOUS_AGENT }, horloge.ms() - debutTour,
+                )?.let { blocs.add(Bloc(ID_RESUME, Genre.INFO, it)) }
+                enAttente = false
+            }
+            else -> return false
+        }
+        return true
+    }
+
+    private fun ajouterTexte(t: String) {
+        if (t.isEmpty()) return
+        enAttente = false
+        val d = blocs.lastOrNull()
+        if (d != null && d.genre == Genre.TEXTE) blocs[blocs.size - 1] = d.copy(contenu = d.contenu + t)
+        else blocs.add(Bloc("hb${++n}", Genre.TEXTE, t))
+    }
+
+    companion object {
+        const val ID_DEMARRAGE = "hb-demarrage"
+        const val ID_RESUME = "hb-resume"
+    }
+}
diff --git a/android/src/android/app/src/main/java/io/github/kenete/nanohermes/hermes/HermesYaml.kt b/android/src/android/app/src/main/java/io/github/kenete/nanohermes/hermes/HermesYaml.kt
