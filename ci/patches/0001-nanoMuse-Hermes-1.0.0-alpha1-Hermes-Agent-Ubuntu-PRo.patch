+++ b/android/src/android/app/src/main/java/io/github/kenete/nanohermes/hermes/MiseAJour.kt
@@ -0,0 +1,240 @@
+package io.github.kenete.nanohermes.hermes
+
+import org.json.JSONObject
+import java.io.File
+import java.io.InputStream
+import java.security.MessageDigest
+
+/**
+ * nanoMuse Hermes : logique des deux mises à jour (Kotlin pur, testé sur la JVM).
+ *
+ * 1. « Mettre à jour l'app » : dernière publication de github.com/kenete2001-png/nanomuse-hermes. Tag `vX.Y.Z-nhN` ; le
+ *    versionCode est la ligne `versionCode: N` du texte de la publication (à défaut, le N de `-nhN`). Une publication n'est
+ *    proposée que si son versionCode dépasse celui installé ET si elle porte l'APK et son `.sha256` (jamais d'APK sans
+ *    empreinte vérifiée). Même clé de signature = mise à jour en place : les données (filesDir, Ubuntu de Hermes) restent.
+ *
+ * 2. « Mettre à jour Hermes » : dernière publication officielle de github.com/NousResearch/hermes-agent. Le pack installe
+ *    Hermes en mode « editable » (venv `/opt/hermes/venv` → sources `/opt/hermes/src`, sans dépôt git ni git dans l'Ubuntu) :
+ *    la mise à jour remplace donc les sources par l'archive officielle du tag, puis `pip install -e` dans le venv. Avant :
+ *    copie du venv et des sources ; en cas d'échec, retour exact à l'état précédent. Jamais touchés : `/root/.hermes`
+ *    (mémoire, réglages de Hermes), les paquets apt, le reste de l'Ubuntu.
+ */
+object MiseAJour {
+    const val DEPOT_APP = "kenete2001-png/nanomuse-hermes"
+    const val URL_APP = "https://api.github.com/repos/$DEPOT_APP/releases/latest"
+    const val PAGE_APP = "https://github.com/$DEPOT_APP/releases"
+    const val DEPOT_HERMES = "NousResearch/hermes-agent"
+    const val URL_HERMES = "https://api.github.com/repos/$DEPOT_HERMES/releases/latest"
+    /** Fichier (dans l'Ubuntu) qui garde le tag de Hermes installé par une mise à jour. */
+    const val MARQUE_TAG = "opt/hermes/.nanohermes-tag"
+    /** Une vérification automatique au plus par jour. */
+    const val INTERVALLE_MS = 24L * 60 * 60 * 1000
+
+    data class Fichier(val nom: String, val url: String, val taille: Long)
+    data class Publication(val tag: String, val nom: String, val corps: String, val fichiers: List<Fichier>, val brouillon: Boolean, val preversion: Boolean)
+
+    fun lirePublication(json: String): Publication {
+        val o = JSONObject(json)
+        val a = o.optJSONArray("assets")
+        val fichiers = (0 until (a?.length() ?: 0)).mapNotNull { i ->
+            val f = a!!.optJSONObject(i) ?: return@mapNotNull null
+            val u = f.optString("browser_download_url").trim()
+            if (f.optString("name").isBlank() || !u.startsWith("https://")) null else Fichier(f.optString("name").trim(), u, f.optLong("size", -1))
+        }
+        val tag = o.optString("tag_name").trim()
+        require(tag.isNotEmpty()) { "publication sans tag" }
+        return Publication(tag, o.optString("name").ifBlank { tag }, if (o.isNull("body")) "" else o.optString("body"), fichiers,
+            o.optBoolean("draft", false), o.optBoolean("prerelease", false))
+    }
+
+    // ---------- application ----------
+
+    val TAG_APP = Regex("^v(\\d+)\\.(\\d+)\\.(\\d+)-nh(\\d+)$")
+    private val LIGNE_VC = Regex("(?im)^[\\s>*_`-]*versionCode\\s*[:=]\\s*`?(\\d{1,9})`?\\s*$")
+
+    /** versionCode d'une publication : ligne `versionCode: N` du texte, sinon N de `vX.Y.Z-nhN` ; null si aucun. */
+    fun versionCode(p: Publication): Int? =
+        LIGNE_VC.find(p.corps)?.groupValues?.get(1)?.toIntOrNull() ?: TAG_APP.matchEntire(p.tag)?.groupValues?.get(4)?.toIntOrNull()
+
+    sealed class Verdict {
+        data object AJour : Verdict()
+        /** Publication inutilisable ([raison] : tag, versionCode, apk, sha256, brouillon). */
+        data class Inutilisable(val raison: String) : Verdict()
+        data class Nouvelle(val tag: String, val versionCode: Int, val apk: Fichier, val sha256: Fichier, val notes: String) : Verdict()
+    }
+
+    fun verdictApp(p: Publication, versionCodeInstalle: Int): Verdict {
+        if (p.brouillon) return Verdict.Inutilisable("brouillon")
+        if (!TAG_APP.matches(p.tag)) return Verdict.Inutilisable("tag")
+        val vc = versionCode(p) ?: return Verdict.Inutilisable("versionCode")
+        if (vc <= versionCodeInstalle) return Verdict.AJour
+        val apk = p.fichiers.filter { it.nom.endsWith(".apk", ignoreCase = true) }.let { l -> l.singleOrNull() ?: l.firstOrNull { it.nom.contains("Hermes", true) } }
+            ?: return Verdict.Inutilisable("apk")
+        val sha = p.fichiers.firstOrNull { it.nom.equals(apk.nom + ".sha256", ignoreCase = true) }
+            ?: p.fichiers.filter { it.nom.endsWith(".sha256", ignoreCase = true) }.singleOrNull()
+            ?: return Verdict.Inutilisable("sha256")
+        return Verdict.Nouvelle(p.tag, vc, apk, sha, p.corps)
+    }
+
+    /** Vérifier de nouveau ? (au plus une fois par [INTERVALLE_MS] ; une horloge revenue en arrière relance aussi). */
+    fun aVerifier(derniere: Long, maintenant: Long): Boolean = derniere <= 0 || maintenant - derniere >= INTERVALLE_MS || maintenant < derniere
+
+    // ---------- empreintes ----------
+
+    private val HEX64 = Regex("^[0-9a-fA-F]{64}$")
+
+    /**
+     * Empreinte attendue lue dans un fichier `.sha256` : format `sha256sum` (`<hex>  <nom>` ou `<hex> *<nom>`) ou l'empreinte
+     * seule. Si plusieurs lignes, celle du fichier [nom] ; null si rien d'exploitable.
+     */
+    fun lireSha256(texte: String, nom: String?): String? {
+        val lignes = texte.lines().map { it.trim() }.filter { it.isNotEmpty() && !it.startsWith("#") }
+        val paires = lignes.mapNotNull { l ->
+            val h = l.substringBefore(' ').substringBefore('\t')
+            if (!HEX64.matches(h)) null else h.lowercase() to l.substring(h.length).trim().removePrefix("*").trim()
+        }
+        if (paires.isEmpty()) return null
+        if (nom != null) paires.firstOrNull { it.second == nom || it.second.substringAfterLast('/') == nom }?.let { return it.first }
+        return paires.singleOrNull()?.first
+    }
+
+    fun sha256(i: InputStream): String {
+        val md = MessageDigest.getInstance("SHA-256")
+        val buf = ByteArray(64 * 1024)
+        while (true) { val r = i.read(buf); if (r < 0) break; md.update(buf, 0, r) }
+        return md.digest().joinToString("") { "%02x".format(it) }
+    }
+
+    fun sha256(f: File): String = f.inputStream().use { sha256(it) }
+
+    /** Le fichier a-t-il exactement l'empreinte [attendue] (casse indifférente) ? Une empreinte mal formée = refus. */
+    fun verifier(f: File, attendue: String?): Boolean =
+        attendue != null && HEX64.matches(attendue.trim()) && f.isFile && sha256(f).equals(attendue.trim(), ignoreCase = true)
+
+    // ---------- Hermes ----------
+
+    /** Tags acceptés dans un script shell ou une adresse : caractères sûrs seulement. */
+    private val TAG_SUR = Regex("^v?[0-9A-Za-z][0-9A-Za-z._+-]{0,63}$")
+    fun tagValide(tag: String?): Boolean = tag != null && TAG_SUR.matches(tag)
+
+    /** Archive officielle des sources d'un tag (GitHub). */
+    fun urlSourcesHermes(tag: String): String {
+        require(tagValide(tag)) { "tag invalide" }
+        return "https://codeload.github.com/$DEPOT_HERMES/tar.gz/refs/tags/" + tag.replace("+", "%2B")
+    }
+
+    /** "0.23.0-2bd378e-muse3" (version du pack) → "v0.23.0". */
+    fun tagDepuisVersionPack(v: String?): String? =
+        v?.trim()?.removePrefix("v")?.let { Regex("^(\\d+\\.\\d+\\.\\d+)").find(it)?.groupValues?.get(1) }?.let { "v$it" }
+
+    /**
+     * Comparaison de versions : nombres comparés comme des nombres (« 0.10.0 » > « 0.9.9 »), partie absente = 0 ;
+     * une préversion (`-rc1`) passe avant la version simple ; les métadonnées `+…` passent après.
+     */
+    fun comparer(a: String, b: String): Int {
+        fun decouper(v: String): Triple<List<Int>, String, String> {
+            val s = v.trim().removePrefix("v").removePrefix("V")
+            val meta = s.substringAfter('+', "")
+            val sansMeta = s.substringBefore('+')
+            val coeur = sansMeta.substringBefore('-')
+            val pre = sansMeta.substringAfter('-', "")
+            return Triple(coeur.split('.').map { p -> p.takeWhile(Char::isDigit).toIntOrNull() ?: 0 }, pre, meta)
+        }
+        val (an, ap, am) = decouper(a)
+        val (bn, bp, bm) = decouper(b)
+        for (i in 0 until maxOf(an.size, bn.size)) {
+            val c = (an.getOrNull(i) ?: 0).compareTo(bn.getOrNull(i) ?: 0)
+            if (c != 0) return c
+        }
+        val cp = when {
+            ap == bp -> 0
+            ap.isEmpty() -> 1
+            bp.isEmpty() -> -1
+            else -> comparerEtiquettes(ap, bp)
+        }
+        if (cp != 0) return cp
+        return when {
+            am == bm -> 0
+            am.isEmpty() -> -1
+            bm.isEmpty() -> 1
+            else -> comparerEtiquettes(am, bm)
+        }
+    }
+
+    private fun comparerEtiquettes(a: String, b: String): Int {
+        val x = a.split('.'); val y = b.split('.')
+        for (i in 0 until maxOf(x.size, y.size)) {
+            val p = x.getOrNull(i) ?: return -1
+            val q = y.getOrNull(i) ?: return 1
+            val c = comparerNaturel(p, q)
+            if (c != 0) return c
+        }
+        return 0
+    }
+
+    /** « rc2 » < « rc10 » : suites de chiffres comparées comme des nombres, le reste comme du texte. */
+    private fun comparerNaturel(a: String, b: String): Int {
+        val r = Regex("\\d+|\\D+")
+        val x = r.findAll(a).map { it.value }.toList(); val y = r.findAll(b).map { it.value }.toList()
+        for (i in 0 until maxOf(x.size, y.size)) {
+            val p = x.getOrNull(i) ?: return -1
+            val q = y.getOrNull(i) ?: return 1
+            val pi = p.toBigIntegerOrNull(); val qi = q.toBigIntegerOrNull()
+            val c = if (pi != null && qi != null) pi.compareTo(qi) else p.compareTo(q)
+            if (c != 0) return c
+        }
+        return 0
+    }
+
+    /** Hermes à mettre à jour vers [dernier] ? (tag installé inconnu = oui). */
+    fun hermesAMettreAJour(installe: String?, dernier: String): Boolean = installe == null || comparer(dernier, installe) > 0
+
+    /** Tag de Hermes installé : marque d'une mise à jour, sinon déduit de la version du pack. */
+    fun tagHermesInstalle(rootfs: File, versionPack: String?): String? =
+        File(rootfs, MARQUE_TAG).takeIf { it.isFile }?.readText()?.trim()?.takeIf { tagValide(it) } ?: tagDepuisVersionPack(versionPack)
+
+    const val ARCHIVE_LINUX = "/tmp/nanohermes-hermes-src.tar.gz"
+
+    /**
+     * Script (sh, sous PRoot dans l'Ubuntu de Hermes) : sources du tag mises à la place de `/opt/hermes/src`, venv copié,
+     * `pip install -e` (dépendances comprises), contrôle `hermes --help` ; échec → sources et venv d'avant remis en place.
+     * Sorties lues par [lireSortie] : `NH_ETAPE <étape>`, `NH_OK <tag>`, `NH_RETOUR_OK`, `NH_ECHEC <étape>`.
+     * Ne touche ni `/root/.hermes` ni apt.
+     */
+    fun scriptHermes(tag: String, archive: String = ARCHIVE_LINUX): String {
+        require(tagValide(tag)) { "tag invalide" }
+        require(Regex("^/[A-Za-z0-9._/-]+$").matches(archive)) { "chemin invalide" }
+        return """
+            |unset LD_LIBRARY_PATH LD_PRELOAD ENV BROWSER
+            |export HOME=/root LANG=C.UTF-8 TMPDIR=/tmp PIP_DISABLE_PIP_VERSION_CHECK=1 PIP_NO_INPUT=1 PIP_ROOT_USER_ACTION=ignore
+            |export PATH=/opt/hermes/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
+            |H=/opt/hermes; A='$archive'; T='$tag'
+            |cd "${'$'}H" || { echo "NH_ECHEC dossier"; exit 3; }
+            |rm -rf src.nh-nouveau src.nh-ancien venv.nh-ancien
+            |echo "NH_ETAPE extraction"
+            |mkdir src.nh-nouveau && tar -xzf "${'$'}A" -C src.nh-nouveau --strip-components=1 --no-same-owner || { rm -rf src.nh-nouveau "${'$'}A"; echo "NH_ECHEC extraction"; exit 4; }
+            |[ -f src.nh-nouveau/pyproject.toml ] || { rm -rf src.nh-nouveau "${'$'}A"; echo "NH_ECHEC sources"; exit 4; }
+            |echo "NH_ETAPE sauvegarde"
+            |cp -a venv venv.nh-ancien || { rm -rf src.nh-nouveau venv.nh-ancien "${'$'}A"; echo "NH_ECHEC sauvegarde"; exit 5; }
+            |mv src src.nh-ancien && mv src.nh-nouveau src || { [ -d src ] || mv src.nh-ancien src; rm -rf src.nh-nouveau venv.nh-ancien "${'$'}A"; echo "NH_ECHEC bascule"; exit 5; }
+            |echo "NH_ETAPE pip"
+            |PY="${'$'}(sed -n 's/^home *= *//p' venv/pyvenv.cfg)/python3"
+            |if "${'$'}PY" -m pip --python "${'$'}H/venv/bin/python" install -e "${'$'}H/src[acp,mcp,sms]" && echo "NH_ETAPE controle" && "${'$'}H/venv/bin/hermes" --help >/dev/null 2>&1; then
+            |  rm -rf src.nh-ancien venv.nh-ancien "${'$'}A"; echo "${'$'}T" > .nanohermes-tag; echo "NH_OK ${'$'}T"; exit 0
+            |fi
+            |echo "NH_ETAPE retour"
+            |rm -rf src venv && mv src.nh-ancien src && mv venv.nh-ancien venv && echo "NH_RETOUR_OK"
+            |rm -f "${'$'}A"; echo "NH_ECHEC pip"; exit 6
+            |""".trimMargin()
+    }
+
+    data class Sortie(val ok: Boolean, val tag: String?, val etapeEchec: String?, val retourFait: Boolean, val derniereEtape: String?)
+
+    fun lireSortie(texte: String): Sortie {
+        val l = texte.lines().map { it.trim() }
+        val ok = l.lastOrNull { it.startsWith("NH_OK ") }
+        val echec = l.lastOrNull { it.startsWith("NH_ECHEC") }
+        return Sortie(ok != null && echec == null, ok?.removePrefix("NH_OK ")?.trim(), echec?.removePrefix("NH_ECHEC")?.trim()?.ifEmpty { "?" },
+            l.any { it == "NH_RETOUR_OK" }, l.lastOrNull { it.startsWith("NH_ETAPE ") }?.removePrefix("NH_ETAPE ")?.trim())
+    }
+}
