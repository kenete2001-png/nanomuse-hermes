diff --git a/android/src/android/app/src/test/java/io/github/kenete/nanohermes/hermes/HermesClientE3Test.kt b/android/src/android/app/src/test/java/io/github/kenete/nanohermes/hermes/HermesClientE3Test.kt
new file mode 100644
index 00000000..f2359180
--- /dev/null
+++ b/android/src/android/app/src/test/java/io/github/kenete/nanohermes/hermes/HermesClientE3Test.kt
@@ -0,0 +1,223 @@
+package io.github.kenete.nanohermes.hermes
+
+import io.github.kenete.nanohermes.hermes.HermesFauxE3.ev
+import io.github.kenete.nanohermes.hermes.HermesFauxE3.json
+import io.github.kenete.nanohermes.hermes.HermesFauxE3.erreur
+import io.github.kenete.nanohermes.hermes.HermesFauxE3.reponseSse
+import io.github.kenete.nanohermes.hermes.HermesFauxE3.sse
+import kotlinx.coroutines.runBlocking
+import okhttp3.mockwebserver.MockResponse
+import okhttp3.mockwebserver.MockWebServer
+import okhttp3.mockwebserver.SocketPolicy
+import org.json.JSONObject
+import org.junit.After
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Assert.fail
+import org.junit.Before
+import org.junit.Test
+import java.net.ServerSocket
+
+/** E3 : client HTTP de Hermes contre un faux serveur (format lu dans hermes-agent a4994d4). */
+class HermesClientE3Test {
+    private lateinit var serveur: MockWebServer
+    private val faux = HermesFauxE3.Serveur()
+
+    @Before fun avant() { serveur = MockWebServer(); serveur.dispatcher = faux; serveur.start() }
+    @After fun apres() { runCatching { serveur.shutdown() } }
+
+    @Test fun sante_ok_et_pas_ok() = runBlocking {
+        val c = HermesFauxE3.client(serveur)
+        assertTrue(c.sante())
+        faux.sante = { json(200, """{"status":"starting"}""") }
+        assertFalse(c.sante())
+        faux.sante = { json(503, "{}") }
+        assertFalse(c.sante())
+    }
+
+    @Test fun sante_connexion_refusee_vaut_faux() = runBlocking {
+        val port = ServerSocket(0).use { it.localPort }
+        val c = HermesClient("http://127.0.0.1:$port", { HermesFauxE3.CLE }, delaiConnexionMs = 500)
+        assertFalse(c.sante())
+    }
+
+    @Test fun demarrer_run_envoie_cle_idempotence_et_champs() = runBlocking {
+        val c = HermesFauxE3.client(serveur)
+        val r = c.demarrerRun("Quelle heure est-il à Tokyo ?", "muse-s1", "gemini-2.5-pro", "gemini", "Cite [n].",
+            listOf("user" to "Bonjour", "assistant" to "Bonjour !"), "muse-idem-1")
+        assertEquals("run_abcdef1234", r.runId)
+        assertEquals("started", r.statut)
+        assertFalse(r.rejoue)
+        val req = faux.recues.last { it.requestUrl!!.encodedPath == "/v1/runs" }
+        assertEquals("Bearer ${HermesFauxE3.CLE}", req.getHeader("Authorization"))
+        assertEquals("muse-idem-1", req.getHeader("Idempotency-Key"))
+        val b = JSONObject(req.body.readUtf8())
+        assertEquals("Quelle heure est-il à Tokyo ?", b.getString("input"))
+        assertEquals("muse-s1", b.getString("session_id"))
+        assertEquals("gemini-2.5-pro", b.getString("model"))
+        assertEquals("gemini", b.getString("provider"))
+        assertEquals("Cite [n].", b.getString("instructions"))
+        assertEquals(2, b.getJSONArray("conversation_history").length())
+        assertEquals("assistant", b.getJSONArray("conversation_history").getJSONObject(1).getString("role"))
+    }
+
+    @Test fun demarrer_run_sans_modele_n_envoie_pas_les_champs_vides() = runBlocking {
+        HermesFauxE3.client(serveur).demarrerRun("Traduis « merci » en japonais", "muse-s2")
+        val b = faux.corps("/v1/runs")!!
+        assertFalse(b.has("model")); assertFalse(b.has("provider")); assertFalse(b.has("conversation_history")); assertFalse(b.has("instructions"))
+    }
+
+    @Test fun demarrer_run_rejoue_est_lu() = runBlocking {
+        faux.runs = { json(202, """{"run_id":"run_x","status":"running","replayed":true}""").setHeader("Idempotency-Replayed", "true") }
+        val r = HermesFauxE3.client(serveur).demarrerRun("x", "muse-s")
+        assertTrue(r.rejoue); assertEquals("run_x", r.runId)
+    }
+
+    @Test fun erreurs_http_classees() = runBlocking {
+        val c = HermesFauxE3.client(serveur)
+        faux.runs = { erreur(429, "Too many concurrent runs") }
+        try { c.demarrerRun("x", "s"); fail() } catch (e: HermesErreur.Occupe) { assertTrue(e.message!!.contains("concurrent")) }
+        faux.runs = { erreur(400, "Missing 'input' field") }
+        try { c.demarrerRun("x", "s"); fail() } catch (e: HermesErreur.Http) { assertEquals(400, e.statut); assertEquals("Missing 'input' field", e.message) }
