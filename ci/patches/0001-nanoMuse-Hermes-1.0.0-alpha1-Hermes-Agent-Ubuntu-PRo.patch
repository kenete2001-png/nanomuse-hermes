index 00000000..52ae1579
--- /dev/null
+++ b/android/src/android/app/src/main/java/io/github/kenete/nanohermes/hermes/HermesYaml.kt
@@ -0,0 +1,74 @@
+package io.github.kenete.nanohermes.hermes
+
+/**
+ * duetmuse fusion E4 — a tiny, strict YAML writer for Hermes' `config.yaml` (pure, no dependency).
+ * Maps keep their insertion order; every string is double-quoted (escapes per YAML 1.2), so a model id such as
+ * « qwen/qwen3.8-max:free » or a value starting with « * » or « @ » is never read as something else.
+ * Empty maps / lists are written in flow style (`{}` / `[]`).
+ */
+object HermesYaml {
+    private val CLE_SIMPLE = Regex("^[A-Za-z_][A-Za-z0-9_.-]*$")
+
+    fun ecrire(racine: Map<String, Any?>): String = StringBuilder().also { sb -> carte(sb, racine, 0) }.toString()
+
+    /** Pure: a YAML double-quoted scalar. */
+    fun chaine(s: String): String {
+        val sb = StringBuilder("\"")
+        for (ch in s) {
+            when {
+                ch == '\\' -> sb.append("\\\\")
+                ch == '"' -> sb.append("\\\"")
+                ch == '\n' -> sb.append("\\n")
+                ch == '\t' -> sb.append("\\t")
+                ch == '\r' -> sb.append("\\r")
+                ch.code < 0x20 || ch.code == 0x7F || ch == '\u0085' || ch == '\u2028' || ch == '\u2029' ->
+                    sb.append("\\u").append(ch.code.toString(16).padStart(4, '0'))
+                else -> sb.append(ch)
+            }
+        }
+        return sb.append('"').toString()
+    }
+
+    private fun cle(k: String) = if (CLE_SIMPLE.matches(k)) k else chaine(k)
+
+    private fun scalaire(v: Any?): String = when (v) {
+        null -> "null"
+        is Boolean -> if (v) "true" else "false"
+        is Int, is Long -> v.toString()
+        is Double -> if (v.isFinite()) v.toString() else error("nombre non fini")
+        is String -> chaine(v)
+        else -> error("type non pris en charge : ${v.javaClass.simpleName}")
+    }
+
+    private fun vide(v: Any?) = (v is Map<*, *> && v.isEmpty()) || (v is List<*> && v.isEmpty())
+
+    private fun carte(sb: StringBuilder, m: Map<*, *>, n: Int) {
+        val ind = "  ".repeat(n)
+        for ((k, v) in m) {
+            val c = cle(k as String)
+            when {
+                v is Map<*, *> && v.isNotEmpty() -> { sb.append(ind).append(c).append(":\n"); carte(sb, v, n + 1) }
+                v is List<*> && v.isNotEmpty() -> { sb.append(ind).append(c).append(":\n"); liste(sb, v, n + 1) }
+                vide(v) -> sb.append(ind).append(c).append(": ").append(if (v is Map<*, *>) "{}" else "[]").append('\n')
+                else -> sb.append(ind).append(c).append(": ").append(scalaire(v)).append('\n')
+            }
+        }
+    }
+
+    private fun liste(sb: StringBuilder, l: List<*>, n: Int) {
+        val ind = "  ".repeat(n)
+        for (v in l) {
+            when {
+                v is Map<*, *> && v.isNotEmpty() -> {
+                    // « - k: v » then the other keys aligned under the first one
+                    val sous = StringBuilder().also { carte(it, v, n + 1) }.toString().lines().filter { it.isNotEmpty() }
+                    sb.append(ind).append("- ").append(sous.first().removePrefix("  ".repeat(n + 1))).append('\n')
+                    sous.drop(1).forEach { sb.append(it).append('\n') }
+                }
+                v is List<*> && v.isNotEmpty() -> error("listes imbriquées non prises en charge")
+                vide(v) -> sb.append(ind).append("- ").append(if (v is Map<*, *>) "{}" else "[]").append('\n')
+                else -> sb.append(ind).append("- ").append(scalaire(v)).append('\n')
+            }
+        }
+    }
+}
diff --git a/android/src/android/app/src/main/java/io/github/kenete/nanohermes/hermes/MiseAJour.kt b/android/src/android/app/src/main/java/io/github/kenete/nanohermes/hermes/MiseAJour.kt
