+import com.openminis.app.sandbox.PRootKernel
+import com.openminis.app.sandbox.RootfsManager
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.withContext
+import okhttp3.OkHttpClient
+import okhttp3.Request
+import java.io.File
+import java.util.concurrent.TimeUnit
+
+/** nanoMuse Hermes : mises à jour de l'app (APK GitHub, PackageInstaller) et de Hermes Agent (dans l'Ubuntu existant). */
+object MiseAJourAndroid {
+    private const val PREFS = "nanohermes_maj"
+    private fun p(c: Context) = c.applicationContext.getSharedPreferences(PREFS, Context.MODE_PRIVATE)
+
+    /** Nouvelle version de l'app trouvée par la vérification du jour (bannière), ou null. */
+    val disponible = MutableStateFlow<MiseAJour.Verdict.Nouvelle?>(null)
+    /** Message du programme d'installation Android (reçu par [MiseAJourRecepteur]). */
+    val messageInstallation = MutableStateFlow<String?>(null)
+
+    private val http by lazy {
+        OkHttpClient.Builder().connectTimeout(20, TimeUnit.SECONDS).readTimeout(120, TimeUnit.SECONDS).followRedirects(true).followSslRedirects(false).build()
+    }
+
+    private fun get(url: String): String {
+        val req = Request.Builder().url(url).header("Accept", "application/vnd.github+json").header("User-Agent", "nanoMuse-Hermes/${BuildConfig.VERSION_NAME}").get().build()
+        http.newCall(req).execute().use { r ->
+            if (r.code == 404) throw ErreurMaj("aucune publication", "404")
+            if (!r.isSuccessful) throw ErreurMaj("HTTP ${r.code}", r.code.toString())
+            return r.body?.string() ?: throw ErreurMaj("réponse vide", "0")
+        }
+    }
+
+    private fun telecharger(url: String, vers: File, progres: (Long, Long) -> Unit) {
+        vers.parentFile?.mkdirs()
+        val req = Request.Builder().url(url).header("User-Agent", "nanoMuse-Hermes/${BuildConfig.VERSION_NAME}").get().build()
+        http.newCall(req).execute().use { r ->
+            if (!r.isSuccessful) throw ErreurMaj("HTTP ${r.code}", r.code.toString())
+            val corps = r.body ?: throw ErreurMaj("réponse vide", "0")
+            val total = corps.contentLength()
+            corps.byteStream().use { i ->
+                vers.outputStream().use { o ->
+                    val buf = ByteArray(64 * 1024); var n = 0L
+                    while (true) { val k = i.read(buf); if (k < 0) break; o.write(buf, 0, k); n += k; progres(n, total) }
+                }
+            }
+        }
+    }
+
+    class ErreurMaj(message: String, val detail: String = "") : Exception(message)
+
+    // ---------- application ----------
+
+    /** Vérifie la dernière publication de l'app. */
+    suspend fun verifierApp(c: Context): MiseAJour.Verdict = withContext(Dispatchers.IO) {
+        val v = MiseAJour.verdictApp(MiseAJour.lirePublication(get(MiseAJour.URL_APP)), BuildConfig.VERSION_CODE)
+        p(c).edit().putLong("derniere_verif", System.currentTimeMillis()).apply()
+        disponible.value = v as? MiseAJour.Verdict.Nouvelle
+        v
+    }
+
+    /** Vérification au démarrage, au plus une fois par jour, silencieuse (pas de notification ; bannière si nouvelle). */
+    suspend fun verifierSiBesoin(c: Context) {
+        if (!MiseAJour.aVerifier(p(c).getLong("derniere_verif", 0), System.currentTimeMillis())) return
+        runCatching { verifierApp(c) }.onFailure { p(c).edit().putLong("derniere_verif", System.currentTimeMillis()).apply() }
+    }
+
+    fun peutInstaller(c: Context): Boolean = Build.VERSION.SDK_INT < Build.VERSION_CODES.O || c.packageManager.canRequestPackageInstalls()
+
+    fun ouvrirAutorisation(c: Context) {
+        if (Build.VERSION.SDK_INT < Build.VERSION_CODES.O) return
+        c.startActivity(Intent(Settings.ACTION_MANAGE_UNKNOWN_APP_SOURCES, Uri.parse("package:${c.packageName}")).addFlags(Intent.FLAG_ACTIVITY_NEW_TASK))
+    }
+
+    /**
+     * Télécharge l'APK et son `.sha256`, vérifie l'empreinte, puis le confie à PackageInstaller (même clé de signature :
+     * mise à jour en place, données gardées). Renvoie le message à afficher.
+     */
+    suspend fun installerApp(c: Context, n: MiseAJour.Verdict.Nouvelle, progres: (Long, Long) -> Unit): String = withContext(Dispatchers.IO) {
+        val dossier = File(c.cacheDir, "nanohermes-maj").apply { mkdirs() }
+        dossier.listFiles()?.forEach { it.delete() }
+        val apk = File(dossier, "nanohermes-${n.versionCode}.apk")
+        try {
+            val attendue = MiseAJour.lireSha256(get(n.sha256.url), n.apk.nom) ?: return@withContext c.getString(R.string.nh_maj_sha_illisible)
+            telecharger(n.apk.url, apk) { k, t -> progres(k, if (t > 0) t else n.apk.taille) }
+            if (!MiseAJour.verifier(apk, attendue)) return@withContext c.getString(R.string.nh_maj_sha_differente)
+            if (!peutInstaller(c)) { withContext(Dispatchers.Main) { ouvrirAutorisation(c) }; return@withContext c.getString(R.string.nh_maj_autoriser) }
+            val pi = c.packageManager.packageInstaller
+            val params = PackageInstaller.SessionParams(PackageInstaller.SessionParams.MODE_FULL_INSTALL).apply { setAppPackageName(c.packageName) }
+            val id = pi.createSession(params)
+            pi.openSession(id).use { s ->
+                s.openWrite("nanohermes.apk", 0, apk.length()).use { o -> apk.inputStream().use { it.copyTo(o, 64 * 1024) }; s.fsync(o) }
+                val flags = PendingIntent.FLAG_UPDATE_CURRENT or (if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.S) PendingIntent.FLAG_MUTABLE else 0)
+                val pin = PendingIntent.getBroadcast(c, id, Intent(c, MiseAJourRecepteur::class.java).setPackage(c.packageName), flags)
+                s.commit(pin.intentSender)
+            }
+            c.getString(R.string.nh_maj_installation_lancee)
+        } finally { apk.delete() }
+    }
+
+    // ---------- Hermes ----------
+
+    /** Met Hermes Agent à jour vers la dernière publication officielle (rien si déjà à jour). [etape] reçoit l'étape en cours. */
+    suspend fun mettreAJourHermes(c: Context, etape: (String) -> Unit): String = withContext(Dispatchers.IO) {
+        val rootfs = HermesChemins.rootfs(c)
+        if (!HermesPack.present(rootfs)) return@withContext c.getString(R.string.nh_hermes_maj_pas_installe)
+        etape(c.getString(R.string.nh_hermes_maj_etape_verif))
+        val dernier = MiseAJour.lirePublication(get(MiseAJour.URL_HERMES)).tag
+        if (!MiseAJour.tagValide(dernier)) return@withContext c.getString(R.string.nh_hermes_maj_echec, "tag")
+        val installe = MiseAJour.tagHermesInstalle(rootfs, HermesPackAndroid.versionInstallee(c))
+        if (!MiseAJour.hermesAMettreAJour(installe, dernier)) return@withContext c.getString(R.string.nh_hermes_maj_a_jour, installe ?: dernier)
+        runCatching { HermesPont.arreter() }
+        etape(c.getString(R.string.nh_hermes_maj_etape_telechargement, dernier))
+        val archive = File(rootfs, MiseAJour.ARCHIVE_LINUX.removePrefix("/"))
+        try {
+            telecharger(MiseAJour.urlSourcesHermes(dernier), archive) { _, _ -> }
+            if (!PRootKernel.isBooted) PRootKernel.boot(c.applicationContext)
+            runCatching { RootfsManager.getInstance(c.applicationContext).refreshDns() }
+            val sortie = executer(c, rootfs, MiseAJour.scriptHermes(dernier)) { ligne ->
+                if (ligne.startsWith("NH_ETAPE ")) etape(when (ligne.removePrefix("NH_ETAPE ").trim()) {
+                    "extraction" -> c.getString(R.string.nh_hermes_maj_etape_extraction)
+                    "sauvegarde" -> c.getString(R.string.nh_hermes_maj_etape_sauvegarde)
+                    "pip" -> c.getString(R.string.nh_hermes_maj_etape_pip)
+                    "controle" -> c.getString(R.string.nh_hermes_maj_etape_controle)
+                    "retour" -> c.getString(R.string.nh_hermes_maj_etape_retour)
+                    else -> ligne
+                })
+            }
+            val r = MiseAJour.lireSortie(sortie)
+            when {
+                r.ok -> c.getString(R.string.nh_hermes_maj_ok, installe ?: "?", r.tag ?: dernier)
+                r.retourFait -> c.getString(R.string.nh_hermes_maj_retour, r.etapeEchec ?: "?", installe ?: "?")
+                else -> c.getString(R.string.nh_hermes_maj_echec, r.etapeEchec ?: r.derniereEtape ?: "?")
+            }
+        } finally { archive.delete() }
+    }
+
+    /** Lance [script] sous PRoot dans l'Ubuntu de Hermes ; renvoie toute la sortie (copiée aussi dans le journal de Hermes). */
+    private fun executer(c: Context, rootfs: File, script: String, ligne: (String) -> Unit): String {
+        val pb = ProcessBuilder(PRootKernel.buildProotCommand(script, rootfs)).redirectErrorStream(true)
+        val env = pb.environment()
+        env["PROOT_TMP_DIR"] = PRootKernel.getProotTmpDir(c).absolutePath
+        if (PRootKernel.nativeLibDir.isNotEmpty()) env["LD_LIBRARY_PATH"] = PRootKernel.nativeLibDir
+        if (PRootKernel.prootLoaderPath.isNotEmpty()) env["PROOT_LOADER"] = PRootKernel.prootLoaderPath
+        if (PRootKernel.prootLoader32Path.isNotEmpty()) env["PROOT_LOADER_32"] = PRootKernel.prootLoader32Path
+        val proc = pb.start()
+        val tout = StringBuilder()
+        val journal = HermesChemins.journal(c)
+        runCatching { journal.appendText("\n--- nanoMuse Hermes : mise à jour de Hermes ---\n") }
+        proc.inputStream.bufferedReader().useLines { lignes ->
+            lignes.forEach { l ->
+                if (tout.length < 2_000_000) tout.append(l).append('\n')
+                runCatching { journal.appendText(l + "\n") }
+                ligne(l.trim())
+            }
+        }
+        if (!proc.waitFor(30, TimeUnit.MINUTES)) proc.destroyForcibly()
+        return tout.toString()
+    }
+}
+
+/** Réponse de PackageInstaller : confirmation de l'utilisateur à ouvrir, ou résultat. */
+class MiseAJourRecepteur : BroadcastReceiver() {
+    override fun onReceive(context: Context, intent: Intent) {
+        when (val statut = intent.getIntExtra(PackageInstaller.EXTRA_STATUS, -999)) {
+            PackageInstaller.STATUS_PENDING_USER_ACTION -> {
+                @Suppress("DEPRECATION") val confirmer = intent.getParcelableExtra(Intent.EXTRA_INTENT) as? Intent
+                if (confirmer != null) runCatching { context.startActivity(confirmer.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)) }
+                    .onFailure { MiseAJourAndroid.messageInstallation.value = context.getString(R.string.nh_maj_echec_installation, it.javaClass.simpleName) }
+            }
+            PackageInstaller.STATUS_SUCCESS -> MiseAJourAndroid.messageInstallation.value = context.getString(R.string.nh_maj_installee)
+            else -> MiseAJourAndroid.messageInstallation.value = context.getString(R.string.nh_maj_echec_installation,
+                intent.getStringExtra(PackageInstaller.EXTRA_STATUS_MESSAGE) ?: statut.toString())
+        }
+    }
+}
+
+/** Réglages : « Mettre à jour Hermes » et « Mettre à jour l'app ». */
+@Composable
+fun SectionMisesAJour() {
+    val c = LocalContext.current
+    val scope = rememberCoroutineScope()
+    var occupe by remember { mutableStateOf(false) }
+    var etape by remember { mutableStateOf<String?>(null) }
+    var progres by remember { mutableStateOf<Float?>(null) }
+    var message by remember { mutableStateOf<String?>(null) }
+    val nouvelle = MiseAJourAndroid.disponible.collectAsState().value
+    val msgInstall = MiseAJourAndroid.messageInstallation.collectAsState().value
+    val tagHermes = remember(occupe) { MiseAJour.tagHermesInstalle(HermesChemins.rootfs(c), HermesPackAndroid.versionInstallee(c)) }
+
+    fun lancer(bloc: suspend () -> String) {
+        occupe = true; message = null; etape = null; progres = null
+        scope.launch {
+            message = runCatching { bloc() }.getOrElse { e ->
+                val d = (e as? MiseAJourAndroid.ErreurMaj)?.detail?.ifEmpty { null } ?: e.javaClass.simpleName
+                if (d == "404") c.getString(R.string.nh_maj_aucune_publication) else c.getString(R.string.nh_maj_erreur_reseau, d)
+            }
+            occupe = false; etape = null; progres = null
+        }
+    }
+
+    Column(Modifier.fillMaxWidth().padding(horizontal = 16.dp, vertical = 8.dp), verticalArrangement = Arrangement.spacedBy(6.dp)) {
+        Text(stringResource(R.string.nh_maj_titre), style = MaterialTheme.typography.titleMedium)
+        Text(stringResource(R.string.nh_maj_version_app, BuildConfig.VERSION_NAME, BuildConfig.VERSION_CODE), style = MaterialTheme.typography.bodySmall)
+        Text(if (tagHermes != null) stringResource(R.string.nh_maj_version_hermes, tagHermes) else stringResource(R.string.nh_hermes_maj_pas_installe),
+            style = MaterialTheme.typography.bodySmall)
+        Text(stringResource(R.string.nh_maj_donnees_gardees), style = MaterialTheme.typography.bodySmall, color = MaterialTheme.colorScheme.onSurfaceVariant)
+        if (occupe) {
+            etape?.let { Text(it, style = MaterialTheme.typography.bodySmall) }
+            val p = progres
+            if (p != null) LinearProgressIndicator(progress = { p }, modifier = Modifier.fillMaxWidth())
+            else LinearProgressIndicator(modifier = Modifier.fillMaxWidth())
+        } else {
+            Row(horizontalArrangement = Arrangement.spacedBy(8.dp)) {
+                Button(onClick = { lancer { MiseAJourAndroid.mettreAJourHermes(c) { e -> etape = e } } }, enabled = tagHermes != null) {
+                    Text(stringResource(R.string.nh_hermes_maj_bouton))
+                }
+                OutlinedButton(onClick = {
+                    lancer {
+                        etape = c.getString(R.string.nh_maj_verification)
+                        when (val v = nouvelle ?: MiseAJourAndroid.verifierApp(c)) {
+                            is MiseAJour.Verdict.AJour -> c.getString(R.string.nh_maj_a_jour)
+                            is MiseAJour.Verdict.Inutilisable -> c.getString(R.string.nh_maj_inutilisable, v.raison)
+                            is MiseAJour.Verdict.Nouvelle -> {
+                                etape = c.getString(R.string.nh_maj_telechargement, v.tag)
+                                MiseAJourAndroid.installerApp(c, v) { n, t -> progres = if (t > 0) (n.toFloat() / t).coerceIn(0f, 1f) else null }
+                            }
+                        }
+                    }
+                }) { Text(stringResource(R.string.nh_maj_app_bouton)) }
+            }
+        }
+        (message ?: msgInstall)?.let { Text(it, style = MaterialTheme.typography.bodySmall, color = MaterialTheme.colorScheme.primary) }
+    }
+}
+
+/** Bannière (sans notification) : une nouvelle version de l'app est publiée. Vérification au plus une fois par jour. */
+@Composable
+fun BanniereMiseAJour() {
+    val c = LocalContext.current
+    LaunchedEffect(Unit) { MiseAJourAndroid.verifierSiBesoin(c) }
+    val n = MiseAJourAndroid.disponible.collectAsState().value ?: return
+    var masquee by remember(n.tag) { mutableStateOf(false) }
+    if (masquee) return
+    val scope = rememberCoroutineScope()
+    var etat by remember(n.tag) { mutableStateOf<String?>(null) }
+    var occupe by remember(n.tag) { mutableStateOf(false) }
+    Box(Modifier.fillMaxSize().statusBarsPadding().padding(8.dp), contentAlignment = Alignment.TopCenter) {
+        Card(Modifier.fillMaxWidth()) {
+            Column(Modifier.padding(12.dp), verticalArrangement = Arrangement.spacedBy(4.dp)) {
+                Text(stringResource(R.string.nh_maj_banniere, n.tag), style = MaterialTheme.typography.bodyMedium)
+                etat?.let { Text(it, style = MaterialTheme.typography.bodySmall) }
+                if (occupe) LinearProgressIndicator(modifier = Modifier.fillMaxWidth())
+                else Row(horizontalArrangement = Arrangement.spacedBy(8.dp)) {
+                    Button(onClick = {
+                        occupe = true
+                        scope.launch {
+                            etat = runCatching { MiseAJourAndroid.installerApp(c, n) { _, _ -> } }.getOrElse { c.getString(R.string.nh_maj_erreur_reseau, it.javaClass.simpleName) }
+                            occupe = false
+                        }
+                    }) { Text(stringResource(R.string.nh_maj_installer)) }
+                    TextButton(onClick = { masquee = true }) { Text(stringResource(R.string.nh_maj_plus_tard)) }
+                }
+            }
+        }
+    }
+}
