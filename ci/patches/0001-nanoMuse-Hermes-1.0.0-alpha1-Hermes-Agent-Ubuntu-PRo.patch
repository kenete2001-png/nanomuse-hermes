--- /dev/null
+++ b/android/src/android/app/src/main/java/io/github/kenete/nanohermes/hermes/HermesPackInstallation.kt
@@ -0,0 +1,163 @@
+package io.github.kenete.nanohermes.hermes
+
+import org.json.JSONObject
+import java.io.BufferedInputStream
+import java.io.File
+import java.io.InputStream
+import java.io.OutputStream
+import java.nio.file.Files
+import java.nio.file.LinkOption
+import java.nio.file.Path
+import java.security.MessageDigest
+import java.util.zip.GZIPInputStream
+
+/**
+ * nanoMuse Hermes : installation du pack Hermes Agent (Linux Ubuntu 24.04 + /opt/hermes), depuis un fichier choisi sur le
+ * téléphone ou une adresse https://. Kotlin pur (testé sur la JVM) :
+ * - le pack attendu est FIGÉ dans l'application (`assets/nanohermes/hermes/pack.json` : taille + SHA-256) ; toute autre archive
+ *   est refusée, d'où qu'elle vienne (rien n'est installé sans empreinte vérifiée) ;
+ * - copie en flux (174 Mo : jamais en mémoire), arrêt dès que la taille dépasse ;
+ * - 1.2.0 : le pack est un Linux complet (Ubuntu 24.04 + `/opt/hermes`), extrait par l'extracteur du rootfs
+ *   (`RootfsManager.extractTar`, ustar + gzip) dans `filesDir/ubuntu-rootfs.nouveau`, contrôlé, puis renommé en
+ *   `ubuntu-rootfs` ; l'ancienne version reste en place tant que la nouvelle n'est pas complète (retour arrière).
+ */
+object HermesPackInstallation {
+    const val ACTIF = "nanohermes/hermes/pack.json"
+    const val MARQUE = "opt/hermes/.muse-pack"
+    data class Attendu(val version: String, val fichier: String, val taille: Long, val sha256: String, val tailleInstallee: Long, val url: String?)
+
+    /** Raison d'un refus : l'écran la traduit (strings.xml) ; [detail] = nombre ou nom à insérer. Le message reste en français (journal, tests). */
+    enum class Code { TAILLE_TROP_GRANDE, INCOMPLET, EMPREINTE, PLACE, PACK_INCOMPLET, URL, HTTP, FICHIER, BASCULE, EXTRACTION }
+
+    class Refus(message: String, val code: Code = Code.EXTRACTION, val detail: String = "") : Exception(message)
+
+    fun lireAttendu(json: String): Attendu = attenduDe(JSONObject(json))
+
+    private fun attenduDe(o: JSONObject): Attendu {
+        val sha = o.getString("sha256").lowercase()
+        require(Regex("^[0-9a-f]{64}$").matches(sha)) { "empreinte du pack invalide" }
+        return Attendu(o.getString("version"), o.getString("fichier"), o.getLong("taille"), sha, o.optLong("taille_installee", 0),
+            o.optString("url").trim().takeIf { it.isNotEmpty() })
+    }
+
+    /** Seules les adresses https:// sont acceptées (comme les packs). */
+    fun urlValide(u: String?): Boolean = u != null && u.trim().startsWith("https://") && u.trim().length > 10 && !u.contains(' ')
+
+    /** Octets libres du stockage de [f] (dossier le plus proche qui existe : usableSpace vaut 0 pour un chemin absent). */
+    fun espaceDisponible(f: File): Long = generateSequence(f.absoluteFile) { it.parentFile }.firstOrNull { it.exists() }?.usableSpace ?: 0L
+
+    fun hex(b: ByteArray) = b.joinToString("") { "%02x".format(it) }
+
+    /**
+     * Copie [entree] dans [sortie] en calculant le SHA-256 ; [Refus] si la taille dépasse ou diffère, ou si l'empreinte
+     * diffère. [progres] reçoit le nombre d'octets copiés.
+     */
+    fun copierVerifie(entree: InputStream, sortie: OutputStream, a: Attendu, progres: (Long) -> Unit = {}): String {
+        val md = MessageDigest.getInstance("SHA-256")
+        val buf = ByteArray(64 * 1024)
+        var n = 0L
+        while (true) {
+            val r = entree.read(buf)
+            if (r < 0) break
+            n += r
+            if (n > a.taille) throw Refus("Ce fichier n'est pas le pack Hermes attendu (taille trop grande).", Code.TAILLE_TROP_GRANDE)
+            md.update(buf, 0, r); sortie.write(buf, 0, r)
+            progres(n)
+        }
+        if (n != a.taille) throw Refus("Téléchargement incomplet ou mauvais fichier (${n} octets sur ${a.taille}).", Code.INCOMPLET, "$n / ${a.taille}")
+        val h = hex(md.digest())
+        if (h != a.sha256) throw Refus("Empreinte SHA-256 différente : ce n'est pas le pack attendu. Rien n'a été installé.", Code.EMPREINTE)
+        return h
+    }
+
+    /** Empreinte d'un fichier (relue juste avant l'extraction : le fichier a pu changer entre-temps). */
+    fun empreinte(f: File): String = f.inputStream().use { i ->
+        val md = MessageDigest.getInstance("SHA-256"); val buf = ByteArray(64 * 1024)
+        while (true) { val r = i.read(buf); if (r < 0) break; md.update(buf, 0, r) }
+        hex(md.digest())
+    }
+
+    /** Version installée (marque écrite après une installation complète), ou null. */
+    fun versionInstallee(rootfs: File): String? = File(rootfs, MARQUE).takeIf { it.isFile }?.readLines()?.firstOrNull()?.trim()?.takeIf { it.isNotEmpty() }
+
+    /**
+     * 1.2.0 : le pack est un Linux complet (Ubuntu 24.04 + `/opt/hermes`) installé dans [rootfs] (`filesDir/ubuntu-rootfs`).
+     * [archive] (déjà vérifiée par [copierVerifie]) est relue (SHA-256), extraite dans `<rootfs>.nouveau`, contrôlée, puis mise
+     * à la place de l'ancienne par renommage. La mémoire de Hermes (`root/.hermes`) de l'ancienne version
+     * passe dans la nouvelle. [extraire] = `RootfsManager.extractTar` ; [espaceLibre] = octets libres du stockage du rootfs.
+     * Retour arrière complet en cas d'échec : l'ancienne version reste en place, intacte.
+     */
+    fun installer(archive: File, rootfs: File, a: Attendu, extraire: (InputStream, File) -> Unit, espaceLibre: (File) -> Long = ::espaceDisponible) {
+        if (archive.length() != a.taille || empreinte(archive) != a.sha256) throw Refus("Empreinte SHA-256 différente : rien n'a été installé.", Code.EMPREINTE)
+        val besoin = a.tailleInstallee + 64L * 1024 * 1024
+        if (espaceLibre(rootfs) < besoin) throw Refus("Pas assez de place : il faut ${besoin / (1024 * 1024)} Mo libres.", Code.PLACE, "${besoin / (1024 * 1024)}")
+        reprendreApresCoupure(rootfs)
+        val nouveau = voisin(rootfs, ".nouveau")
+        val ancien = voisin(rootfs, ".ancien")
+        supprimer(nouveau)
+        val deplaces = ArrayList<Pair<Path, Path>>() // (de, vers) : défaits dans l'ordre inverse en cas d'échec
+        var bascule = false
+        try {
+            nouveau.mkdirs()
+            GZIPInputStream(BufferedInputStream(archive.inputStream(), 256 * 1024), 64 * 1024).use { extraire(it, nouveau) }
+            if (!HermesPack.present(nouveau)) throw Refus("Pack incomplet après extraction (Hermes ou environnement Python absent).", Code.PACK_INCOMPLET)
+            if (!File(nouveau, "bin/sh").exists() && !File(nouveau, "usr/bin/sh").exists()) throw Refus("Pack incomplet après extraction (Linux sans /bin/sh).", Code.PACK_INCOMPLET)
+            if (rootfs.exists()) {
+                val home = File(rootfs, HOME).toPath()
+                if (Files.isDirectory(home, LinkOption.NOFOLLOW_LINKS)) {
+                    val cible = File(nouveau, HOME).toPath()
+                    supprimer(cible.toFile()); Files.createDirectories(cible.parent)
+                    Files.move(home, cible); deplaces.add(home to cible)
+                }
+            }
+            File(nouveau, MARQUE).writeText(a.version + "\n" + a.sha256 + "\n")
+            supprimer(ancien)
+            if (rootfs.exists() && !rootfs.renameTo(ancien)) throw Refus("Impossible de mettre l'ancienne version de côté.", Code.BASCULE)
+            bascule = true
+            if (!nouveau.renameTo(rootfs)) throw Refus("Impossible de mettre la nouvelle version en place.", Code.BASCULE)
+        } catch (e: Throwable) {
+            if (bascule && !rootfs.exists() && ancien.exists()) ancien.renameTo(rootfs)
+            val base = if (rootfs.exists()) null else ancien.takeIf { it.exists() } // ancienne version toujours de côté
+            for ((de, vers) in deplaces.asReversed()) runCatching {
+                val r = if (base == null) de else base.toPath().resolve(rootfs.toPath().relativize(de).toString())
+                if (!Files.exists(r, LinkOption.NOFOLLOW_LINKS) && Files.exists(vers, LinkOption.NOFOLLOW_LINKS)) { Files.createDirectories(r.parent); Files.move(vers, r) }
+            }
+            supprimer(nouveau)
+            throw if (e is Refus) e else Refus("Extraction impossible (${e.javaClass.simpleName}) : l'ancienne version est gardée.", Code.EXTRACTION, e.javaClass.simpleName)
+        }
+        supprimer(ancien)
+    }
+
+    /** Une installation coupée entre les deux renommages (téléphone éteint) : l'ancienne version revient à sa place. */
+    fun reprendreApresCoupure(rootfs: File) {
+        val ancien = voisin(rootfs, ".ancien")
+        if (!rootfs.exists() && ancien.isDirectory) ancien.renameTo(rootfs)
+    }
+
+    const val HOME = "root/.hermes"
+    private fun voisin(rootfs: File, suffixe: String) = File(rootfs.absoluteFile.parentFile, rootfs.name + suffixe)
+
+    /** Suppression sans jamais suivre un lien symbolique (un rootfs en contient des centaines, certains absolus). */
+    fun supprimer(f: File) {
+        val p = f.toPath()
+        if (!Files.exists(p, LinkOption.NOFOLLOW_LINKS)) return
+        if (!Files.isDirectory(p, LinkOption.NOFOLLOW_LINKS)) { Files.deleteIfExists(p); return }
+        Files.walkFileTree(p, object : java.nio.file.SimpleFileVisitor<Path>() {
+            override fun visitFile(x: Path, at: java.nio.file.attribute.BasicFileAttributes): java.nio.file.FileVisitResult { runCatching { x.toFile().setWritable(true) }; Files.deleteIfExists(x); return java.nio.file.FileVisitResult.CONTINUE }
+            override fun visitFileFailed(x: Path, e: java.io.IOException): java.nio.file.FileVisitResult { Files.deleteIfExists(x); return java.nio.file.FileVisitResult.CONTINUE }
+            override fun preVisitDirectory(d: Path, at: java.nio.file.attribute.BasicFileAttributes): java.nio.file.FileVisitResult { runCatching { d.toFile().setWritable(true) }; return java.nio.file.FileVisitResult.CONTINUE }
+            override fun postVisitDirectory(d: Path, e: java.io.IOException?): java.nio.file.FileVisitResult { Files.deleteIfExists(d); return java.nio.file.FileVisitResult.CONTINUE }
+        })
+    }
+
+    /**
+     * Retire le pack, c.-à-d. tout le Linux de Hermes (le moteur nanoMuse reprend toutes les tâches). La mémoire et les
+     * compétences de Hermes (`root/.hermes`) sont gardées : une réinstallation les retrouve.
+     */
+    fun desinstaller(rootfs: File) {
+        supprimer(voisin(rootfs, ".nouveau")); supprimer(voisin(rootfs, ".ancien"))
+        if (!rootfs.isDirectory) return
+        rootfs.listFiles()?.filter { it.name != "root" }?.forEach { supprimer(it) }
+        File(rootfs, "root").takeIf { Files.isDirectory(it.toPath(), LinkOption.NOFOLLOW_LINKS) }?.listFiles()?.filter { it.name != ".hermes" }?.forEach { supprimer(it) }
+    }
+}
