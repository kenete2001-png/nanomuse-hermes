+package io.github.kenete.nanohermes.hermes
+
+/**
+ * nanoMuse Hermes : titres des cartes d'outils = le nom de l'outil de Hermes tel quel (pas de libellés ajoutés), suivi de
+ * l'aperçu que Hermes donne lui-même (`tool.started.preview`).
+ */
+object HermesLibelles {
+    /** Carte des événements `subagent.*` de Hermes. */
+    const val OUTIL_SOUS_AGENT = "subagent"
+
+    /** « terminal · echo 42 » (aperçu coupé à [max] caractères). */
+    fun titreCarte(outil: String, apercu: String, max: Int = 60): String {
+        val a = apercu.replace(Regex("\\s+"), " ").trim()
+        if (a.isEmpty()) return outil
+        return "$outil · " + if (a.length > max) a.take(max - 1).trimEnd() + "…" else a
+    }
+
+    /** Pas de ligne récapitulative ajoutée en fin de tour (Hermes ne l'envoie pas sur son API). */
+    @Suppress("UNUSED_PARAMETER")
+    fun resume(reussies: Int, echecs: Int, refusees: Int, sousAgents: Int, dureeMs: Long): String? = null
+}
