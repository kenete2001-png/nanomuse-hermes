+++ b/android/src/android/app/src/test/java/io/github/kenete/nanohermes/hermes/MiseAJourTest.kt
@@ -0,0 +1,153 @@
+package io.github.kenete.nanohermes.hermes
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import java.io.File
+import java.nio.file.Files
+
+class MiseAJourTest {
+    private fun pub(tag: String, corps: String = "", vararg noms: String) = MiseAJour.Publication(tag, tag, corps,
+        noms.map { MiseAJour.Fichier(it, "https://github.com/kenete2001-png/nanomuse-hermes/releases/download/$tag/$it", 10) }, false, false)
+
+    // ---------- versions ----------
+
+    @Test fun `comparer - nombres comme des nombres`() {
+        assertTrue(MiseAJour.comparer("v0.10.0", "v0.9.9") > 0)
+        assertTrue(MiseAJour.comparer("0.23.1", "v0.23.0") > 0)
+        assertEquals(0, MiseAJour.comparer("v0.23", "0.23.0"))
+        assertTrue(MiseAJour.comparer("v1.0.0", "v0.99.99") > 0)
+        assertTrue(MiseAJour.comparer("v0.23.0", "v0.24.0") < 0)
+    }
+
+    @Test fun `comparer - preversion avant, metadonnees apres`() {
+        assertTrue(MiseAJour.comparer("v0.24.0-rc1", "v0.24.0") < 0)
+        assertTrue(MiseAJour.comparer("v0.24.0-rc2", "v0.24.0-rc10") < 0)
+        assertTrue(MiseAJour.comparer("v0.24.0-rc1", "v0.23.9") > 0)
+        assertTrue(MiseAJour.comparer("v0.22.5+canary.20261101T064348Z", "v0.22.5") > 0)
+    }
+
+    @Test fun `Hermes a mettre a jour`() {
+        assertTrue(MiseAJour.hermesAMettreAJour("v0.23.0", "v0.24.0"))
+        assertFalse(MiseAJour.hermesAMettreAJour("v0.23.0", "v0.23.0"))
+        assertFalse("jamais de retour en arrière", MiseAJour.hermesAMettreAJour("v0.24.0", "v0.23.0"))
+        assertTrue(MiseAJour.hermesAMettreAJour(null, "v0.23.0"))
+        assertEquals("v0.23.0", MiseAJour.tagDepuisVersionPack("0.23.0-2bd378e-muse3"))
+        assertNull(MiseAJour.tagDepuisVersionPack("muse"))
+    }
+
+    @Test fun `tag installe - marque puis version du pack`() {
+        val r = Files.createTempDirectory("nh-maj").toFile()
+        try {
+            assertEquals("v0.23.0", MiseAJour.tagHermesInstalle(r, "0.23.0-2bd378e-muse3"))
+            File(r, MiseAJour.MARQUE_TAG).apply { parentFile!!.mkdirs(); writeText("v0.25.1\n") }
+            assertEquals("v0.25.1", MiseAJour.tagHermesInstalle(r, "0.23.0-2bd378e-muse3"))
+            File(r, MiseAJour.MARQUE_TAG).writeText("v1; rm -rf /")
+            assertEquals("marque douteuse ignorée", "v0.23.0", MiseAJour.tagHermesInstalle(r, "0.23.0-2bd378e-muse3"))
+        } finally { r.deleteRecursively() }
+    }
+
+    @Test fun `tags surs seulement dans le script et l'adresse`() {
+        assertTrue(MiseAJour.tagValide("v0.23.0")); assertTrue(MiseAJour.tagValide("v2026.11.1+canary.1"))
+        assertFalse(MiseAJour.tagValide("v1'; rm -rf /")); assertFalse(MiseAJour.tagValide("v1 2")); assertFalse(MiseAJour.tagValide(""))
+        assertFalse(MiseAJour.tagValide("\$(id)")); assertFalse(MiseAJour.tagValide(null))
+        assertEquals("https://codeload.github.com/NousResearch/hermes-agent/tar.gz/refs/tags/v0.24.0", MiseAJour.urlSourcesHermes("v0.24.0"))
+        assertTrue(MiseAJour.urlSourcesHermes("v0.22.5+canary.1").endsWith("v0.22.5%2Bcanary.1"))
+        assertTrue(runCatching { MiseAJour.scriptHermes("v1';x") }.isFailure)
+    }
+
+    @Test fun `script Hermes - retour arriere, jamais root hermes ni apt`() {
+        val s = MiseAJour.scriptHermes("v0.24.0")
+        assertTrue(s.contains("T='v0.24.0'"))
+        assertTrue(s.contains("cp -a venv venv.nh-ancien"))
+        assertTrue(s.contains("pip --python \"\$H/venv/bin/python\" install -e \"\$H/src[acp,mcp,sms]\""))
+        assertTrue(s.contains("mv src.nh-ancien src && mv venv.nh-ancien venv && echo \"NH_RETOUR_OK\""))
+        assertFalse(s.contains(".hermes/")); assertFalse(s.contains("/root/.hermes")); assertFalse(s.contains("apt"))
+        assertFalse(s.contains("dpkg"))
+    }
+
+    @Test fun `sortie du script`() {
+        val ok = MiseAJour.lireSortie("NH_ETAPE extraction\nNH_ETAPE pip\nSuccessfully installed hermes-agent\nNH_ETAPE controle\nNH_OK v0.24.0\n")
+        assertTrue(ok.ok); assertEquals("v0.24.0", ok.tag)
+        val ko = MiseAJour.lireSortie("NH_ETAPE pip\nERROR: x\nNH_ETAPE retour\nNH_RETOUR_OK\nNH_ECHEC pip\n")
+        assertFalse(ko.ok); assertTrue(ko.retourFait); assertEquals("pip", ko.etapeEchec)
+        val coupe = MiseAJour.lireSortie("NH_ETAPE sauvegarde\n")
+        assertFalse(coupe.ok); assertNull(coupe.etapeEchec); assertEquals("sauvegarde", coupe.derniereEtape)
+    }
+
+    // ---------- application ----------
+
+    @Test fun `versionCode - ligne du texte puis tag`() {
+        assertEquals(7, MiseAJour.versionCode(pub("v1.0.0-nh3", "Notes\nversionCode: 7\n")))
+        assertEquals(7, MiseAJour.versionCode(pub("v1.0.0-nh3", "- **versionCode: 7**".replace("**", ""))))
+        assertEquals(12, MiseAJour.versionCode(pub("v1.0.0-nh3", "VersionCode = 12")))
+        assertEquals(3, MiseAJour.versionCode(pub("v1.0.0-nh3", "pas de ligne")))
+        assertNull(MiseAJour.versionCode(pub("v1.0.0", "rien")))
+        assertNull("versionCode au milieu d'une phrase ignoré", MiseAJour.versionCode(pub("v1.0.0", "le versionCode: 9 viendra")))
+    }
+
+    @Test fun `verdict app`() {
+        val apk = "nanoMuse-Hermes-1.0.1.apk"
+        val v = MiseAJour.verdictApp(pub("v1.0.1-nh2", "versionCode: 2", apk, "$apk.sha256"), 1)
+        assertTrue(v is MiseAJour.Verdict.Nouvelle)
+        v as MiseAJour.Verdict.Nouvelle
+        assertEquals(2, v.versionCode); assertEquals(apk, v.apk.nom); assertEquals("$apk.sha256", v.sha256.nom)
+        assertEquals(MiseAJour.Verdict.AJour, MiseAJour.verdictApp(pub("v1.0.0-nh1", "versionCode: 1", apk, "$apk.sha256"), 1))
+        assertEquals("jamais de retour en arrière", MiseAJour.Verdict.AJour, MiseAJour.verdictApp(pub("v1.0.0-nh1", "", apk, "$apk.sha256"), 5))
+        assertEquals(MiseAJour.Verdict.Inutilisable("sha256"), MiseAJour.verdictApp(pub("v1.0.1-nh2", "", apk), 1))
+        assertEquals(MiseAJour.Verdict.Inutilisable("apk"), MiseAJour.verdictApp(pub("v1.0.1-nh2", "", "notes.txt"), 1))
+        assertEquals(MiseAJour.Verdict.Inutilisable("tag"), MiseAJour.verdictApp(pub("v1.0.9", "versionCode: 99", apk, "$apk.sha256"), 1))
+        assertEquals(MiseAJour.Verdict.Inutilisable("brouillon"),
+            MiseAJour.verdictApp(pub("v1.0.1-nh2", "", apk, "$apk.sha256").copy(brouillon = true), 1))
+    }
+
+    @Test fun `lecture d'une publication GitHub`() {
+        val json = """{"tag_name":"v1.0.1-nh2","name":"nanoMuse Hermes 1.0.1","draft":false,"prerelease":false,"body":"Corrections\r\nversionCode: 2\r\n",
+            "assets":[{"name":"nanoMuse-Hermes-1.0.1.apk","size":123,"browser_download_url":"https://github.com/kenete2001-png/nanomuse-hermes/releases/download/v1.0.1-nh2/nanoMuse-Hermes-1.0.1.apk"},
+            {"name":"nanoMuse-Hermes-1.0.1.apk.sha256","size":90,"browser_download_url":"https://github.com/kenete2001-png/nanomuse-hermes/releases/download/v1.0.1-nh2/nanoMuse-Hermes-1.0.1.apk.sha256"},
+            {"name":"pas-https.apk","size":1,"browser_download_url":"http://exemple.org/x.apk"}]}"""
+        val p = MiseAJour.lirePublication(json)
+        assertEquals("v1.0.1-nh2", p.tag); assertEquals(2, p.fichiers.size); assertEquals(2, MiseAJour.versionCode(p))
+        assertTrue(MiseAJour.verdictApp(p, 1) is MiseAJour.Verdict.Nouvelle)
+        assertEquals("", MiseAJour.lirePublication("""{"tag_name":"v1","body":null}""").corps)
+    }
+
+    @Test fun `verification une fois par jour`() {
+        val j = MiseAJour.INTERVALLE_MS
+        assertTrue(MiseAJour.aVerifier(0, 1000))
+        assertFalse(MiseAJour.aVerifier(10_000, 10_000 + j - 1))
+        assertTrue(MiseAJour.aVerifier(10_000, 10_000 + j))
+        assertTrue("horloge revenue en arrière", MiseAJour.aVerifier(10_000, 5_000))
+    }
+
+    // ---------- empreintes ----------
+
+    private val SHA_ABC = "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"
+
+    @Test fun `sha256 connu et verification de fichier`() {
+        val f = File.createTempFile("nhmaj", ".apk")
+        try {
+            f.writeText("abc")
+            assertEquals(SHA_ABC, MiseAJour.sha256(f))
+            assertTrue(MiseAJour.verifier(f, SHA_ABC)); assertTrue(MiseAJour.verifier(f, SHA_ABC.uppercase()))
+            assertFalse(MiseAJour.verifier(f, SHA_ABC.replaceFirst('b', 'c')))
+            assertFalse(MiseAJour.verifier(f, null)); assertFalse(MiseAJour.verifier(f, "abc"))
+            assertFalse(MiseAJour.verifier(File(f.path + ".absent"), SHA_ABC))
+            f.appendText("d")
+            assertFalse("un octet de plus = refus", MiseAJour.verifier(f, SHA_ABC))
+        } finally { f.delete() }
+    }
+
+    @Test fun `lecture du fichier sha256`() {
+        assertEquals(SHA_ABC, MiseAJour.lireSha256("$SHA_ABC  app.apk\n", "app.apk"))
+        assertEquals(SHA_ABC, MiseAJour.lireSha256("$SHA_ABC *app.apk", "app.apk"))
+        assertEquals(SHA_ABC, MiseAJour.lireSha256(SHA_ABC.uppercase() + "\n", "app.apk"))
+        val autre = "0".repeat(64)
+        assertEquals(SHA_ABC, MiseAJour.lireSha256("$autre  autre.apk\n$SHA_ABC  dist/app.apk\n", "app.apk"))
+        assertNull(MiseAJour.lireSha256("$autre  a.apk\n$SHA_ABC  b.apk\n", "c.apk"))
+        assertNull(MiseAJour.lireSha256("pas une empreinte  app.apk", "app.apk"))
+        assertNull(MiseAJour.lireSha256("", "app.apk"))
+    }
+}
