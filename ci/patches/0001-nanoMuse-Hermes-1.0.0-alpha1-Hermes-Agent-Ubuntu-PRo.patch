@@ -0,0 +1,63 @@
+package io.github.kenete.nanohermes.hermes
+
+/** État du téléphone au moment d'une tâche (lu par l'adaptateur Android, faux en test). */
+data class HermesEtatAppareil(
+    val ramDisponibleMo: Long,
+    val memoireBasseSysteme: Boolean,
+    val batteriePct: Int,
+    val enCharge: Boolean,
+    val economieEnergie: Boolean,
+)
+
+/** Quel moteur fait la tâche, et pourquoi (la raison est montrée en une ligne quand c'est le natif). */
+sealed class HermesChoixMoteur {
+    object Hermes : HermesChoixMoteur() { override fun toString() = "Hermes" }
+    data class Natif(val raison: HermesRaisonRepli, val detail: String) : HermesChoixMoteur()
+}
+
+enum class HermesRaisonRepli(val code: String) {
+    REGLAGE("reglage"), PACK_ABSENT("pack_absent"), NON_CONFIGURE("non_configure"), RAM_BASSE("ram_basse"), BATTERIE_BASSE("batterie_basse"),
+    ECONOMIE_ENERGIE("economie_energie"), PAUSE_APRES_ECHEC("pause_apres_echec"), DEMARRAGE_ECHOUE("demarrage_echoue"),
+    INDISPONIBLE("indisponible"), CLE_REFUSEE("cle_refusee"), OCCUPE("occupe"), ERREUR("erreur"),
+}
+
+/**
+ * nanoMuse Hermes : décision Hermes ou moteur nanoMuse (runAgentLoop d'origine), AVANT la tâche.
+ * Seuils : RAM libre < 900 Mo, batterie < 15 % hors charge, mode économie d'énergie.
+ * Hermes au repos ≈ 205 Mo, ≈ 280 Mo après deux tâches (mesuré) : sous 900 Mo libres, Android risque de tuer l'app.
+ */
+object HermesRepli {
+    const val RAM_MIN_MO = 900L
+    const val BATTERIE_MIN_PCT = 15
+
+    fun choisir(
+        hermesActive: Boolean,
+        packPresent: Boolean,
+        /** Fournisseur, modèle et clé API saisis dans l'app (sinon Hermes n'a aucun modèle à appeler). */
+        configure: Boolean,
+        appareil: HermesEtatAppareil?,
+        pauseApresEchec: Boolean,
+    ): HermesChoixMoteur {
+        if (!hermesActive) return HermesChoixMoteur.Natif(HermesRaisonRepli.REGLAGE, "Hermes coupé dans les réglages")
+        if (!packPresent) return HermesChoixMoteur.Natif(HermesRaisonRepli.PACK_ABSENT, "pack Hermes pas installé")
+        if (!configure) return HermesChoixMoteur.Natif(HermesRaisonRepli.NON_CONFIGURE, "fournisseur, modèle ou clé API manquant")
+        if (appareil != null) {
+            if (appareil.memoireBasseSysteme || appareil.ramDisponibleMo < RAM_MIN_MO)
+                return HermesChoixMoteur.Natif(HermesRaisonRepli.RAM_BASSE, "mémoire libre ${appareil.ramDisponibleMo} Mo (< $RAM_MIN_MO)")
+            if (!appareil.enCharge && appareil.batteriePct in 0 until BATTERIE_MIN_PCT)
+                return HermesChoixMoteur.Natif(HermesRaisonRepli.BATTERIE_BASSE, "batterie ${appareil.batteriePct} % (< $BATTERIE_MIN_PCT %)")
+            if (appareil.economieEnergie && !appareil.enCharge)
+                return HermesChoixMoteur.Natif(HermesRaisonRepli.ECONOMIE_ENERGIE, "mode économie d'énergie")
+        }
+        if (pauseApresEchec) return HermesChoixMoteur.Natif(HermesRaisonRepli.PAUSE_APRES_ECHEC, "Hermes n'a pas démarré il y a peu")
+        return HermesChoixMoteur.Hermes
+    }
+
+    /** Raison de repli pour une erreur survenue AVANT que Hermes ait fait quoi que ce soit (sinon : pas de repli). */
+    fun raisonErreur(e: Throwable): HermesRaisonRepli = when (e) {
+        is HermesErreur.Indisponible, is HermesErreur.Delai -> HermesRaisonRepli.INDISPONIBLE
+        is HermesErreur.Cle -> HermesRaisonRepli.CLE_REFUSEE
+        is HermesErreur.Occupe -> HermesRaisonRepli.OCCUPE
+        else -> HermesRaisonRepli.ERREUR
+    }
+}
diff --git a/android/src/android/app/src/main/java/io/github/kenete/nanohermes/hermes/HermesSuperviseur.kt b/android/src/android/app/src/main/java/io/github/kenete/nanohermes/hermes/HermesSuperviseur.kt
