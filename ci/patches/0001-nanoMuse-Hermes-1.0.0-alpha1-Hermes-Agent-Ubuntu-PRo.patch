+/** nanoMuse Hermes : section « Hermes Agent » en tête des réglages (installation du pack, fournisseur, modèle, clé API). */
+@Composable
+fun SectionHermes() {
+    val context = LocalContext.current
+    val scope = rememberCoroutineScope()
+    var rev by remember { mutableIntStateOf(0) }
+    var message by remember { mutableStateOf<String?>(null) }
+    var progres by remember { mutableStateOf<Float?>(null) }
+    val installe = remember(rev) { HermesPackAndroid.versionInstallee(context) ?: if (HermesPack.present(HermesChemins.rootfs(context))) "?" else null }
+    val reglage = remember(rev) { HermesReglages.reglage(context) }
+    var fournisseur by remember(rev) { mutableStateOf(reglage?.fournisseur ?: HermesFournisseur.LISTE.first().id) }
+    var modele by remember(rev) { mutableStateOf(reglage?.modele.orEmpty()) }
+    var baseUrl by remember(rev) { mutableStateOf(reglage?.baseUrl.orEmpty()) }
+    var cle by remember { mutableStateOf("") }
+    var menu by remember { mutableStateOf(false) }
+    // adresse officielle du pack (pack.json) préremplie ; modifiable
+    var url by remember { mutableStateOf(runCatching { HermesPackAndroid.attendu(context).url }.getOrNull().orEmpty()) }
+    val clePresente = remember(rev) { HermesCleApi.presente(context) }
+
+    fun installer(bloc: suspend ((Long, Long) -> Unit) -> String) {
+        progres = 0f; message = null
+        scope.launch {
+            message = runCatching { bloc { n, t -> progres = if (t > 0) n.toFloat() / t else null } }
+                .getOrElse { HermesPackAndroid.phraseRefus(context, it) }
+            progres = null; rev++
+        }
+    }
+    val choisir = rememberLauncherForActivityResult(ActivityResultContracts.OpenDocument()) { uri: Uri? ->
+        if (uri != null) installer { p -> HermesPackAndroid.depuisFichier(context, uri, p) }
+    }
+
+    Column(Modifier.fillMaxWidth().padding(horizontal = 16.dp, vertical = 8.dp), verticalArrangement = Arrangement.spacedBy(6.dp)) {
+        Text(stringResource(R.string.nh_titre), style = MaterialTheme.typography.titleMedium)
+        Text(stringResource(R.string.nh_explication), style = MaterialTheme.typography.bodySmall, color = MaterialTheme.colorScheme.onSurfaceVariant)
+        Row(verticalAlignment = Alignment.CenterVertically) {
+            Text(stringResource(R.string.nh_actif), Modifier.weight(1f))
+            Switch(checked = remember(rev) { HermesReglages.actif(context) }, onCheckedChange = { v ->
+                HermesReglages.setActif(context, v); rev++
+                if (!v) scope.launch { HermesPont.arreter() }
+            })
