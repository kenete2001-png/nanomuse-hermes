+package io.github.kenete.nanohermes.hermes
+
+import android.app.ActivityManager
+import android.content.Context
+import android.content.SharedPreferences
+import android.os.BatteryManager
+import android.os.PowerManager
+import com.openminis.app.R
+import com.openminis.app.data.repository.ChatRepository
+import com.openminis.app.sandbox.PRootKernel
+import com.openminis.app.util.EncryptedPrefsFactory
+import java.io.File
+import java.io.RandomAccessFile
+import java.util.concurrent.TimeUnit
+
+/**
+ * nanoMuse Hermes : adaptateurs Android (le cœur est en Kotlin pur, testé sur la JVM).
+ * - [HermesReglages] : interrupteur « Hermes Agent », fournisseur et modèle (préférences simples, sans secret).
+ * - [HermesCleApi] : la clé API du fournisseur, dans des préférences CHIFFRÉES (EncryptedSharedPreferences, clé maître dans
+ *   l'Android Keystore) ; jamais écrite en clair, jamais journalisée ; elle ne passe à Hermes que par l'environnement.
+ * - [HermesChemins], [HermesAppareil], [HermesLanceurProot], [HermesDepotRoom].
+ */
+object HermesReglages {
+    private const val PREFS = "nanohermes_reglages"
+    private fun p(c: Context) = c.applicationContext.getSharedPreferences(PREFS, Context.MODE_PRIVATE)
+
+    /** Hermes répond quand il est installé et configuré ; coupé = le moteur nanoMuse répond toujours. */
+    fun actif(c: Context): Boolean = p(c).getBoolean("actif", true)
+    fun setActif(c: Context, v: Boolean) = p(c).edit().putBoolean("actif", v).apply()
+
+    fun reglage(c: Context): HermesFournisseur.Reglage? {
+        val f = p(c).getString("fournisseur", null) ?: return null
+        val m = p(c).getString("modele", null) ?: return null
+        return HermesFournisseur.Reglage(f, m, p(c).getString("base_url", null))
+    }
+
+    fun setReglage(c: Context, r: HermesFournisseur.Reglage) =
+        p(c).edit().putString("fournisseur", r.fournisseur).putString("modele", r.modele.trim()).putString("base_url", r.baseUrl?.trim()).apply()
+
+    fun noterRepli(c: Context, raison: String) = p(c).edit().putString("dernier_repli", raison).putLong("dernier_repli_a", System.currentTimeMillis()).apply()
+    fun dernierRepli(c: Context): Pair<String, Long>? = p(c).getString("dernier_repli", null)?.let { it to p(c).getLong("dernier_repli_a", 0) }
+}
+
+object HermesCleApi {
+    private const val FICHIER = "nanohermes_cle"
+    private const val CLE = "cle_fournisseur"
+    @Volatile private var prefs: SharedPreferences? = null
+    private fun p(c: Context): SharedPreferences = prefs ?: synchronized(this) {
+        prefs ?: EncryptedPrefsFactory.safeCreate(c.applicationContext, FICHIER).also { prefs = it }
+    }
+
+    fun lire(c: Context): String? = runCatching { p(c).getString(CLE, null) }.getOrNull()?.takeIf { it.isNotBlank() }
+    fun presente(c: Context): Boolean = lire(c) != null
+    fun enregistrer(c: Context, cle: String) { p(c).edit().putString(CLE, cle.trim()).apply() }
+    fun effacer(c: Context) { runCatching { p(c).edit().remove(CLE).apply() } }
+}
+
+object HermesAppareil {
+    fun etat(c: Context): HermesEtatAppareil {
+        val am = c.getSystemService(Context.ACTIVITY_SERVICE) as? ActivityManager
+        val mi = ActivityManager.MemoryInfo().also { am?.getMemoryInfo(it) }
+        val bm = c.getSystemService(Context.BATTERY_SERVICE) as? BatteryManager
+        val pm = c.getSystemService(Context.POWER_SERVICE) as? PowerManager
+        return HermesEtatAppareil(
+            ramDisponibleMo = if (am == null) Long.MAX_VALUE else mi.availMem / (1024 * 1024),
+            memoireBasseSysteme = am != null && mi.lowMemory,
+            batteriePct = bm?.getIntProperty(BatteryManager.BATTERY_PROPERTY_CAPACITY) ?: -1,
+            enCharge = bm?.isCharging ?: false,
+            economieEnergie = pm?.isPowerSaveMode ?: false,
+        )
+    }
+}
+
+object HermesChemins {
+    /** Linux de Hermes (Ubuntu 24.04, glibc), installé en entier par le pack ; le Linux Alpine de nanoMuse reste celui de ses outils. */
+    const val DOSSIER = "ubuntu-rootfs"
+    fun rootfs(c: Context): File = File(c.applicationContext.filesDir, DOSSIER)
+    fun home(c: Context): File = File(rootfs(c), HermesPack.HERMES_HOME.removePrefix("/"))
+    fun journal(c: Context): File = File(c.cacheDir, "hermes-gateway.log")
+}
+
+/** Textes du moteur pur pris dans strings.xml (langue de l'app). Appelé avant chaque tâche (la langue peut changer). */
+object HermesTextesAndroid {
+    fun charger(c: Context) {
+        HermesTextes.demarrage = c.getString(R.string.nh_demarrage)
+        HermesTextes.outilNonExecute = c.getString(R.string.nh_outil_non_execute)
+        HermesTextes.arrete = c.getString(R.string.nh_arrete)
+        HermesTextes.echec = c.getString(R.string.nh_echec)
+        HermesTextes.fluxCoupe = c.getString(R.string.nh_flux_coupe)
+    }
+}
+
+/** Configuration écrite avant chaque lancement (aucune clé sur disque) et environnement du processus (avec la clé). */
+object HermesPreparation {
+    /** Écrit `.env` de l'API locale (clé locale aléatoire, pas la clé du fournisseur) et la section model de config.yaml. */
+    fun preparer(c: Context): Map<String, String> {
+        val home = HermesChemins.home(c).apply { mkdirs() }
+        HermesPack.cle(home, HermesPack.port(home))
+        val r = HermesReglages.reglage(c)
+        if (r != null && HermesFournisseur.valide(r)) {
+            val f = File(home, "config.yaml")
+            val existant = f.takeIf { it.isFile }?.readText()
+            if (HermesFournisseur.peutEcrireConfig(existant)) {
+                val tmp = File(home, "config.yaml.tmp")
+                tmp.writeText(HermesFournisseur.configYaml(r)); prive(tmp)
+                if (!tmp.renameTo(f)) { f.delete(); tmp.renameTo(f) }
+                prive(f)
+            }
+        }
+        return HermesFournisseur.environnement(r, HermesCleApi.lire(c))
+    }
+
+    private fun prive(f: File) {
+        f.setReadable(false, false); f.setWritable(false, false); f.setExecutable(false, false)
+        f.setReadable(true, true); f.setWritable(true, true)
+    }
+}
+
+class HermesLanceurProot(private val context: Context) : HermesLanceur {
+    override fun lancer(): HermesProcessus {
+        val c = context.applicationContext
+        val rootfs = HermesChemins.rootfs(c)
+        val binaire = HermesPack.lanceur(rootfs) ?: throw HermesPackAbsent("pack Hermes pas installé")
+        check(PRootKernel.isBooted) { "PRoot pas démarré" }
+        val varsFournisseur = HermesPreparation.preparer(c)
+        val port = HermesPack.port(HermesChemins.home(c))
+        val log = HermesChemins.journal(c)
+        if (log.length() > 512 * 1024) log.delete()
+        val pb = ProcessBuilder(PRootKernel.buildProotCommand(HermesPack.commande(binaire, port), rootfs))
+        pb.redirectErrorStream(true)
+        pb.redirectOutput(ProcessBuilder.Redirect.appendTo(log))
+        val env = pb.environment()
+        env["PROOT_TMP_DIR"] = PRootKernel.getProotTmpDir(c).absolutePath
+        if (PRootKernel.nativeLibDir.isNotEmpty()) env["LD_LIBRARY_PATH"] = PRootKernel.nativeLibDir
+        if (PRootKernel.prootLoaderPath.isNotEmpty()) env["PROOT_LOADER"] = PRootKernel.prootLoaderPath
+        if (PRootKernel.prootLoader32Path.isNotEmpty()) env["PROOT_LOADER_32"] = PRootKernel.prootLoader32Path
+        // clé du fournisseur : environnement seulement (jamais sur disque, jamais dans la ligne de commande)
+        env.putAll(varsFournisseur)
+        val p = pb.start()
+        return object : HermesProcessus {
+            override val vivant get() = p.isAlive
+            override fun arreter() {
+                p.destroy()
+                if (!p.waitFor(5, TimeUnit.SECONDS)) p.destroyForcibly()
+            }
+            override fun journal(): String = runCatching {
+                RandomAccessFile(log, "r").use { f ->
+                    val n = minOf(f.length(), 4096L); f.seek(f.length() - n)
+                    ByteArray(n.toInt()).also { f.readFully(it) }.toString(Charsets.UTF_8)
+                }
+            }.getOrDefault("")
+        }
+    }
+}
+
+class HermesDepotRoom(private val repo: ChatRepository, private val sessionId: String) : HermesDepotMessages {
