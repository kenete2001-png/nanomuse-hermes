+package io.github.kenete.nanohermes.hermes
+
+import java.io.ByteArrayOutputStream
+import java.io.File
+import java.io.InputStream
+import java.security.MessageDigest
+import java.util.zip.GZIPOutputStream
+
+/** Outils de test : un tar ustar minimal (dossiers + fichiers), gzip, et son extracteur (même rôle que RootfsManager.extractTar). */
+object TarTest {
+    fun targz(fichiers: Map<String, String>): ByteArray {
+        val tar = ByteArrayOutputStream()
+        fun oct(v: Long, n: Int) = (java.lang.Long.toOctalString(v).padStart(n - 1, '0') + "\u0000").toByteArray()
+        fun entete(nom: String, taille: Long, type: Char): ByteArray {
+            val h = ByteArray(512)
+            fun mettre(o: Int, b: ByteArray) = System.arraycopy(b, 0, h, o, b.size)
+            mettre(0, nom.toByteArray()); mettre(100, oct(493, 8)); mettre(108, oct(0, 8)); mettre(116, oct(0, 8))
+            mettre(124, oct(taille, 12)); mettre(136, oct(1_793_513_103, 12)); h[156] = type.code.toByte()
+            mettre(257, "ustar\u0000".toByteArray()); mettre(263, "00".toByteArray())
+            for (i in 148 until 156) h[i] = ' '.code.toByte()
+            val somme = h.sumOf { it.toInt() and 0xff }
+            mettre(148, (Integer.toOctalString(somme).padStart(6, '0') + "\u0000 ").toByteArray())
+            return h
+        }
+        val dossiers = fichiers.keys.flatMap { f -> f.split('/').dropLast(1).runningReduce { a, b -> "$a/$b" } }.distinct()
+        for (x in dossiers) tar.write(entete("$x/", 0, '5'))
+        for ((nom, txt) in fichiers) {
+            val b = txt.toByteArray(); tar.write(entete(nom, b.size.toLong(), '0')); tar.write(b)
+            if (b.size % 512 != 0) tar.write(ByteArray(512 - b.size % 512))
+        }
+        tar.write(ByteArray(1024))
+        return ByteArrayOutputStream().also { o -> GZIPOutputStream(o).use { it.write(tar.toByteArray()) } }.toByteArray()
+    }
+
+    fun extraire(i: InputStream, cible: File) {
+        val h = ByteArray(512)
+        while (true) {
+            var n = 0
+            while (n < 512) { val r = i.read(h, n, 512 - n); if (r < 0) return; n += r }
+            if (h.all { it.toInt() == 0 }) return
+            val nom = String(h, 0, 100).trimEnd('\u0000')
+            val taille = String(h, 124, 11).trim('\u0000', ' ').toLong(8)
+            val f = File(cible, nom)
+            if (h[156] == '5'.code.toByte()) f.mkdirs() else {
