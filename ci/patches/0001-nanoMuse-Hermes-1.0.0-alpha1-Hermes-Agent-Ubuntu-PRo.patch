+    // nanohermes: the turn by Hermes Agent (io.github.kenete.nanohermes.hermes.HermesPont). False = the nanoMuse engine does
+    // the turn (Hermes off, not installed or configured, low RAM/battery, Hermes down before acting, or image/audio message).
+    private suspend fun nanoHermes(sid: String): Boolean {
+        val dernier = agentHistory.lastOrNull() ?: return false
+        if (dernier.role != LLMMessage.Role.USER || dernier.imageParts.isNotEmpty() || dernier.audioParts.isNotEmpty() ||
+            dernier.contentParts.any { it is AgentContentPart.ToolResult } || dernier.content.isBlank()) return false
+        val issue = io.github.kenete.nanohermes.hermes.HermesPont.tenter(
+            context, chatRepository, sid, dernier.content,
+            historique = {
+                agentHistory.dropLast(1).filter { it.content.isNotBlank() && it.contentParts.none { p -> p is AgentContentPart.ToolResult } }
+                    .takeLast(40).map { (if (it.role == LLMMessage.Role.USER) "user" else "assistant") to it.content.take(8_000) }
+            },
+            afficher = { id, t, blocs, fini ->
+                withContext(Dispatchers.Main) {
+                    if (t == null) {
+                        updateAssistantMessage(id, "", false, emptyList())
+                        _messages.value = _messages.value.filterNot { it.id == id }
+                    } else {
+                        if (_messages.value.none { it.id == id }) _messages.value = _messages.value +
+                            ChatMessage(id = id, role = "assistant", content = "", isStreaming = true, isAwaitingModelResponse = true)
+                        updateAssistantMessage(id, t, !fini, blocs, isAwaitingModelResponse = !fini && t.isEmpty() && blocs.isEmpty())
+                    }
+                }
+            },
+        )
+        if (issue.traite) agentHistory.add(LLMMessage(role = LLMMessage.Role.ASSISTANT, content = issue.texteFinal))
+        return issue.traite
+    }
+
     fun clearError() {
         _error.value = null
     }
