@@ -0,0 +1,184 @@
+package io.github.kenete.nanohermes.hermes
+
+import android.content.Context
+import android.os.Handler
+import android.os.Looper
+import android.widget.Toast
+import com.openminis.app.R
+import com.openminis.app.data.repository.ChatRepository
+import com.openminis.app.sandbox.PRootKernel
+import com.openminis.app.ui.chat.AssistantBlock
+import com.openminis.app.ui.chat.ToolBlockStatus
+import kotlinx.coroutines.CompletableDeferred
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.SupervisorJob
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import java.util.UUID
+
+/**
+ * nanoMuse Hermes : point d'entrée unique appelé par ChatViewModel (crochet `nanohermes:`), à la place de `runAgentLoop`
+ * quand Hermes peut faire la tâche. [Issue.traite] = faux → le moteur nanoMuse d'origine fait le tour (Hermes coupé, pas
+ * installé, pas configuré, RAM/batterie basses, ou Hermes en panne AVANT d'avoir agi).
+ */
+object HermesPont {
+    class Issue(val traite: Boolean, val texteFinal: String = "", val repli: HermesRaisonRepli? = null)
+
+    private val portee = CoroutineScope(SupervisorJob() + Dispatchers.IO)
+    @Volatile private var superviseur: HermesSuperviseur? = null
+    @Volatile private var client: HermesClient? = null
+    private val dernierToast = HashMap<HermesRaisonRepli, Long>()
+
+    private fun init(c: Context): Pair<HermesSuperviseur, HermesClient> = synchronized(this) {
+        val s = superviseur; val cl = client
+        if (s != null && cl != null) return s to cl
+        val app = c.applicationContext
+        val home = HermesChemins.home(app)
+        val nouveauClient = HermesClient(
+            base = "http://127.0.0.1:" + HermesPack.port(home),
+            cle = { HermesPack.cle(HermesChemins.home(app), HermesPack.port(HermesChemins.home(app))) },
+        )
+        val sup = HermesSuperviseur(HermesLanceurProot(app), sonde = { nouveauClient.sante() })
+        sup.demarrerMinuterie(portee)
+        superviseur = sup; client = nouveauClient
+        sup to nouveauClient
+    }
+
+    fun superviseurOuNull(): HermesSuperviseur? = superviseur
+
+    fun configure(c: Context): Boolean {
+        val r = HermesReglages.reglage(c) ?: return false
+        return HermesFournisseur.valide(r) && HermesFournisseur.cleValide(HermesCleApi.lire(c))
+    }
+
+    fun choix(c: Context): HermesChoixMoteur = HermesRepli.choisir(
+        HermesReglages.actif(c), HermesPack.present(HermesChemins.rootfs(c)), configure(c),
+        runCatching { HermesAppareil.etat(c) }.getOrNull(), superviseur?.enPauseApresEchec() == true)
+
+    /**
+     * Fait la tâche avec Hermes si possible. [afficher] met à jour la bulle en cours (id fixe pour le tour) :
+     * `texte == null` = retirer la bulle (repli : le moteur nanoMuse crée la sienne) ; `fini` = fin du streaming.
+     */
+    suspend fun tenter(
+        context: Context,
+        repo: ChatRepository,
+        sessionId: String,
+        texte: String,
+        historique: () -> List<Pair<String, String>>,
+        afficher: suspend (id: String, texte: String?, blocs: List<AssistantBlock>, fini: Boolean) -> Unit,
+    ): Issue {
+        val c = context.applicationContext
+        if (sessionId.isBlank() || texte.isBlank()) return Issue(false)
+        HermesTextesAndroid.charger(c)
+        val ch = choix(c)
+        if (ch is HermesChoixMoteur.Natif) { signalerRepli(c, ch.raison, ch.detail); return Issue(false, repli = ch.raison) }
+        if (!PRootKernel.isBooted) runCatching { PRootKernel.boot(c) }
+        val (sup, cl) = init(c)
+        val (modele, fournisseur) = HermesFournisseur.pourRun(HermesReglages.reglage(c))
+        val moteur = MoteurHermes(sup, cl, HermesAccords)
+        val bulle = "hermes-" + UUID.randomUUID().toString()
+        val vue = HermesVueDirecte()
+        var bulleMontree = false
+        val ecouteur = object : HermesEcouteur {
+            @Volatile var aMontrer = false
+            override fun demarrage() { aMontrer = true }
+            override fun etape(ev: HermesEvenement) { if (vue.appliquer(ev)) aMontrer = true }
+            override suspend fun lignesModifiees() {
+                if (!aMontrer) return
+                aMontrer = false; bulleMontree = true
+                afficher(bulle, vue.texte(), blocs(vue), false)
+            }
+        }
+        val demande = HermesDemande(
+            sessionMuse = sessionId, texte = texte, modele = modele, fournisseur = fournisseur,
+            historique = historique, cleIdempotence = "nanomuse-" + UUID.randomUUID(),
+        )
+        if (sup.etat.value != HermesSuperviseur.Etat.PRET) { vue.demarrage(); bulleMontree = true; afficher(bulle, "", blocs(vue), false) }
+        return when (val r = moteur.executer(demande, HermesDepotRoom(repo, sessionId), ecouteur)) {
+            is HermesResultat.Repli -> {
+                if (bulleMontree) afficher(bulle, null, emptyList(), true)
+                signalerRepli(c, r.raison, r.detail)
+                Issue(false, repli = r.raison)
+            }
+            is HermesResultat.Traite -> {
+                var t = vue.texte()
+                if (r.statut == "failed" && r.erreur != null) t = (if (t.isBlank()) "" else "$t\n\n") + "_Hermes : ${r.erreur}_"
+                afficher(bulle, t, blocs(vue), true)
+                Issue(true, t)
+            }
+        }
+    }
+
+    private fun blocs(v: HermesVueDirecte): List<AssistantBlock> = v.blocs().map { b ->
+        when (b.genre) {
+            HermesVueDirecte.Genre.TEXTE -> AssistantBlock(id = b.id, kind = "text", content = b.contenu)
+            HermesVueDirecte.Genre.REFLEXION -> AssistantBlock(id = b.id, kind = "thinking", content = b.contenu)
+            HermesVueDirecte.Genre.INFO -> AssistantBlock(id = b.id, kind = "info", content = b.contenu)
+            HermesVueDirecte.Genre.OUTIL -> AssistantBlock(
+                id = b.id, kind = "tool_use", content = b.contenu, toolName = b.nomOutil, toolTitle = b.titre,
+                toolStatus = when (b.statut) {
+                    HermesVueDirecte.Statut.OK -> ToolBlockStatus.SUCCESS
+                    HermesVueDirecte.Statut.ECHEC -> ToolBlockStatus.FAILED
+                    HermesVueDirecte.Statut.REFUSE -> ToolBlockStatus.CANCELLED
+                    else -> ToolBlockStatus.RUNNING
+                },
+                durationMs = b.dureeMs, startTimeMs = b.debutMs,
+            )
+        }
+    }
+
+    fun phrase(c: Context, raison: HermesRaisonRepli): String = when (raison) {
+        HermesRaisonRepli.REGLAGE -> ""
+        HermesRaisonRepli.PACK_ABSENT -> c.getString(R.string.nh_repli_pack_absent)
+        HermesRaisonRepli.NON_CONFIGURE -> c.getString(R.string.nh_repli_non_configure)
+        HermesRaisonRepli.RAM_BASSE -> c.getString(R.string.nh_repli_ram)
+        HermesRaisonRepli.BATTERIE_BASSE -> c.getString(R.string.nh_repli_batterie)
+        HermesRaisonRepli.ECONOMIE_ENERGIE -> c.getString(R.string.nh_repli_economie)
+        HermesRaisonRepli.PAUSE_APRES_ECHEC, HermesRaisonRepli.DEMARRAGE_ECHOUE -> c.getString(R.string.nh_repli_demarrage)
+        HermesRaisonRepli.INDISPONIBLE -> c.getString(R.string.nh_repli_indisponible)
+        HermesRaisonRepli.CLE_REFUSEE -> c.getString(R.string.nh_repli_cle_locale)
+        HermesRaisonRepli.OCCUPE -> c.getString(R.string.nh_repli_occupe)
+        HermesRaisonRepli.ERREUR -> c.getString(R.string.nh_repli_erreur)
+    }
+
+    /** Une ligne pour la personne (au plus une fois par raison toutes les 10 min) + réglages. Pack absent : silencieux. */
+    private fun signalerRepli(c: Context, raison: HermesRaisonRepli, detail: String) {
+        if (raison == HermesRaisonRepli.REGLAGE || raison == HermesRaisonRepli.PACK_ABSENT) return
+        val ph = phrase(c, raison)
+        HermesReglages.noterRepli(c, "$ph ($detail)")
+        val maintenant = System.currentTimeMillis()
+        val montrer = synchronized(dernierToast) {
+            val avant = dernierToast[raison] ?: 0L
+            (maintenant - avant > 10 * 60_000).also { if (it) dernierToast[raison] = maintenant }
+        }
+        if (montrer) Handler(Looper.getMainLooper()).post { runCatching { Toast.makeText(c, ph, Toast.LENGTH_SHORT).show() } }
+    }
+
+    /** Arrêt immédiat (réglages, interrupteur coupé, clé changée, réinstallation). */
+    suspend fun arreter() { superviseur?.arreter("arrêt demandé") }
+}
+
+/**
+ * Accords de Hermes : la demande (`approval.request`) est montrée telle quelle avec les choix que Hermes propose ; la réponse
+ * part à Hermes. Fenêtre fermée sans choix = pas de réponse (Hermes applique son délai, puis refuse).
+ */
+object HermesAccords : HermesAccord {
+    class Demande(val commande: String?, val description: String?, val choix: List<String>, internal val reponse: CompletableDeferred<String?>)
+
+    private val _courante = MutableStateFlow<Demande?>(null)
+    val courante: StateFlow<Demande?> = _courante.asStateFlow()
+
+    override suspend fun decider(demande: HermesEvenement.AccordDemande, sessionMuse: String): String? {
+        val choix = demande.choix.filter { it in MoteurHermes.CHOIX_ACCORD }.ifEmpty { listOf("once", "session", "always", "deny") }
+        val d = Demande(demande.commande, demande.description, choix, CompletableDeferred())
+        _courante.value = d
+        return try { d.reponse.await() } finally { if (_courante.value === d) _courante.value = null }
+    }
+
+    fun repondre(d: Demande, choix: String?) {
+        d.reponse.complete(choix)
+        if (_courante.value === d) _courante.value = null
+    }
+}
