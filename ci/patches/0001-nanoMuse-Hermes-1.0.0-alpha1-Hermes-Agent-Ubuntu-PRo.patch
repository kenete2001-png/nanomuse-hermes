+++ b/android/src/android/app/src/test/java/io/github/kenete/nanohermes/hermes/HermesFauxE3.kt
@@ -0,0 +1,97 @@
+package io.github.kenete.nanohermes.hermes
+
+import okhttp3.mockwebserver.Dispatcher
+import okhttp3.mockwebserver.MockResponse
+import okhttp3.mockwebserver.MockWebServer
+import okhttp3.mockwebserver.RecordedRequest
+import org.json.JSONObject
+import java.util.concurrent.CopyOnWriteArrayList
+import java.util.concurrent.TimeUnit
+
+/** Outils communs aux tests E3 : faux serveur Hermes (MockWebServer), faux dépôt Room, fausse horloge, faux processus. */
+object HermesFauxE3 {
+    const val CLE = "cle-de-test-0123456789abcdef0123456789abcdef"
+
+    fun sse(vararg evenements: JSONObject, fermer: Boolean = true, debutSeq: Int = 0): String = buildString {
+        append(": open\n\n")
+        evenements.forEachIndexed { i, e ->
+            val seq = debutSeq + i
+            e.put("seq", seq)
+            append("id: $seq\n")
+            append("data: ").append(e.toString()).append("\n\n")
+            if (i == 0) append(": keepalive\n\n")
+        }
+        if (fermer) append(": stream closed\n\n")
+    }
+
+    fun ev(nom: String, vararg champs: Pair<String, Any?>): JSONObject = JSONObject().apply {
+        put("event", nom); put("run_id", "run_abcdef1234"); put("timestamp", 1.0)
+        champs.forEach { (k, v) -> put(k, v ?: JSONObject.NULL) }
+    }
+
+    fun reponseSse(corps: String) = MockResponse().setResponseCode(200)
+        .setHeader("Content-Type", "text/event-stream").setBody(corps)
+
+    fun json(code: Int, corps: String) = MockResponse().setResponseCode(code).setHeader("Content-Type", "application/json").setBody(corps)
+
+    fun erreur(code: Int, message: String, codeErr: String? = null) =
+        json(code, JSONObject().put("error", JSONObject().put("message", message).put("type", "invalid_request_error").put("param", JSONObject.NULL).put("code", codeErr ?: JSONObject.NULL)).toString())
+
+    fun client(s: MockWebServer, silenceMs: Long = 5_000, reponseMs: Long = 5_000) =
+        HermesClient(s.url("/").toString().trimEnd('/'), { CLE }, delaiConnexionMs = 1_000, delaiReponseMs = reponseMs, silenceFluxMs = silenceMs)
+
+    /** Faux Hermes programmable par route. Les requêtes reçues sont gardées dans [recues]. */
+    class Serveur : Dispatcher() {
+        val recues = CopyOnWriteArrayList<RecordedRequest>()
+        var sante: () -> MockResponse = { json(200, """{"status":"ok","platform":"hermes-agent","version":"0.22.5"}""") }
+        var session: () -> MockResponse = { erreur(404, "Session not found", "session_not_found") }
+        var runs: (RecordedRequest) -> MockResponse = { json(202, """{"run_id":"run_abcdef1234","status":"started","replayed":false}""") }
+        val flux = ArrayDeque<(RecordedRequest) -> MockResponse>()
+        var statut: () -> MockResponse = { json(200, """{"object":"hermes.run","run_id":"run_abcdef1234","status":"running"}""") }
+        var messages: () -> MockResponse = { json(200, """{"object":"list","data":[]}""") }
+        var approval: (RecordedRequest) -> MockResponse = { json(200, """{"object":"hermes.run.approval_response","resolved":1}""") }
+        var stop: () -> MockResponse = { json(200, """{"run_id":"run_abcdef1234","status":"stopping"}""") }
+
+        override fun dispatch(request: RecordedRequest): MockResponse {
+            recues.add(request)
+            val p = request.requestUrl!!.encodedPath
+            if (p != "/health" && request.getHeader("Authorization") != "Bearer $CLE") return erreur(401, "Invalid API key")
+            return when {
+                p == "/health" -> sante()
+                p == "/v1/runs" && request.method == "POST" -> runs(request)
+                p.endsWith("/events") -> (flux.removeFirstOrNull() ?: { reponseSse(": stream closed\n\n") })(request)
+                p.endsWith("/approval") -> approval(request)
+                p.endsWith("/stop") -> stop()
+                p.startsWith("/v1/runs/") -> statut()
+                p.endsWith("/messages") -> messages()
+                p.startsWith("/api/sessions/") -> session()
+                else -> erreur(404, "not found")
+            }
+        }
+
+        fun chemins(): List<String> = recues.map { it.method + " " + it.requestUrl!!.encodedPath }
+        fun corps(chemin: String): JSONObject? = recues.lastOrNull { it.requestUrl!!.encodedPath == chemin }?.let { JSONObject(it.body.clone().readUtf8()) }
+    }
+
+    class Depot : HermesDepotMessages {
+        data class Ligne(val id: String, val role: String, var parts: String, val jetons: String?, var erreur: String? = null)
+        val lignes = mutableListOf<Ligne>()
+        var majs = 0
+        override suspend fun ajouter(role: String, partsJson: String, tokenJson: String?, modele: String?): String {
+            val id = "l${lignes.size + 1}"; lignes.add(Ligne(id, role, partsJson, tokenJson)); return id
+        }
+        override suspend fun majParts(id: String, partsJson: String) { lignes.first { it.id == id }.parts = partsJson; majs++ }
+        override suspend fun marquerErreur(id: String, texte: String) { lignes.first { it.id == id }.erreur = texte }
+    }
+
+    class Horloge(var t: Long = 1_000_000L) : HermesHorloge { override fun ms() = t }
+
+    class Processus(var vie: Boolean = true, val log: String = "") : HermesProcessus {
+        var arrets = 0
+        override val vivant get() = vie
+        override fun arreter() { arrets++; vie = false }
+        override fun journal() = log
+    }
+
+    fun lent(r: MockResponse, ms: Long) = r.setBodyDelay(ms, TimeUnit.MILLISECONDS)
+}
