@@ -0,0 +1,74 @@
+package io.github.kenete.nanohermes.hermes
+
+import java.io.File
+import java.security.SecureRandom
+
+/**
+ * nanoMuse Hermes : où est Hermes Agent dans son Linux (Ubuntu 24.04, `filesDir/ubuntu-rootfs`), comment le lancer, et la clé
+ * locale de son API HTTP.
+ * - Hermes est installé dans `/opt/hermes` par le pack (venv/bin/hermes) ;
+ * - il est lancé DIRECTEMENT (`hermes gateway run`), sans le lanceur `hermes-muse` du pack : pas de greffon muse_gate, pas de
+ *   réglages imposés ; Hermes garde son comportement d'origine (ses accords par défaut, sa configuration) ;
+ * - l'API locale est réglée par `HERMES_HOME/.env` (API_SERVER_ENABLED, HOST=127.0.0.1, PORT, KEY), écrit par l'app avant le
+ *   premier lancement (la clé de l'API locale n'est pas la clé du fournisseur de modèles, qui ne passe que par l'environnement).
+ * Kotlin pur (java.io) : testé sur un faux rootfs.
+ */
+object HermesPack {
+    const val PORT_DEFAUT = 8642
+    const val HERMES_HOME = "/root/.hermes"
+    /** Binaire de Hermes Agent dans le venv du pack (chemin Linux). */
+    const val HERMES = "/opt/hermes/venv/bin/hermes"
+    private const val BINAIRE = "opt/hermes/venv/bin/hermes"
+
+    /** Chemin Linux du binaire Hermes si le pack est installé, sinon null. */
+    fun lanceur(rootfs: File): String? = if (File(rootfs, BINAIRE).exists()) HERMES else null
+
+    fun present(rootfs: File) = lanceur(rootfs) != null
+
+    /**
+     * Commande shell (exécutée par `/bin/sh -c` sous PRoot) : environnement de Hermes dans Ubuntu (les variables de l'hôte
+     * Android, bibliothèques bionic, sont retirées), puis `hermes gateway run`. La clé du fournisseur arrive par
+     * l'environnement du processus, jamais par un fichier.
+     */
+    fun commande(binaire: String = HERMES, port: Int = PORT_DEFAUT): String =
+        "unset LD_LIBRARY_PATH LD_PRELOAD ENV BROWSER; " +
+            "export HERMES_HOME=$HERMES_HOME HOME=/root SHELL=/bin/bash LANG=C.UTF-8 TMPDIR=/tmp " +
+            "PATH=/opt/hermes/bin:/opt/hermes/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin " +
+            "API_SERVER_ENABLED=true API_SERVER_HOST=127.0.0.1 API_SERVER_PORT=$port; " +
+            "umask 077; mkdir -p $HERMES_HOME; cd /root && exec $binaire gateway run"
+
+    /**
+     * Clé de l'API locale : lit `nanohermes_api_key`, sinon `API_SERVER_KEY` de `.env`, sinon en crée une (48 hex,
+     * SecureRandom) et écrit `.env` + `nanohermes_api_key`. Renvoie la clé (≥ 16 caractères garanti).
+     */
+    fun cle(home: File, port: Int = PORT_DEFAUT, aleatoire: SecureRandom = SecureRandom()): String {
+        val fichierCle = File(home, "nanohermes_api_key")
+        val env = File(home, ".env")
+        fichierCle.takeIf { it.isFile }?.readText()?.trim()?.takeIf { it.length >= 16 }?.let { return it }
+        if (env.isFile) {
+            env.readLines().firstOrNull { it.startsWith("API_SERVER_KEY=") }?.substringAfter('=')?.trim()?.trim('"', '\'')
+                ?.takeIf { it.length >= 16 }?.let { k -> ecrirePrive(fichierCle, k); return k }
+        }
+        val octets = ByteArray(24).also { aleatoire.nextBytes(it) }
+        val k = octets.joinToString("") { "%02x".format(it) }
+        home.mkdirs()
+        val lignes = if (env.isFile) env.readLines().filterNot { it.startsWith("API_SERVER_KEY=") } else listOf(
+            "API_SERVER_ENABLED=true", "API_SERVER_HOST=127.0.0.1", "API_SERVER_PORT=$port")
+        ecrirePrive(env, (lignes + "API_SERVER_KEY=$k").joinToString("\n") + "\n")
+        ecrirePrive(fichierCle, k)
+        return k
+    }
+
+    /** Port lu dans `.env` (API_SERVER_PORT), sinon [PORT_DEFAUT]. */
+    fun port(home: File): Int = File(home, ".env").takeIf { it.isFile }?.readLines()
+        ?.firstOrNull { it.startsWith("API_SERVER_PORT=") }?.substringAfter('=')?.trim()?.toIntOrNull()
+        ?.takeIf { it in 1024..65535 } ?: PORT_DEFAUT
+
+    private fun ecrirePrive(f: File, texte: String) {
+        f.parentFile?.mkdirs()
+        f.writeText(texte)
+        f.setReadable(false, false); f.setReadable(true, true)
+        f.setWritable(false, false); f.setWritable(true, true)
+        f.setExecutable(false, false)
+    }
+}
